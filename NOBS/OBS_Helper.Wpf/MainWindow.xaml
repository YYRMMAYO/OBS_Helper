<Window x:Class="OBS_Helper.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls"
        Title="OBS 排障助手"
        Height="780" Width="1160"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface2Brush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    <KeyBinding Key="BrowserBack" Command="NavigationCommands.BrowseBack" />
    <KeyBinding Key="Left" Modifiers="Alt" Command="NavigationCommands.BrowseBack" />
  </Window.InputBindings>

  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    <CommandBinding Command="NavigationCommands.BrowseBack" Executed="OnBrowseBackExecuted" />
  </Window.CommandBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================================ 左侧导航 -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>

        <!-- 品牌区 -->
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14">
          <StackPanel Orientation="Horizontal">
            <!-- 左上角品牌图标：与应用 / 任务栏 / 托盘同一枚 appicon.ico（含圆角与徽章） -->
            <Image Width="30" Height="30" Stretch="Uniform"
                   Source="pack://application:,,,/Assets/appicon.ico"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="OBS 排障助手" FontWeight="Bold"
                         FontSize="{DynamicResource FontSizeMd}"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock x:Name="VersionText" Text="v1.0.0"
                         FontSize="{DynamicResource FontSizeXs}"
                         Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- 底部：连接状态 -->
        <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="10,9"
                Background="{DynamicResource Surface2Brush}"
                CornerRadius="{DynamicResource CornerRadiusMd}">
          <StackPanel>
            <ctl:ConnectionBadge x:Name="SideBadge" />
            <TextBlock Text="离线可用 · 数据仅存本机"
                       Margin="0,7,0,0"
                       FontSize="{DynamicResource FontSizeXs}"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 导航项 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource PageScroll}">
          <StackPanel x:Name="NavPanel" Margin="0,2,0,8">
            <RadioButton x:Name="NavHome"       Style="{StaticResource NavTabButton}" Content="首页"   Tag="{StaticResource IconGeomHome}"       Checked="OnNavChecked" />
            <RadioButton x:Name="NavSearch"     Style="{StaticResource NavTabButton}" Content="搜索"   Tag="{StaticResource IconGeomSearch}"     Checked="OnNavChecked" />
            <RadioButton x:Name="NavAssistant"  Style="{StaticResource NavTabButton}" Content="助手"   Tag="{StaticResource IconGeomAssistant}"  Checked="OnNavChecked" />
            <RadioButton x:Name="NavDiagnostic" Style="{StaticResource NavTabButton}" Content="诊断"   Tag="{StaticResource IconGeomDiagnostic}" Checked="OnNavChecked" />
            <RadioButton x:Name="NavSetup"      Style="{StaticResource NavTabButton}" Content="搭建"   Tag="{StaticResource IconGeomSetup}"      Checked="OnNavChecked" />
            <RadioButton x:Name="NavTemplates" Style="{StaticResource NavTabButton}" Content="模板"   Tag="{StaticResource IconGeomTemplates}" Checked="OnNavChecked" />
            <RadioButton x:Name="NavPlugins"   Style="{StaticResource NavTabButton}" Content="插件"   Tag="{StaticResource IconGeomPlugins}"   Checked="OnNavChecked" />
            <RadioButton x:Name="NavConsole"    Style="{StaticResource NavTabButton}" Content="控制台" Tag="{StaticResource IconGeomConsole}"    Checked="OnNavChecked" />
            <RadioButton x:Name="NavPerformance" Style="{StaticResource NavTabButton}" Content="监控"   Tag="{StaticResource IconGeomPerformance}" Checked="OnNavChecked" />
            <RadioButton x:Name="NavGuide"      Style="{StaticResource NavTabButton}" Content="指引"   Tag="{StaticResource IconGeomGuide}"      Checked="OnNavChecked" />
            <RadioButton x:Name="NavSettings"   Style="{StaticResource NavTabButton}" Content="设置"   Tag="{StaticResource IconGeomSettings}"   Checked="OnNavChecked" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ============================================ 内容区 -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--
        自定义背景层（v1.10）：位于顶栏与页面之下。
        ContentBackgroundBrush / ContentBackgroundImage / ContentBackgroundDim
        由 AppearanceService.Apply() 写入；默认即 Surface2，视觉与改版前一致。
      -->
      <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
        <Border Background="{DynamicResource ContentBackgroundBrush}" />
        <Image Source="{DynamicResource ContentBackgroundImage}"
               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        <Border Background="{DynamicResource ContentBackgroundDim}" />
      </Grid>

      <!-- 顶栏 -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
              Padding="16,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource IconButton}"
                  ToolTip="返回（Alt + ←）" Click="OnBackClick"
                  Visibility="Collapsed" Margin="0,0,10,0">
            <!-- 矢量返回箭头：替代 unicode ←，避免字体渲染差异 -->
            <Path Data="M 15,5 L 8,12 L 15,19"
                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="16" Height="16" Stretch="Uniform" />
          </Button>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="首页"
                       FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="PageSubtitle" Text="按分类查问题，或直接问助手"
                       FontSize="{DynamicResource FontSizeXs}"
                       Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <ctl:ConnectionBadge x:Name="TopBadge" Margin="0,0,10,0" />
            <Button Style="{StaticResource SecondaryButton}" Content="设置"
                    Padding="10,6" Click="OnSettingsClick" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 页面容器 -->
      <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />

      <!-- 全局加载态遮罩（覆盖顶栏 + 页面；P0，由 BusyService 控制显隐与文案） -->
      <ContentControl x:Name="BusyOverlayHost" Grid.Row="0" Grid.RowSpan="2"
                      Style="{StaticResource BusyOverlay}" Visibility="Collapsed" Tag="处理中…" />

      <!-- 全局 Toast 容器（贴底居中；P0，由 ToastService 增删卡片） -->
      <StackPanel x:Name="ToastHost" Grid.Row="1" Style="{StaticResource ToastHost}" />
    </Grid>
  </Grid>
</Window>
