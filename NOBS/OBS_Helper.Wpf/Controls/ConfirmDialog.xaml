<Window x:Class="OBS_Helper.Wpf.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusLg}"
          Padding="22,20"
          Margin="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#000000" />
    </Border.Effect>

    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock x:Name="IconText" Text="⚠️" FontSize="18" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock x:Name="TitleText" Text="确认操作"
                   FontSize="{DynamicResource FontSizeMd}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                 FontSize="{DynamicResource FontSizeBase}"
                 Foreground="{DynamicResource MutedBrush}"
                 LineHeight="21" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                Content="取消" MinWidth="82" Margin="0,0,10,0"
                IsCancel="True" Click="OnCancel" />
        <Button x:Name="OkButton" Style="{StaticResource DangerButton}"
                Content="确认" MinWidth="82"
                IsDefault="True" Click="OnOk" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
