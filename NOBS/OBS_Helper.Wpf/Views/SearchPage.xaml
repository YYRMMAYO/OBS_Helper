<UserControl x:Class="OBS_Helper.Wpf.Views.SearchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    搜索页 = 即时搜索框 + 分类筛选药丸 + 结果列表。
    这里没有沿用「整页一个 ScrollViewer」的写法：搜索框和分类筛选需要常驻在顶部，
    否则往下翻结果时改不了关键词，所以只让结果区滚动。
  -->
  <Grid Margin="22,18,22,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">

      <TextBox x:Name="QueryBox" Style="{StaticResource AppTextBox}"
               Tag="{DynamicResource Loc.search.placeholder}"
               FontSize="{DynamicResource FontSizeMd}"
               MinHeight="42" />

      <!-- 分类药丸：第一项是「全部」，其余由 problems.json 的分类生成 -->
      <ItemsControl x:Name="ChipList" Margin="0,12,0,0">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <RadioButton Style="{StaticResource SegmentButton}"
                         GroupName="SearchCategory"
                         Content="{Binding Label}"
                         Tag="{Binding Id}"
                         IsChecked="{Binding IsAll, Mode=OneTime}"
                         Checked="OnChipChecked" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock x:Name="CountText" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
      <StackPanel Margin="0,0,0,26">
        <StackPanel x:Name="ResultList" />

        <!-- 空状态：与原版文案保持一致 -->
        <TextBlock x:Name="EmptyText" Text="{DynamicResource Loc.search.empty}"
                   Style="{StaticResource MutedText}"
                   HorizontalAlignment="Center" Margin="0,40,0,0"
                   Visibility="Collapsed" />

        <!--
          无结果时的建议（V3.0 / C4）：一片空白等于把用户丢回原点，给几条最接近的条目至少能继续点。
        -->
        <TextBlock x:Name="SuggestionHeading" Text="{DynamicResource Loc.search.suggestionsHeading}"
                   Style="{StaticResource MutedText}" Margin="2,24,0,8" TextWrapping="Wrap"
                   Visibility="Collapsed" />
        <StackPanel x:Name="SuggestionPanel" Visibility="Collapsed" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
