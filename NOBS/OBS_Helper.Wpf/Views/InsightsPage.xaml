<UserControl x:Class="OBS_Helper.Wpf.Views.InsightsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8" Text="{DynamicResource Loc.insights.metrics}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="Peak" /><TextBox x:Name="PeakBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="Chat" /><TextBox x:Name="ChatBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="Follows" /><TextBox x:Name="FollowBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="Gifts" /><TextBox x:Name="GiftBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="Bitrate" /><TextBox x:Name="BitrateBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="Dropped %" /><TextBox x:Name="DropBox" Width="90" Text="0" /></StackPanel>
          </WrapPanel>
          <WrapPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc.insights.generate}" Click="OnGenerateReport" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.insights.retention}" Click="OnRetention" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.insights.export}" Click="OnExportStats" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.insights.clear}" Click="OnClearStats" />
          </WrapPanel>
          <TextBlock x:Name="ReportText" Style="{StaticResource MonoText}" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.insights.cover}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <TextBox x:Name="GameBox" Width="160" />
            <TextBox x:Name="KeywordBox" Width="200" Margin="8,0,0,0" />
            <TextBox x:Name="MoodBox" Width="120" Margin="8,0,0,0" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.insights.suggest}" Click="OnSuggest" />
          </WrapPanel>
          <ListBox x:Name="CoverList" Height="120" Margin="0,10,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
