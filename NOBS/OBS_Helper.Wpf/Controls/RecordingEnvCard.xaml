<UserControl x:Class="OBS_Helper.Wpf.Controls.RecordingEnvCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    一键部署录制环境（V2.9.3）。
    这里只做「列出推荐值 + 让用户勾选 + 备份后落地 + 可回滚」，不做无人值守的全自动改写：
    写的是用户自己的 OBS 配置，任何一项都可能影响他正在用的工作流。
  -->
  <Border Style="{StaticResource Card}" Padding="14">
    <StackPanel>
      <TextBlock Text="{DynamicResource Loc.env.title}" FontWeight="SemiBold"
                 FontSize="{DynamicResource FontSizeMd}"
                 Foreground="{DynamicResource TextBrush}" />

      <TextBlock Text="{DynamicResource Loc.env.desc}" Style="{StaticResource MutedText}"
                 Margin="0,6,0,0" TextWrapping="Wrap" />

      <TextBlock x:Name="ChannelText" Style="{StaticResource CaptionText}"
                 Margin="0,8,0,0" TextWrapping="Wrap" />

      <StackPanel x:Name="ItemsPanel" Margin="0,10,0,0" />

      <WrapPanel Margin="0,6,0,0">
        <Button x:Name="ApplyButton" Content="{DynamicResource Loc.env.apply}"
                Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="OnApply" />
        <Button Content="{DynamicResource Loc.env.rescan}" Style="{StaticResource GhostButton}"
                Margin="0,0,8,8" Click="OnRescan" />
        <Button x:Name="RollbackButton" Content="{DynamicResource Loc.env.rollback}"
                Style="{StaticResource GhostButton}" Margin="0,0,8,8"
                Visibility="Collapsed" Click="OnRollback" />
      </WrapPanel>

      <TextBlock x:Name="ProgressText" Style="{StaticResource CaptionText}"
                 TextWrapping="Wrap" Visibility="Collapsed" />

      <StackPanel x:Name="ResultPanel" Margin="0,8,0,0" />
    </StackPanel>
  </Border>
</UserControl>
