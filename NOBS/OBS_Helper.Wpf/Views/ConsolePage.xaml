<UserControl x:Class="OBS_Helper.Wpf.Views.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <!-- 页面大标题由 MainWindow 顶栏承担，这里只留说明文案与状态药丸 -->
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource MutedText}"
                   Text="{DynamicResource Loc.console.intro}" />
        <ctl:ConnectionBadge Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0" />
      </Grid>

      <!-- ================================================== 未连接：连接表单 -->
      <Border x:Name="ConnectPanel" Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource H3Text}" Text="{DynamicResource Loc.console.connect.title}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,14"
                     Text="{DynamicResource Loc.console.connect.desc}" />

          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Loc.console.host}" FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSizeSm}"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="HostInput" Style="{StaticResource AppTextBox}"
                     Tag="127.0.0.1" MaxLength="120" />
          </StackPanel>

          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Loc.console.port}" FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSizeSm}"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="PortInput" Style="{StaticResource AppTextBox}"
                     Tag="4455" MaxLength="5" Width="140" HorizontalAlignment="Left"
                     PreviewTextInput="OnPortPreviewTextInput" />
          </StackPanel>

          <StackPanel Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Loc.console.password}" FontWeight="SemiBold"
                       FontSize="{DynamicResource FontSizeSm}"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,4" />
            <PasswordBox x:Name="PasswordInput" Style="{StaticResource AppPasswordBox}" />
            <TextBlock x:Name="PasswordHintText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                       Text="{DynamicResource Loc.console.passwordPlaceholder}" />
          </StackPanel>

          <CheckBox x:Name="RememberCheck" Style="{StaticResource AppCheckBox}" Margin="0,6,0,0"
                    Content="{DynamicResource Loc.console.rememberPassword}" />
          <CheckBox x:Name="AutoConnectCheck" Style="{StaticResource AppCheckBox}" Margin="0,10,0,0"
                    Content="{DynamicResource Loc.console.autoConnect}" />
          <CheckBox x:Name="AutoReconnectCheck" Style="{StaticResource AppCheckBox}" Margin="0,10,0,0"
                    Content="{DynamicResource Loc.console.autoReconnect}" />

          <Button x:Name="ConnectButton" Style="{StaticResource PrimaryButton}"
                  Content="{DynamicResource Loc.console.connect}" HorizontalAlignment="Left" Margin="0,16,0,0"
                  Click="OnConnectClick" />

          <TextBlock x:Name="ConnectErrorText" Margin="0,12,0,0"
                     FontSize="{DynamicResource FontSizeSm}"
                     Foreground="{DynamicResource DangerBrush}"
                     TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- ================================================== 已连接：控制面板 -->
      <StackPanel x:Name="ConnectedPanel" Visibility="Collapsed">

        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
          <Button x:Name="RefreshButton" Style="{StaticResource GhostButton}"
                  Content="{DynamicResource Loc.console.refresh}" Click="OnRefreshClick" />
          <Button x:Name="DisconnectButton" Style="{StaticResource GhostButton}"
                  Content="{DynamicResource Loc.console.disconnect}" Margin="6,0,0,0" Click="OnDisconnectClick" />
        </StackPanel>

        <!-- 请求失败提示：OBS 拒绝执行时必须让用户看见原因，不能静默 -->
        <Border x:Name="OpErrorPanel" Margin="0,10,0,0" Visibility="Collapsed"
                Background="{DynamicResource DangerSoftBrush}"
                CornerRadius="{DynamicResource CornerRadiusMd}" Padding="12,9">
          <TextBlock x:Name="OpErrorText" TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSizeSm}"
                     Foreground="{DynamicResource DangerBrush}" />
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.console.perf}" Margin="0,18,0,10" />
        <UniformGrid Columns="3">
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSm}"
                  Padding="12" Margin="0,0,10,10">
            <StackPanel>
              <TextBlock x:Name="CpuText" Text="0.0%" HorizontalAlignment="Center"
                         FontSize="{DynamicResource FontSizeLg}" FontWeight="Bold"
                         Foreground="{DynamicResource BrandBrush}" />
              <TextBlock Text="CPU" Style="{StaticResource CaptionText}"
                         HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSm}"
                  Padding="12" Margin="0,0,10,10">
            <StackPanel>
              <TextBlock x:Name="FpsText" Text="0.0" HorizontalAlignment="Center"
                         FontSize="{DynamicResource FontSizeLg}" FontWeight="Bold"
                         Foreground="{DynamicResource BrandBrush}" />
              <TextBlock Text="FPS" Style="{StaticResource CaptionText}"
                         HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSm}"
                  Padding="12" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock x:Name="RenderSkipText" Text="0%" HorizontalAlignment="Center"
                         FontSize="{DynamicResource FontSizeLg}" FontWeight="Bold"
                         Foreground="{DynamicResource BrandBrush}" />
              <TextBlock Text="{DynamicResource Loc.metric.renderSkip}" Style="{StaticResource CaptionText}"
                         HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSm}"
                  Padding="12" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock x:Name="OutputSkipText" Text="0%" HorizontalAlignment="Center"
                         FontSize="{DynamicResource FontSizeLg}" FontWeight="Bold"
                         Foreground="{DynamicResource BrandBrush}" />
              <TextBlock Text="{DynamicResource Loc.metric.encodeSkip}" Style="{StaticResource CaptionText}"
                         HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource LineBrush}"
                  BorderThickness="1" CornerRadius="{DynamicResource CornerRadiusSm}"
                  Padding="12" Margin="0,0,10,0">
            <StackPanel>
              <TextBlock x:Name="DiskText" Text="0.0G" HorizontalAlignment="Center"
                         FontSize="{DynamicResource FontSizeLg}" FontWeight="Bold"
                         Foreground="{DynamicResource BrandBrush}" />
              <TextBlock Text="{DynamicResource Loc.console.diskFree}" Style="{StaticResource CaptionText}"
                         HorizontalAlignment="Center" Margin="0,2,0,0" />
            </StackPanel>
          </Border>
        </UniformGrid>

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.console.scenes}" Margin="0,18,0,10" />
        <StackPanel x:Name="ScenesPanel" />
        <TextBlock x:Name="ScenesEmptyText" Style="{StaticResource MutedText}"
                   Text="{DynamicResource Loc.console.scenesEmpty}" Visibility="Collapsed" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.console.sceneItems}" Margin="0,18,0,10" />
        <StackPanel x:Name="SceneItemsPanel" />
        <TextBlock x:Name="SceneItemsEmptyText" Style="{StaticResource MutedText}"
                   Text="{DynamicResource Loc.console.sceneItemsEmpty}" Visibility="Collapsed" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.console.audio}" Margin="0,18,0,10" />
        <StackPanel x:Name="AudioPanel" />
        <TextBlock x:Name="AudioEmptyText" Style="{StaticResource MutedText}"
                   Text="{DynamicResource Loc.console.audioEmpty}" Visibility="Collapsed" />

        <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.console.output}" Margin="0,18,0,10" />
        <Button x:Name="RecordButton" Style="{StaticResource SecondaryButton}"
                HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="OnRecordClick">
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Source="{StaticResource IconRecord}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="RecordButtonText" Text="{DynamicResource Loc.console.record.idle}" VerticalAlignment="Center" />
            <ContentControl x:Name="RecordStatusPill" Style="{StaticResource StatusPill}" Tag="info"
                            Content="{DynamicResource Loc.console.state.idle}" Margin="10,0,0,0" />
          </StackPanel>
        </Button>
        <Button x:Name="StreamButton" Style="{StaticResource SecondaryButton}"
                HorizontalContentAlignment="Left" Margin="0,0,0,8" Click="OnStreamClick">
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Source="{StaticResource IconStream}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="StreamButtonText" Text="{DynamicResource Loc.console.stream.idle}" VerticalAlignment="Center" />
            <ContentControl x:Name="StreamStatusPill" Style="{StaticResource StatusPill}" Tag="info"
                            Content="{DynamicResource Loc.console.state.idle}" Margin="10,0,0,0" />
          </StackPanel>
        </Button>
        <Button x:Name="VirtualCamButton" Style="{StaticResource SecondaryButton}"
                HorizontalContentAlignment="Left" Click="OnVirtualCamClick">
          <StackPanel Orientation="Horizontal">
            <Image Width="16" Height="16" Source="{StaticResource IconConnect}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBlock x:Name="VirtualCamButtonText" Text="{DynamicResource Loc.console.vcam.idle}" VerticalAlignment="Center" />
            <ContentControl x:Name="VirtualCamStatusPill" Style="{StaticResource StatusPill}" Tag="info"
                            Content="{DynamicResource Loc.console.vcam.off}" Margin="10,0,0,0" />
          </StackPanel>
        </Button>

        <Border Style="{StaticResource HLine}" Margin="0,16,0,12" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
          <TextBlock Text="{DynamicResource Loc.console.timer}" FontWeight="SemiBold" VerticalAlignment="Center"
                     FontSize="{DynamicResource FontSizeSm}"
                     Foreground="{DynamicResource TextBrush}" Margin="0,0,10,0" />
          <ComboBox x:Name="TimerTargetBox" Style="{StaticResource AppComboBox}" Width="90"
                    VerticalAlignment="Center">
            <ComboBoxItem Content="{DynamicResource Loc.console.timer.record}" />
            <ComboBoxItem Content="{DynamicResource Loc.console.timer.stream}" />
          </ComboBox>
          <ComboBox x:Name="TimerDurationBox" Style="{StaticResource AppComboBox}" Width="110"
                    Margin="8,0,0,0" VerticalAlignment="Center">
            <ComboBoxItem Content="{DynamicResource Loc.console.timer.min15}" Tag="900" />
            <ComboBoxItem Content="{DynamicResource Loc.console.timer.min30}" Tag="1800" />
            <ComboBoxItem Content="{DynamicResource Loc.console.timer.min45}" Tag="2700" />
            <ComboBoxItem Content="{DynamicResource Loc.console.timer.min60}" Tag="3600" />
            <ComboBoxItem Content="{DynamicResource Loc.console.timer.min90}" Tag="5400" />
          </ComboBox>
          <Button x:Name="TimerStartButton" Content="{DynamicResource Loc.console.timer.start}" Style="{StaticResource SecondaryButton}"
                  Margin="8,0,0,0" VerticalAlignment="Center" Click="OnTimerStartClick" />
          <Button x:Name="TimerCancelButton" Content="{DynamicResource Loc.common.cancel}" Style="{StaticResource GhostButton}"
                  Margin="8,0,0,0" VerticalAlignment="Center" Click="OnTimerCancelClick" />
          <TextBlock x:Name="TimerCountdownText" VerticalAlignment="Center" Margin="12,0,0,0"
                     FontSize="{DynamicResource FontSizeSm}"
                     Foreground="{DynamicResource BrandBrush}" FontWeight="Bold" />
        </StackPanel>
        <TextBlock Style="{StaticResource CaptionText}" Margin="2,0,0,0"
                   Text="{DynamicResource Loc.console.timer.hint}" />

        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button x:Name="MiniWindowButton" Content="{DynamicResource Loc.console.miniWindow}"
                  Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                  ToolTip="{DynamicResource Loc.console.miniWindowTip}"
                  Click="OnMiniWindowClick" />
          <Button x:Name="OpenRecordDirButton" Content="{DynamicResource Loc.console.openRecordDir}" Style="{StaticResource GhostButton}"
                  HorizontalAlignment="Left" Margin="10,0,0,0" Click="OnOpenRecordDirClick" />
        </StackPanel>
        <TextBlock x:Name="RecordDirHintText" Style="{StaticResource CaptionText}" Margin="2,6,0,0"
                   Visibility="Collapsed" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
