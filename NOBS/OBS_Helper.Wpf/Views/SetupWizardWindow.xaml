<Window x:Class="OBS_Helper.Wpf.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.wizard.title}"
        Width="600" Height="640"
        MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface2Brush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- 头部：图标 + 标题 + 简介 -->
    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="TitleText" Text="" FontWeight="Bold"
                     FontSize="{DynamicResource FontSizeLg}" VerticalAlignment="Center"
                     Foreground="{DynamicResource TextBrush}" />
        </StackPanel>
        <TextBlock x:Name="IntroText" Text="" TextWrapping="Wrap" Margin="0,8,0,0"
                   Style="{StaticResource MutedText}" />
      </StackPanel>
    </Border>

    <!-- 步骤列表（代码构建） -->
    <ScrollViewer Grid.Row="1" Style="{StaticResource PageScroll}">
      <StackPanel x:Name="StepHost" Margin="20,16,20,8" />
    </ScrollViewer>

    <!-- 底部 -->
    <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                   Text="{DynamicResource Loc.wizard.footer}" />
        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc.wizard.gotIt}"
                Padding="18,7" Click="OnCloseClick" />
      </Grid>
    </Border>
  </Grid>
</Window>
