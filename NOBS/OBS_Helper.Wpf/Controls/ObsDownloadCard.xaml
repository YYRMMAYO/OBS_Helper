<UserControl x:Class="OBS_Helper.Wpf.Controls.ObsDownloadCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    获取官方 OBS Studio 的统一下载入口（V2.9.1）。
    只放三个官方入口：官网下载页 / GitHub 发布页 / 当前稳定版 Windows 安装包直链。
    直链不是写死的版本号：由 ObsReleaseInfoService 从 GitHub releases/latest 里解析，
    解析不到就退化成打开官方发布页（按钮文案与结果说明在 code-behind 里给出）。
  -->
  <Border Style="{StaticResource Card}" Padding="14">
    <StackPanel>
      <TextBlock Text="{DynamicResource Loc.obs.card.title}" FontWeight="SemiBold"
                 FontSize="{DynamicResource FontSizeMd}"
                 Foreground="{DynamicResource TextBrush}" />

      <TextBlock x:Name="SafetyText" Style="{StaticResource MutedText}"
                 Margin="0,6,0,0" TextWrapping="Wrap" />

      <WrapPanel Margin="0,10,0,0">
        <Button Content="{DynamicResource Loc.obs.officialPage}" Style="{StaticResource PrimaryButton}"
                Margin="0,0,8,8" Click="OnOpenOfficialDownload" />
        <Button Content="{DynamicResource Loc.obs.githubPage}" Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,8" Click="OnOpenGitHubReleases" />
        <Button x:Name="DirectButton" Content="{DynamicResource Loc.obs.directInstaller}"
                Style="{StaticResource SecondaryButton}"
                Margin="0,0,8,8" Click="OnDownloadLatestInstaller" />
      </WrapPanel>

      <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" Margin="0,2,0,0"
                 TextWrapping="Wrap" Visibility="Collapsed" />
    </StackPanel>
  </Border>
</UserControl>
