<UserControl x:Class="OBS_Helper.Wpf.Views.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <TextBlock Style="{StaticResource MutedText}"
                 Text="{DynamicResource Loc.logs.intro}" />

      <!-- 没有宿主能力时（例如未来的非桌面壳）只能手动选文件，保留这条降级提示 -->
      <Border x:Name="NoHostPanel" Style="{StaticResource Card}" Margin="0,14,0,0"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.logs.noHost}" />
          <TextBlock Style="{StaticResource MutedText}"
                     Text="{DynamicResource Loc.logs.noHostDesc}" />
        </StackPanel>
      </Border>

      <!-- ============================================ 选择日志来源 -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.logs.source}" />

          <TextBlock x:Name="LogDirText" Style="{StaticResource CaptionText}"
                     Margin="0,0,0,10" />

          <WrapPanel>
            <Button x:Name="RefreshButton" Content="{DynamicResource Loc.logs.refresh}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="OnRefreshList" />
            <Button x:Name="PickButton" Content="{DynamicResource Loc.logs.pick}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="OnPickFile" />
            <Button x:Name="OpenDirButton" Content="{DynamicResource Loc.logs.openDir}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="OnOpenDir" />
          </WrapPanel>

          <StackPanel x:Name="FileList" Margin="0,4,0,0" />

          <TextBlock x:Name="ListHintText" Style="{StaticResource MutedText}"
                     Margin="0,6,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- ============================================ 分析结果 -->
      <Border x:Name="ReportPanel" Style="{StaticResource Card}" Margin="0,14,0,0"
              Visibility="Collapsed">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="ReportTitleText" Grid.Column="0"
                       Style="{StaticResource SectionTitle}" Margin="0,4,10,10" />

            <Border x:Name="CountPill" Grid.Column="1" Style="{StaticResource Pill}"
                    Margin="0,0,0,6">
              <TextBlock x:Name="CountText" FontSize="{DynamicResource FontSizeXs}" />
            </Border>
          </Grid>

          <TextBlock x:Name="ReportMetaText" Style="{StaticResource MutedText}" />

          <WrapPanel Margin="0,12,0,0">
            <Button x:Name="CopyButton" Content="{DynamicResource Loc.logs.copy}"
                    Style="{StaticResource SecondaryButton}"
                    Margin="0,0,8,8" Click="OnCopySanitized" />
            <Button Content="{DynamicResource Loc.logs.diagnoseWithAi}"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,0,8,8" Click="OnOpenDiagnostic" />
            <TextBlock x:Name="CopyHintText" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="2,0,0,8" Visibility="Collapsed" />
          </WrapPanel>

          <TextBlock x:Name="NoFindingText" Style="{StaticResource MutedText}"
                     Margin="0,4,0,0" Visibility="Collapsed"
                     Text="{DynamicResource Loc.logs.noFindings}" />

          <StackPanel x:Name="FindingList" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
