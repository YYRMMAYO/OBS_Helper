<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- 界面全部使用自研 app.css，不依赖 ICU 的区域数据；关闭后可省下约 1.5 MB 的
         globalization 数据下载。时区支持保持开启（日志时间要按本地时区显示）。 -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Copyright>Copyright (c) 2026 OBS Helper</Copyright>
    <Authors>OBS Helper</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/YYRMMAYO/OBS_Helper</RepositoryUrl>
    <PackageProjectUrl>https://github.com/YYRMMAYO/OBS_Helper</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
  </ItemGroup>

  <!-- Bootstrap 从未被任何 .razor 使用（全部样式来自 css/app.css），
       从产物中排除以缩减包体与首屏请求数。文件仍保留在仓库里，便于随时回退。 -->
  <ItemGroup>
    <Content Remove="wwwroot\lib\**" />
    <None Include="wwwroot\lib\**" />
  </ItemGroup>

</Project>
