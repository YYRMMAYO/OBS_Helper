<UserControl x:Class="OBS_Helper.Wpf.Controls.FeedbackCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    BUG 反馈入口（V2.9.3）。两种给法：
      · 扫二维码（手机直接填，不要求用户在本机登录 / 复制链接）；
      · 点按钮打开表单 / GitHub Issue。
    二维码是**随包 PNG 内嵌资源**，离线可扫，不依赖任何在线二维码服务。
  -->
  <Border Style="{StaticResource Card}" Padding="14">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border x:Name="QrPanel" Grid.Column="0" Background="White" CornerRadius="6" Padding="6"
              VerticalAlignment="Top" Margin="0,0,14,0">
        <StackPanel>
          <Image x:Name="QrImage" Width="120" Height="120" Stretch="Uniform"
                 RenderOptions.BitmapScalingMode="NearestNeighbor" />
          <TextBlock x:Name="QrHintText" Style="{StaticResource CaptionText}"
                     Margin="0,6,0,0" MaxWidth="120" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Column="1" VerticalAlignment="Top">
        <TextBlock x:Name="TitleText" FontWeight="SemiBold"
                   FontSize="{DynamicResource FontSizeMd}"
                   Foreground="{DynamicResource TextBrush}" />

        <TextBlock x:Name="DescText" Style="{StaticResource MutedText}"
                   Margin="0,6,0,0" TextWrapping="Wrap" />

        <WrapPanel Margin="0,10,0,0">
          <Button Content="{DynamicResource Loc.feedback.openForm}" Style="{StaticResource PrimaryButton}"
                  Margin="0,0,8,8" Click="OnOpenForm" />
          <Button Content="{DynamicResource Loc.feedback.openIssues}" Style="{StaticResource GhostButton}"
                  Margin="0,0,8,8" Click="OnOpenIssues" />
        </WrapPanel>

        <TextBlock x:Name="StatusText" Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                   Visibility="Collapsed" />

        <!--
          安全上报引导（V2.9.5）：以前只说「不要公开披露」，却没说该走哪条私密通道 ——
          而 GitHub 没有私信功能，用户实际上只能去公开 Issue 里踩雷。
        -->
        <TextBlock x:Name="SecurityNoteText" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
