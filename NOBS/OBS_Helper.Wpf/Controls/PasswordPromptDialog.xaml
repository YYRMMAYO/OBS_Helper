<Window x:Class="OBS_Helper.Wpf.Controls.PasswordPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusLg}"
          Padding="22,20"
          Margin="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#000000" />
    </Border.Effect>

    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="🔑" FontSize="18" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontSizeMd}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                 FontSize="{DynamicResource FontSizeBase}"
                 Foreground="{DynamicResource MutedBrush}" />

      <PasswordBox x:Name="PasswordInput" Style="{StaticResource AppPasswordBox}" Margin="0,14,0,0" />
      <TextBlock Style="{StaticResource CaptionText}" Margin="2,6,0,0" TextWrapping="Wrap"
                 Text="{DynamicResource Loc.simple.password.hint}" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" MinWidth="82" Margin="0,0,10,0"
                IsCancel="True" Click="OnCancel" />
        <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" MinWidth="82"
                IsDefault="True" Click="OnOk" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
