<UserControl x:Class="OBS_Helper.Wpf.Views.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <!-- 页面大标题在 MainWindow 顶栏，这里只保留原版的引导文案 -->
      <TextBlock Style="{StaticResource MutedText}"
                 Text="{DynamicResource Loc.setup.intro}" />

      <!--
        获取官方 OBS（V2.9.1）：搭建流程第一步是「准备与权限」，但更前置的问题是
        「机器上还没有 OBS / 装到了下载站的仿冒包」。把官方入口放在流程之前。
        V2.9.3：同一张卡里补了应用内下载、瓦特工具箱 / 微软商店两条备用通道。
      -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.setup.officialObs}" Margin="0,18,0,10" />
      <ctl:ObsDownloadCard x:Name="DownloadCardControl" />

      <!--
        一键部署录制环境（V2.9.3）：装好 OBS 之后最实际的一步 —— 把与录制质量直接相关的
        几项配置一次到位（先备份、可回滚、逐项可取消）。
      -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.env.title}" Margin="0,18,0,10" />
      <ctl:RecordingEnvCard x:Name="RecordingEnv" />

      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.setup.flow}" Margin="0,18,0,10" />
      <StackPanel x:Name="FlowPanel" />

      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.setup.wizards}" Margin="0,18,0,10" />
      <WrapPanel x:Name="WizardPanel" />

      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.setup.platforms}" Margin="0,18,0,10" />
      <WrapPanel x:Name="PlatformPanel" />

      <StackPanel x:Name="ProblemPanel" Margin="0,10,0,0" />

      <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                 Text="{DynamicResource Loc.setup.platformEmpty}"
                 Visibility="Collapsed" />

      <Border Style="{StaticResource SoftPanel}" Margin="0,16,0,0">
        <TextBlock Style="{StaticResource MutedText}"
                   Text="{DynamicResource Loc.setup.multiHint}" />
      </Border>

      <!-- BUG 反馈（V2.9.3）：二维码 + 表单 / Issue 两个入口 -->
      <ctl:FeedbackCard x:Name="FeedbackCardControl" Margin="0,16,0,0" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
