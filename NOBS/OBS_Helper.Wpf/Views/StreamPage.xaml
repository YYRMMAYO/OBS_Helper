<UserControl x:Class="OBS_Helper.Wpf.Views.StreamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">
      <ctl:SelfCheckCard x:Name="SelfCheck" RunRequested="OnSelfCheck" />

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8" Text="{DynamicResource Loc.stream.health}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc.stream.refresh}" Click="OnRefreshHealth" />
            <CheckBox x:Name="SentinelCheck" Content="{DynamicResource Loc.stream.sentinel}" Margin="12,0,0,0" VerticalAlignment="Center" Click="OnSentinelToggle" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.stream.saveReplay}" Click="OnSaveReplay" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.stream.panic}" Click="OnPanic" />
          </WrapPanel>
          <TextBlock x:Name="HealthText" Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.stream.composition}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.brightness}" VerticalAlignment="Center" />
            <Slider Grid.Row="0" Grid.Column="1" x:Name="BrightnessSlider" Minimum="0" Maximum="1" Value="0.5" />
            <TextBlock Grid.Row="1" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.colorTemp}" VerticalAlignment="Center" />
            <Slider Grid.Row="1" Grid.Column="1" x:Name="TempSlider" Minimum="2000" Maximum="10000" Value="5600" />
            <TextBlock Grid.Row="2" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.skinRatio}" VerticalAlignment="Center" />
            <Slider Grid.Row="2" Grid.Column="1" x:Name="SkinSlider" Minimum="0" Maximum="1" Value="0.1" />
            <TextBlock Grid.Row="3" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.offset}" VerticalAlignment="Center" />
            <Slider Grid.Row="3" Grid.Column="1" x:Name="OffsetSlider" Minimum="0" Maximum="1" Value="0.1" />
            <TextBlock Grid.Row="4" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.contrast}" VerticalAlignment="Center" />
            <Slider Grid.Row="4" Grid.Column="1" x:Name="ContrastSlider" Minimum="0" Maximum="1" Value="0.4" />
          </Grid>
          <Button Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"
                  Content="{DynamicResource Loc.stream.evaluate}" Click="OnEvaluateComposition" />
          <TextBlock x:Name="CompositionText" Style="{StaticResource BodyText}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.stream.runbook}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel x:Name="RunbookPanel" />
          <TextBlock x:Name="RunbookText" Style="{StaticResource BodyText}" Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.stream.relay}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.relayName}" />
              <TextBox x:Name="RelayNameBox" Width="120" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.relayUrl}" />
              <TextBox x:Name="RelayUrlBox" Width="280" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.relayKey}" />
              <PasswordBox x:Name="RelayKeyBox" Width="180" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.relayFfmpeg}" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox x:Name="RelayFfmpegBox" Width="240" />
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="{DynamicResource Loc.caption.browse}" Click="OnBrowseRelayFfmpeg" />
                <Button x:Name="RelayFfmpegInstallButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="{DynamicResource Loc.stream.installFfmpeg}" Click="OnInstallRelayFfmpeg" />
              </StackPanel>
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.stream.addTarget}" Click="OnAddRelay" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.stream.validate}" Click="OnValidateRelay" />
            <Button x:Name="RelayStartButton" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.stream.relayStart}" Click="OnRelayStart" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.stream.relayStop}" Click="OnRelayStop" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.stream.relayPoint}" Click="OnRelayPoint" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.stream.relayRestore}" Click="OnRelayRestore" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.sidecar.openFolder}" Click="OnOpenSidecars" />
          </WrapPanel>
          <ListBox x:Name="RelayList" ctl:WheelForwarder.Enabled="True" Height="100" Margin="0,8,0,0" />
          <TextBlock x:Name="RelayText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.stream.archive}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.rclonePath}" />
              <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBox x:Name="RcloneBox" Width="240" />
                <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="{DynamicResource Loc.caption.browse}" Click="OnBrowseRclone" />
                <Button x:Name="RcloneInstallButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                        Content="{DynamicResource Loc.stream.installRclone}" Click="OnInstallRclone" />
              </StackPanel>
            </StackPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.remoteName}" />
              <TextBox x:Name="RemoteBox" Width="200" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.stream.validate}" Click="OnValidateArchive" />
          </WrapPanel>
          <WrapPanel Margin="0,8,0,0">
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc.stream.archiveRun}" Click="OnArchiveRun" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.stream.archiveVerify}" Click="OnArchiveVerify" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.stream.archiveUndo}" Click="OnArchiveUndo" />
          </WrapPanel>
          <CheckBox x:Name="AutoArchiveCheck" Content="{DynamicResource Loc.stream.archive.auto}"
                    Margin="0,8,0,0" Click="OnAutoArchiveToggle" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.stream.archive.autoTip}" />
          <TextBlock x:Name="ArchiveText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.stream.audioChain}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.audioInput}" />
              <ComboBox x:Name="AudioInputCombo" Width="180" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.stream.audioPreset}" />
              <ComboBox x:Name="AudioPresetCombo" Width="150" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.stream.audioApply}" Click="OnAudioApply" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.stream.audioBypass}" Click="OnAudioBypass" />
          </WrapPanel>
          <TextBlock x:Name="AudioText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
