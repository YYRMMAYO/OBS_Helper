<UserControl x:Class="OBS_Helper.Wpf.Views.PerformancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource MutedText}"
                   Text="本机 CPU / 内存 / 网络 / 磁盘实时监控，每秒采样一次。结合 OBS 的渲染帧率与丢帧数据，可定位卡顿到底是系统瓶颈还是 OBS 设置问题。" />
        <Button Grid.Column="1" Content="前往智能诊断" Style="{StaticResource SecondaryButton}"
                Margin="12,0,0,0" Click="OnOpenDiagnostic" />
      </Grid>

      <!-- ================================================== 实时数值卡 -->
      <UniformGrid Columns="4" Margin="0,14,0,0">
        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="CpuValueText" Text="—" FontSize="{DynamicResource FontSizeXl}"
                       FontWeight="Bold" Foreground="{DynamicResource BrandBrush}" />
            <TextBlock Text="CPU 占用" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="MemValueText" Text="—" FontSize="{DynamicResource FontSizeXl}"
                       FontWeight="Bold" Foreground="{DynamicResource BrandBrush}" />
            <TextBlock Text="内存占用" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="NetValueText" Text="—" FontSize="{DynamicResource FontSizeXl}"
                       FontWeight="Bold" Foreground="{DynamicResource BrandBrush}" />
            <TextBlock Text="网络下行" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="14,12">
          <StackPanel>
            <TextBlock x:Name="DiskValueText" Text="—" FontSize="{DynamicResource FontSizeXl}"
                       FontWeight="Bold" Foreground="{DynamicResource BrandBrush}" />
            <TextBlock Text="磁盘剩余（最少盘）" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ================================================== 曲线区 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="近 2 分钟趋势" Margin="0,20,0,10" />
      <UniformGrid Columns="2">
        <Border Style="{StaticResource Card}" Margin="0,0,10,10" Padding="14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="CPU 占用" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock x:Name="CpuTrendValue" Style="{StaticResource CaptionText}"
                         Margin="8,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ctl:Sparkline x:Name="CpuChart" Height="96" Margin="0,10,0,0"
                           Stroke="{DynamicResource BrandBrush}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,0,10" Padding="14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="内存占用" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock x:Name="MemTrendValue" Style="{StaticResource CaptionText}"
                         Margin="8,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ctl:Sparkline x:Name="MemChart" Height="96" Margin="0,10,0,0"
                           Stroke="{DynamicResource BrandBrush}" MaxValue="100" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Margin="0,0,10,0" Padding="14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="网络下行" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock x:Name="NetDownTrendValue" Style="{StaticResource CaptionText}"
                         Margin="8,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ctl:Sparkline x:Name="NetDownChart" Height="96" Margin="0,10,0,0"
                           Stroke="{DynamicResource BrandBrush}" />
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="14">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="网络上行" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock x:Name="NetUpTrendValue" Style="{StaticResource CaptionText}"
                         Margin="8,1,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <ctl:Sparkline x:Name="NetUpChart" Height="96" Margin="0,10,0,0"
                           Stroke="{DynamicResource BrandBrush}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- ================================================== OBS 状态 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="OBS 运行状态" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock x:Name="ObsStatusText" Style="{StaticResource MutedText}"
                     Text="未连接 OBS。连接后这里会显示渲染帧率、丢帧率与 OBS 报告的性能数据。" />
          <UniformGrid Columns="3" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock x:Name="ObsFpsText" Text="—" FontSize="{DynamicResource FontSizeLg}"
                         FontWeight="Bold" Foreground="{DynamicResource BrandBrush}" />
              <TextBlock Text="渲染 FPS" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="ObsRenderSkipText" Text="—" FontSize="{DynamicResource FontSizeLg}"
                         FontWeight="Bold" Foreground="{DynamicResource BrandBrush}" />
              <TextBlock Text="渲染丢帧" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel>
              <TextBlock x:Name="ObsOutputSkipText" Text="—" FontSize="{DynamicResource FontSizeLg}"
                         FontWeight="Bold" Foreground="{DynamicResource BrandBrush}" />
              <TextBlock Text="编码丢帧" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
            </StackPanel>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- ================================================== 磁盘明细 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="磁盘空间" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel x:Name="DisksPanel" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
