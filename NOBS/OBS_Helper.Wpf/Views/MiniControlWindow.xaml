<Window x:Class="OBS_Helper.Wpf.Views.MiniControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.mini.title}"
        Width="344"
        SizeToContent="Height"
        MinHeight="136"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        Closing="OnClosing">
  <Window.Resources>
    <!-- 小窗专用紧凑按钮：比 GhostButton 更小，适合窄面板 -->
    <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,8,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder"
          CornerRadius="12"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1"
          Padding="14,10"
          MouseLeftButtonDown="OnDrag">
    <Border.Effect>
      <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.4" Direction="270" />
    </Border.Effect>

    <StackPanel>
      <!-- 标题行：图标 + 标题 | 连接状态 | 关闭（隐藏） -->
      <Grid Margin="0,0,0,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="🎛" VerticalAlignment="Center" Margin="0,0,6,0" />
        <TextBlock Grid.Column="1" Text="{DynamicResource Loc.mini.title}" FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource FontSizeBase}" />
        <TextBlock x:Name="StatusText" Grid.Column="2" Text="{DynamicResource Loc.mini.statusDisconnected}"
                   VerticalAlignment="Center" Margin="0,0,10,0"
                   Style="{StaticResource CaptionText}" />
        <Button x:Name="CloseButton" Grid.Column="3" Content="✕"
                Style="{StaticResource MiniButton}"
                MinWidth="26" MinHeight="26" Margin="0"
                ToolTip="{DynamicResource Loc.mini.hideTip}"
                Click="OnCloseClick" />
      </Grid>

      <!-- 控制按钮：录制 / 推流 / 虚拟摄像头 -->
      <StackPanel Orientation="Horizontal">
        <Button x:Name="RecordButton" Style="{StaticResource MiniButton}"
                Click="OnRecordClick">
          <TextBlock x:Name="RecordButtonText" Text="{DynamicResource Loc.mini.startRecord}" VerticalAlignment="Center" />
        </Button>
        <Button x:Name="StreamButton" Style="{StaticResource MiniButton}"
                Click="OnStreamClick">
          <TextBlock x:Name="StreamButtonText" Text="{DynamicResource Loc.mini.startStream}" VerticalAlignment="Center" />
        </Button>
        <Button x:Name="VcamButton" Style="{StaticResource MiniButton}" Margin="0"
                Click="OnVcamClick">
          <TextBlock x:Name="VcamButtonText" Text="{DynamicResource Loc.mini.vcamOn}" VerticalAlignment="Center" />
        </Button>
      </StackPanel>

      <!--
        实时指标行（V3.0 / C2）：小窗的意义是「全屏游戏里不用切出去」，
        所以它必须回答的不只是「能不能按」，而是「录/播得怎么样」。
        内容：录制时长 · 剩余可录 · 推流丢帧/拥塞 —— 数据全部来自已有采样，零新增开销。
      -->
      <TextBlock x:Name="MetricsText" Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                 TextWrapping="Wrap" Text="" />

      <!-- 底部提示 -->
      <TextBlock Text="{DynamicResource Loc.mini.footer}"
                 Style="{StaticResource CaptionText}" Margin="2,4,0,0" />
    </StackPanel>
  </Border>
</Window>
