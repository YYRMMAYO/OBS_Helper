<Window x:Class="OBS_Helper.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls"
        Title="{DynamicResource Loc.app.name}"
        Height="780" Width="1160"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface2Brush}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <Window.InputBindings>
    <KeyBinding Key="F" Modifiers="Control" Command="{x:Static ApplicationCommands.Find}" />
    <KeyBinding Key="BrowserBack" Command="NavigationCommands.BrowseBack" />
    <KeyBinding Key="Left" Modifiers="Alt" Command="NavigationCommands.BrowseBack" />
  </Window.InputBindings>

  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Find" Executed="OnFindExecuted" />
    <CommandBinding Command="NavigationCommands.BrowseBack" Executed="OnBrowseBackExecuted" />
  </Window.CommandBindings>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="212" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================================ 左侧导航 -->
    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}"
            BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
      <DockPanel>

        <!-- 品牌区 -->
        <StackPanel DockPanel.Dock="Top" Margin="18,20,18,14">
          <StackPanel Orientation="Horizontal">
            <!-- 左上角品牌图标：与应用 / 任务栏 / 托盘同一枚 appicon.ico（含圆角与徽章） -->
            <Image Width="30" Height="30" Stretch="Uniform"
                   Source="pack://application:,,,/Assets/appicon.ico"
                   VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Loc.app.name}" FontWeight="Bold"
                         FontSize="{DynamicResource FontSizeMd}"
                         Foreground="{DynamicResource TextBrush}" />
              <TextBlock x:Name="VersionText" Text="v1.0.0"
                         FontSize="{DynamicResource FontSizeXs}"
                         Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- 底部：连接状态 -->
        <Border DockPanel.Dock="Bottom" Margin="12,8,12,14" Padding="10,9"
                Background="{DynamicResource Surface2Brush}"
                CornerRadius="{DynamicResource CornerRadiusMd}">
          <StackPanel>
            <ctl:ConnectionBadge x:Name="SideBadge" />
            <TextBlock Text="{DynamicResource Loc.app.brandSubtitle}"
                       Margin="0,7,0,0"
                       FontSize="{DynamicResource FontSizeXs}"
                       Foreground="{DynamicResource MutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- 导航项 -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Style="{StaticResource PageScroll}">
          <StackPanel x:Name="NavPanel" Margin="0,2,0,8">
            <RadioButton x:Name="NavHome"       Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.home}"   Tag="{StaticResource IconGeomHome}"       Checked="OnNavChecked" />
            <RadioButton x:Name="NavSearch"     Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.search}"   Tag="{StaticResource IconGeomSearch}"     Checked="OnNavChecked" />
            <RadioButton x:Name="NavAssistant"  Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.assistant}"   Tag="{StaticResource IconGeomAssistant}"  Checked="OnNavChecked" />
            <RadioButton x:Name="NavDiagnostic" Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.diagnostic}"   Tag="{StaticResource IconGeomDiagnostic}" Checked="OnNavChecked" />
            <RadioButton x:Name="NavSetup"      Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.setup}"   Tag="{StaticResource IconGeomSetup}"      Checked="OnNavChecked" />
            <RadioButton x:Name="NavTemplates" Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.templates}"   Tag="{StaticResource IconGeomTemplates}" Checked="OnNavChecked" />
            <RadioButton x:Name="NavPlugins"   Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.plugins}"   Tag="{StaticResource IconGeomPlugins}" Checked="OnNavChecked" />
            <RadioButton x:Name="NavToolbox"   Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.toolbox}" Tag="{StaticResource IconGeomSetup}" Checked="OnNavChecked" />
            <RadioButton x:Name="NavConsole"    Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.console}" Tag="{StaticResource IconGeomConsole}"    Checked="OnNavChecked" />
            <RadioButton x:Name="NavPerformance" Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.performance}"   Tag="{StaticResource IconGeomPerformance}" Checked="OnNavChecked" />
            <RadioButton x:Name="NavGuide"      Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.guide}"   Tag="{StaticResource IconGeomGuide}"      Checked="OnNavChecked" />
            <RadioButton x:Name="NavSettings"   Style="{StaticResource NavTabButton}" Content="{DynamicResource Loc.nav.settings}"   Tag="{StaticResource IconGeomSettings}"   Checked="OnNavChecked" />
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>

    <!-- ============================================ 内容区 -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!--
        自定义背景层（v1.10）：位于顶栏与页面之下。
        ContentBackgroundBrush / ContentBackgroundImage / ContentBackgroundDim
        由 AppearanceService.Apply() 写入；默认即 Surface2，视觉与改版前一致。
      -->
      <Grid Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
        <Border Background="{DynamicResource ContentBackgroundBrush}" />
        <Image Source="{DynamicResource ContentBackgroundImage}"
               Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
        <Border Background="{DynamicResource ContentBackgroundDim}" />
      </Grid>

      <!-- 顶栏 -->
      <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
              Padding="16,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource IconButton}"
                  ToolTip="{DynamicResource Loc.main.back}" Click="OnBackClick"
                  Visibility="Collapsed" Margin="0,0,10,0">
            <!-- 矢量返回箭头：替代 unicode ←，避免字体渲染差异 -->
            <Path Data="M 15,5 L 8,12 L 15,19"
                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Width="16" Height="16" Stretch="Uniform" />
          </Button>

          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock x:Name="PageTitle" Text="{DynamicResource Loc.page.home.title}"
                       FontSize="{DynamicResource FontSizeLg}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextBrush}" />
            <TextBlock x:Name="PageSubtitle" Text="{DynamicResource Loc.page.home.subtitle}"
                       FontSize="{DynamicResource FontSizeXs}"
                       Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>

          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <ctl:ConnectionBadge x:Name="TopBadge" Margin="0,0,10,0" />
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc.nav.settings}"
                    Padding="10,6" Click="OnSettingsClick" />
          </StackPanel>
        </Grid>
      </Border>

      <!-- 页面容器 -->
      <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False" />

      <!-- 全局加载态遮罩（覆盖顶栏 + 页面；P0，由 BusyService 控制显隐与文案） -->
      <ContentControl x:Name="BusyOverlayHost" Grid.Row="0" Grid.RowSpan="2"
                      Style="{StaticResource BusyOverlay}" Visibility="Collapsed" Tag="{DynamicResource Loc.common.busy}" />

      <!-- 全局 Toast 容器（贴底居中；P0，由 ToastService 增删卡片） -->
      <StackPanel x:Name="ToastHost" Grid.Row="1" Style="{StaticResource ToastHost}" />
    </Grid>

    <!-- ============================================ 新手引导覆盖层（首次启动展示） -->
    <!--
      覆盖整窗（含左侧导航），首启时铺在界面上方；步骤文案与游标逻辑在 Services/Shell/OnboardingGuide.cs
      （纯逻辑、有单测），这里只负责渲染。进度点由代码按步骤数动态生成，改动步骤数不需要动 XAML。

      V2.9.1「跳转式引导」：
      1) 每一步都会自动把界面切到对应页面（Console / 首页 / 诊断 / 搭建），步骤说明再配上
         「本步对应页面」胶囊与额外的跳转按钮 —— 不再只是念文案；
      2) 卡片因此从正中挪到右下角、变暗层压到 0.35（≈17% 黑）：页面被卡片和遮罩盖住的话，
         跳转了也看不见，这是「跳转式引导」的关键取舍。
      遮罩仍然拦住底下的点击（保持「跟着引导走」的语义），热键同理（见 OnFindExecuted / OnBrowseBackExecuted）。
    -->
    <Grid x:Name="OnboardingLayer" Grid.ColumnSpan="2"
          Visibility="Collapsed"
          IsHitTestVisible="True">
      <!-- 变暗层：兼作点击拦截层（Border 有背景即可命中测试，铺满整个覆盖层）。
           透明度刻意压得很轻（OverlayBrush 本身已是 50% 黑，这里再乘 0.35 ≈ 17%）：
           引导的重点是「看界面」，遮罩太重会把刚跳过去的页面压得看不清。 -->
      <Border Background="{DynamicResource OverlayBrush}" Opacity="0.35" />

      <Border x:Name="OnboardingCard"
              Background="{DynamicResource SurfaceBrush}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
              CornerRadius="{DynamicResource CornerRadiusLg}"
              Effect="{DynamicResource CardShadowStrong}"
              Width="500" Padding="26,22"
              HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,20,20">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.onb.welcomeTitle}" FontWeight="SemiBold"
                     FontSize="{DynamicResource FontSizeXl}"
                     Foreground="{DynamicResource TextBrush}" />
          <TextBlock Text="{DynamicResource Loc.app.tagline}"
                     Margin="0,6,0,0" TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSizeSm}"
                     Foreground="{DynamicResource MutedBrush}" />

          <Border Style="{StaticResource HLine}" Margin="0,14,0,0" />

          <TextBlock x:Name="OnbStepTitle" Text="" FontWeight="SemiBold"
                     Margin="0,14,0,0" TextWrapping="Wrap"
                     FontSize="{DynamicResource FontSizeMd}"
                     Foreground="{DynamicResource BrandBrush}" />
          <TextBlock x:Name="OnbStepDesc" Text="" LineHeight="20"
                     TextWrapping="Wrap" Margin="0,9,0,0"
                     FontSize="{DynamicResource FontSizeSm}"
                     Foreground="{DynamicResource MutedBrush}" />

          <!-- 本步自动跳转到的页面：名字取自主窗口路由表，跟着页面标题走，不会写错 -->
          <StackPanel x:Name="OnbTargetRow" Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="{DynamicResource Loc.onb.targetLabel}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" />
            <Border Style="{StaticResource Pill}" Margin="7,0,0,0">
              <TextBlock x:Name="OnbTargetText" Text="" FontWeight="SemiBold"
                         FontSize="{DynamicResource FontSizeXs}"
                         Foreground="{DynamicResource BrandBrush}" />
            </Border>
          </StackPanel>

          <!-- 额外跳转按钮：本步提到的其它页面（内部路由）+ 官方下载入口（站外） -->
          <WrapPanel x:Name="OnbLinks" Margin="0,10,0,0" />

          <!-- 进度指示：圆点数量在代码里按 OnboardingGuide.Steps 动态生成 -->
          <StackPanel x:Name="OnbDots" Orientation="Horizontal"
                      HorizontalAlignment="Center" Margin="0,16,0,0" />

          <TextBlock x:Name="OnbStepCounter" Text="" HorizontalAlignment="Center"
                     Margin="0,8,0,0"
                     FontSize="{DynamicResource FontSizeXs}"
                     Foreground="{DynamicResource MutedBrush}" />

          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="OnbSkipBtn" Content="{DynamicResource Loc.onb.skip}" Style="{StaticResource GhostButton}"
                    Padding="12,7" Margin="0,0,8,0" Click="OnbSkipBtn_Click" />
            <Button x:Name="OnbBackBtn" Content="{DynamicResource Loc.onb.back}" Style="{StaticResource SecondaryButton}"
                    Padding="14,7" Margin="0,0,8,0"
                    Visibility="Collapsed" Click="OnbBackBtn_Click" />
            <Button x:Name="OnbNextBtn" Content="{DynamicResource Loc.onb.next}" Style="{StaticResource PrimaryButton}"
                    Padding="18,8" Click="OnbNextBtn_Click" />
          </StackPanel>

          <TextBlock Text="{DynamicResource Loc.onb.footer}"
                     HorizontalAlignment="Right" Margin="0,9,0,0"
                     FontSize="{DynamicResource FontSizeXs}"
                     Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</Window>
