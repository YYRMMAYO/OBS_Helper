<UserControl x:Class="OBS_Helper.Wpf.Views.ToolboxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <TextBlock Style="{StaticResource MutedText}"
                 Text="{DynamicResource Loc.toolbox.intro}" />

      <!-- ================================================== 录像工具 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.recordingTools}" Margin="0,16,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.openRecordingDir}" Style="{StaticResource PrimaryButton}" Click="OnOpenRecordingDir" />
            <Button Content="{DynamicResource Loc.toolbox.remux}" Style="{StaticResource SecondaryButton}"
                    Margin="10,0,0,0" Click="OnRemuxPickFile" />
          </StackPanel>
          <TextBlock x:Name="RecordingDirText" Style="{StaticResource MutedText}" Margin="0,10,0,0"
                     TextWrapping="Wrap" Text="{DynamicResource Loc.toolbox.recordingDirHint}" />
          <TextBlock x:Name="FfmpegText" Style="{StaticResource CaptionText}" Margin="0,6,0,0"
                     TextWrapping="Wrap" Text="" />
          <TextBlock x:Name="RemuxResultText" Style="{StaticResource BodyText}" Margin="0,8,0,0"
                     TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- ================================================== 参数处方 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.prescription}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{DynamicResource Loc.toolbox.prescription.scene}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            <ComboBox Grid.Column="1" x:Name="PresetCombo" Style="{StaticResource AppComboBox}"
                      Margin="8,0,0,0" SelectionChanged="OnPresetChanged" />
            <Button Grid.Column="2" Content="{DynamicResource Loc.toolbox.prescription.copy}" Style="{StaticResource SecondaryButton}"
                    Margin="12,0,0,0" Click="OnCopyPreset" />
          </Grid>
          <TextBox x:Name="PresetText" Style="{StaticResource AppCodeBox}" Margin="0,10,0,0"
                   IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas" />
        </StackPanel>
      </Border>

      <!-- ================================================== 隐私模式清单 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.privacy}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.toolbox.privacy.desc}" />
          <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.toolbox.privacy.checklist}" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{DynamicResource Loc.toolbox.privacy.focus}" Style="{StaticResource SecondaryButton}" Click="OnOpenFocusAssist" />
            <Button Content="{DynamicResource Loc.toolbox.privacy.notifications}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OnOpenNotifications" />
            <Button Content="{DynamicResource Loc.toolbox.privacy.personalization}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OnOpenPersonalization" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ================================================== 冲突软件扫描 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.conflicts}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.conflicts.scan}" Style="{StaticResource PrimaryButton}" Click="OnScanConflicts" />
            <TextBlock x:Name="ConflictSummaryText" Style="{StaticResource CaptionText}"
                       Margin="12,0,0,0" VerticalAlignment="Center" Text="" />
          </StackPanel>
          <ItemsControl x:Name="ConflictList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SoftPanel}" Padding="10,8" Margin="0,0,0,8">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                      <TextBlock Text="{Binding Risk}" Margin="10,0,0,0" FontWeight="Bold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding RiskLevel}" Value="high">
                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                              </DataTrigger>
                              <DataTrigger Binding="{Binding RiskLevel}" Value="medium">
                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Advice}" Style="{StaticResource MutedText}"
                               Margin="0,4,0,0" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="ConflictEmptyText" Style="{StaticResource MutedText}" Visibility="Collapsed"
                     Text="{DynamicResource Loc.toolbox.conflicts.none}" />
        </StackPanel>
      </Border>

      <!-- ================================================== 带宽计算器 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.bandwidth}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Loc.toolbox.bandwidth.upload}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            <TextBox x:Name="UploadInput" Style="{StaticResource AppTextBox}" Width="110"
                     MaxLength="6" Text="10" TextChanged="OnBandwidthInputChanged"
                     PreviewTextInput="OnNumericPreviewTextInput" />
            <TextBlock x:Name="RecommendHint" Style="{StaticResource CaptionText}" Margin="12,0,0,0"
                       VerticalAlignment="Center" Text="{DynamicResource Loc.toolbox.bandwidth.uploadHint}" />
          </StackPanel>

          <TextBlock x:Name="RecommendText" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                     TextWrapping="Wrap" Text="" />

          <Border Style="{StaticResource HLine}" Margin="0,12" />

          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Loc.toolbox.bandwidth.streams}" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            <TextBox x:Name="StreamCountInput" Style="{StaticResource AppTextBox}" Width="70" Margin="8,0,0,0"
                     MaxLength="2" TextChanged="OnBandwidthInputChanged"
                     PreviewTextInput="OnNumericPreviewTextInput" />
            <TextBlock Text="{DynamicResource Loc.toolbox.bandwidth.perStream}" VerticalAlignment="Center" Margin="8,0,0,0" Foreground="{DynamicResource TextBrush}" />
            <TextBox x:Name="StreamBitrateInput" Style="{StaticResource AppTextBox}" Width="90" Margin="8,0,0,0"
                     MaxLength="6" TextChanged="OnBandwidthInputChanged"
                     PreviewTextInput="OnNumericPreviewTextInput" />
            <TextBlock Text="kbps" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="{DynamicResource MutedBrush}" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="12,0,0,0"
                       VerticalAlignment="Center" Text="{DynamicResource Loc.toolbox.bandwidth.limit}" />
          </StackPanel>
          <TextBlock x:Name="MultiStreamText" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                     TextWrapping="Wrap" Text="" />
        </StackPanel>
      </Border>

      <!-- ================================================== 色彩体检（V2.7） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.colorCheck}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.colorCheck.run}" Style="{StaticResource PrimaryButton}" Click="OnRunColorCheck" />
            <TextBlock x:Name="ColorSummaryText" Style="{StaticResource CaptionText}"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{DynamicResource Loc.toolbox.colorCheck.desc}" />
          </StackPanel>
          <ItemsControl x:Name="ColorCheckList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SoftPanel}" Padding="10,8" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Detail}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- ================================================== 音频采样率体检（V2.7） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.sampleRate}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.sampleRate.run}" Style="{StaticResource PrimaryButton}" Click="OnRunSampleRateCheck" />
            <TextBlock x:Name="SampleRateSummaryText" Style="{StaticResource CaptionText}"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{DynamicResource Loc.toolbox.sampleRate.desc}" />
          </StackPanel>
          <TextBlock x:Name="SampleRateText" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                     TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- ================================================== 黑屏专项体检（V2.8） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.graphics}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.graphics.run}" Style="{StaticResource PrimaryButton}" Click="OnRunGraphicsEnvCheck" />
            <TextBlock x:Name="GraphicsEnvSummaryText" Style="{StaticResource CaptionText}"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{DynamicResource Loc.toolbox.graphics.desc}" />
          </StackPanel>
          <ItemsControl x:Name="GraphicsEnvList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SoftPanel}" Padding="10,8" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Detail}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="GraphicsEnvEmptyText" Style="{StaticResource MutedText}" Visibility="Visible"
                     Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.toolbox.notChecked.graphics}" />
        </StackPanel>
      </Border>

      <!-- ================================================== 音频设备深度体检（V2.8） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.audioHealth}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.audioHealth.run}" Style="{StaticResource PrimaryButton}" Click="OnRunAudioHealthCheck" />
            <TextBlock x:Name="AudioHealthSummaryText" Style="{StaticResource CaptionText}"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{DynamicResource Loc.toolbox.audioHealth.desc}" />
          </StackPanel>
          <ItemsControl x:Name="AudioHealthList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SoftPanel}" Padding="10,8" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Detail}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="AudioHealthEmptyText" Style="{StaticResource MutedText}" Visibility="Visible"
                     Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.toolbox.notChecked.audio}" />
        </StackPanel>
      </Border>

      <!-- ================================================== 虚拟摄像头体检（V2.8） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.vcam}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.vcam.run}" Style="{StaticResource PrimaryButton}" Click="OnRunVirtualCamCheck" />
            <TextBlock x:Name="VcamSummaryText" Style="{StaticResource CaptionText}"
                       Margin="12,0,0,0" VerticalAlignment="Center"
                       Text="{DynamicResource Loc.toolbox.vcam.desc}" />
          </StackPanel>
          <ItemsControl x:Name="VcamCheckList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SoftPanel}" Padding="10,8" Margin="0,0,0,8">
                  <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Detail}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="VcamEmptyText" Style="{StaticResource MutedText}" Visibility="Visible"
                     Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.toolbox.notChecked.vcam}" />
        </StackPanel>
      </Border>

      <!-- ================================================== 磁盘写入基准（V2.7） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.disk}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.disk.run}" Style="{StaticResource PrimaryButton}" Click="OnRunDiskBenchmark" />
            <TextBlock Text="{DynamicResource Loc.toolbox.disk.bitrate}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            <TextBox x:Name="DiskBitrateInput" Style="{StaticResource AppTextBox}" Width="90"
                     MaxLength="7" PreviewTextInput="OnNumericPreviewTextInput"
                     Text="20000" />
            <TextBlock Text="kbps" Margin="6,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
          </StackPanel>
          <TextBlock x:Name="DiskBenchmarkText" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     Text="{DynamicResource Loc.toolbox.disk.desc}" />
        </StackPanel>
      </Border>

      <!-- ================================================== 编码顾问（V2.7） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.encoder}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.encoder.run}" Style="{StaticResource PrimaryButton}" Click="OnRunEncoderAdvice" />
            <CheckBox x:Name="DualEncodeCheck" Content="{DynamicResource Loc.toolbox.encoder.dual}" Margin="14,0,0,0"
                      VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
          <TextBox x:Name="EncoderAdviceText" Style="{StaticResource AppCodeBox}" Margin="0,10,0,0"
                   IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                   FontFamily="Consolas" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- ================================================== 推流节点探测（V2.7） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.ingest}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.ingest.run}" Style="{StaticResource PrimaryButton}" Click="OnRunIngestPing" />
            <TextBlock Text="{DynamicResource Loc.toolbox.ingest.custom}" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}" />
            <TextBox x:Name="CustomHostInput" Style="{StaticResource AppTextBox}" Width="220"
                     ToolTip="{DynamicResource Loc.toolbox.ingest.customTip}" />
          </StackPanel>
          <ItemsControl x:Name="IngestList" Margin="0,10,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Style="{StaticResource SoftPanel}" Padding="10,8" Margin="0,0,0,8">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Target.Label}" Foreground="{DynamicResource TextBrush}" MinWidth="170" />
                    <TextBlock Text="{Binding Target.Host}" Style="{StaticResource MutedText}" MinWidth="250" />
                    <TextBlock Text="{Binding RttText}" FontWeight="SemiBold" Margin="10,0,0,0" Foreground="{DynamicResource TextBrush}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock x:Name="IngestHintText" Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                     TextWrapping="Wrap"
                     Text="{DynamicResource Loc.toolbox.ingest.note}" />
        </StackPanel>
      </Border>

      <!-- ================================================== 浏览器源健康检查（V2.7） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.browserSource}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.toolbox.browserSource.checklist}" />
          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{DynamicResource Loc.toolbox.browserSource.openConfig}" Style="{StaticResource SecondaryButton}" Click="OnOpenObsConfigDir" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ================================================== OBS 新版本情报 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.release}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.toolbox.release.query}" Style="{StaticResource PrimaryButton}" Click="OnFetchRelease" />
            <Button Content="{DynamicResource Loc.toolbox.release.openPage}" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Click="OnOpenReleaseUrl" />
          </StackPanel>
          <TextBlock x:Name="ReleaseText" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                     TextWrapping="Wrap"
                     Text="{DynamicResource Loc.toolbox.release.desc}" />
        </StackPanel>
      </Border>

      <!-- ================================================== 获取官方 OBS（V2.9.1） -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.setup.officialObs}" Margin="0,20,0,10" />
      <ctl:ObsDownloadCard />

      <!-- ================================================== 快捷键速查 -->
      <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.toolbox.shortcuts}" Margin="0,20,0,10" />
      <Border Style="{StaticResource Card}" Padding="14">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.toolbox.shortcuts.obsDefault}" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource BodyText}" LineHeight="26"
                       Text="{DynamicResource Loc.toolbox.shortcuts.obsDefaultList}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="16,0,0,0">
            <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.toolbox.shortcuts.suggested}" Margin="0,0,0,6" />
            <TextBlock Style="{StaticResource BodyText}" LineHeight="26"
                       Text="{DynamicResource Loc.toolbox.shortcuts.suggestedList}" />
          </StackPanel>
        </Grid>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
