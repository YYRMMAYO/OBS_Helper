<Window x:Class="OBS_Helper.Wpf.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="300"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFontFamily}">
  <Border x:Name="Root" CornerRadius="22" BorderThickness="1"
          BorderBrush="#33FFFFFF" Background="#F2101211" Opacity="0">
    <Border.Effect>
      <DropShadowEffect BlurRadius="34" ShadowDepth="8" Opacity="0.45" Direction="270" Color="#000000" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Width="76" Height="76" CornerRadius="20" Background="#FF0B0F14">
          <Image Source="pack://application:,,,/Assets/appicon.ico" Width="52" Height="52"
                 Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
        <TextBlock Text="OBS Helper" FontSize="26" FontWeight="Bold" Foreground="#FFF5F8FA"
                   HorizontalAlignment="Center" Margin="0,16,0,0" />
        <TextBlock Text="{DynamicResource Loc.app.name}" FontSize="13" Foreground="#FF9AA5AE"
                   HorizontalAlignment="Center" Margin="0,5,0,0" />
      </StackPanel>

      <StackPanel Grid.Row="1" Margin="38,0,38,26">
        <Grid Height="3" ClipToBounds="True">
          <Border Background="#22FFFFFF" CornerRadius="2" />
          <Border x:Name="Progress" Width="0" HorizontalAlignment="Left" CornerRadius="2"
                  Background="#FF93A7FF" />
        </Grid>
        <TextBlock Text="{DynamicResource Loc.splash.preparing}" FontSize="11"
                   Foreground="#FF88929C" Margin="0,9,0,0" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
