<UserControl x:Class="OBS_Helper.Wpf.Views.TemplatePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,16"
                 Text="{DynamicResource Loc.template.intro}" />

      <!--
        我的模板（V3.0 / D6）：把当前 OBS 场景集合反向存成一份模板。
        模板能力此前是单向的（官方模板 → 落地），用户自己调好的一套只能靠整包配置备份。
      -->
      <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
        <Button x:Name="CaptureButton" Content="{DynamicResource Loc.mytemplate.capture}"
                Style="{StaticResource SecondaryButton}"
                ToolTip="{DynamicResource Loc.mytemplate.captureTip}"
                Click="OnCaptureClick" />
        <Button x:Name="OpenMineDirButton" Content="{DynamicResource Loc.console.openRecordDir}"
                Style="{StaticResource GhostButton}" Margin="10,0,0,0" Visibility="Collapsed"
                Click="OnOpenMineDirClick" />
      </StackPanel>

      <!-- 状态条：矢量状态图标（info / ok / warn / danger 由 Tag 切换），替代 emoji -->
      <Border x:Name="StatusBar" Margin="0,0,0,14" Visibility="Collapsed"
              Background="{DynamicResource Surface2Brush}"
              CornerRadius="{DynamicResource CornerRadiusMd}" Padding="12,9">
        <StackPanel Orientation="Horizontal">
          <Grid x:Name="StatusIcon" Width="16" Height="16" Margin="0,0,8,0"
                VerticalAlignment="Center">
            <!-- info：i -->
            <StackPanel x:Name="StatusIconInfo">
              <Ellipse Fill="{DynamicResource InfoBrush}" Width="2.2" Height="2.2"
                       HorizontalAlignment="Center" Margin="0,0,0,10" />
              <Rectangle Fill="{DynamicResource InfoBrush}" Width="2.2" Height="6"
                         RadiusX="1.1" RadiusY="1.1" HorizontalAlignment="Center"
                         Margin="0,4,0,0" />
            </StackPanel>
            <!-- ok：对勾 -->
            <Path x:Name="StatusIconOk" Data="M 2.5,8.5 L 6,12 L 13.5,4"
                  Stroke="{DynamicResource OkBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Visibility="Collapsed" />
            <!-- warn：三角 -->
            <Path x:Name="StatusIconWarn" Data="M 8,1.5 L 15,13.5 L 1,13.5 Z"
                  Fill="{DynamicResource WarnBrush}"
                  Visibility="Collapsed" />
            <!-- danger：叉 -->
            <Path x:Name="StatusIconDanger" Data="M 3,3 L 13,13 M 13,3 L 3,13"
                  Stroke="{DynamicResource DangerBrush}" StrokeThickness="1.8"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Visibility="Collapsed" />
          </Grid>
          <TextBlock x:Name="StatusText" TextWrapping="Wrap" VerticalAlignment="Center"
                     FontSize="{DynamicResource FontSizeSm}"
                     Foreground="{DynamicResource TextBrush}" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}"
                 Text="{DynamicResource Loc.template.loading}" Visibility="Visible" />

      <!-- 模板列表（由 code-behind 手工组装卡片） -->
      <StackPanel x:Name="TemplateList" Visibility="Collapsed" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
