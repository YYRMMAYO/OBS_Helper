      },
      {
        "name": "课件全屏",
        "transitionDurationMs": 300,
        "hotkey": "Ctrl+2",
        "sources": [
          { "name": "屏幕", "inputKind": "monitor_capture", "zOrder": 0, "enabled": true, "shared": true,
            "placeholder": { "kind": "window", "hint": "选择要捕获的显示器" },
            "transform": { "posX": 0, "posY": 0, "boundsType": "OBS_BOUNDS_SCALE_OUTER", "boundsWidth": 1920, "boundsHeight": 1080, "alignment": 0 } },
          { "name": "章节标题", "inputKind": "text_gdiplus_v3", "zOrder": 1, "enabled": true, "shared": true,
            "fallbackKinds": ["text_ft2_source_v3"],
            "settings": { "text": "课件放映中", "font": { "face": "微软雅黑", "size": 44 }, "color": 4294967295 },
            "transform": { "posX": 40, "posY": 40, "boundsType": "OBS_BOUNDS_NONE", "alignment": 5 } }
        ]
      },
      {
        "name": "休息中",
        "transitionDurationMs": 500,
        "hotkey": "Ctrl+3",
        "sources": [
