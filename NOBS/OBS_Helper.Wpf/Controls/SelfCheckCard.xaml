<UserControl x:Class="OBS_Helper.Wpf.Controls.SelfCheckCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,14">
    <StackPanel>
      <DockPanel>
        <Button x:Name="RunButton" DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}"
                Content="{DynamicResource Loc.selfcheck.run}" Click="OnRunClick"
                VerticalAlignment="Center" />
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.selfcheck.title}" Style="{StaticResource H3Text}" />
          <TextBlock Text="{DynamicResource Loc.selfcheck.desc}" Style="{StaticResource CaptionText}"
                     Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </DockPanel>
      <TextBlock x:Name="ResultText" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                 TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
