<UserControl x:Class="OBS_Helper.Wpf.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26" MaxWidth="760" HorizontalAlignment="Left">

      <!-- ==================================================== 语言（V2.9.2） -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.language.section}" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.language.hint}" />

          <!-- 语言切换条：选项由 code-behind 按 Strings.Supported 生成，增语言不必改 XAML -->
          <StackPanel x:Name="LanguagePanel" Orientation="Horizontal" />
        </StackPanel>
      </Border>

      <!-- ==================================================== AI 诊断引擎 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.settings.ai.title}" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.settings.ai.desc}" />

          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ModeLocal" GroupName="SettingsEngineMode" Content="{DynamicResource Loc.settings.ai.engine.local}"
                         Style="{StaticResource SegmentButton}" Checked="OnModeChecked" />
            <RadioButton x:Name="ModeFree" GroupName="SettingsEngineMode" Content="{DynamicResource Loc.settings.ai.engine.free}"
                         Style="{StaticResource SegmentButton}" Checked="OnModeChecked" />
            <RadioButton x:Name="ModeCloud" GroupName="SettingsEngineMode" Content="{DynamicResource Loc.settings.ai.engine.cloud}"
                         Style="{StaticResource SegmentButton}" Checked="OnModeChecked" />
          </StackPanel>

          <!-- 免费内置 AI：无需任何配置，选中即用；只展示模型名与本地限额 -->
          <StackPanel x:Name="FreePanel" Visibility="Collapsed" Margin="0,4,0,0">
            <TextBlock Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                       Text="{DynamicResource Loc.settings.ai.free.desc}" />
            <TextBlock x:Name="FreeKeyStatusText" Style="{StaticResource CaptionText}"
                       Margin="2,6,0,0" Foreground="{DynamicResource WarnBrush}" Visibility="Collapsed" />

            <TextBlock Text="{DynamicResource Loc.settings.ai.free.channel}" Style="{StaticResource MutedText}" Margin="2,10,0,0" />
            <StackPanel Orientation="Horizontal" Margin="2,4,0,0">
              <RadioButton x:Name="FreeProviderZhipu" GroupName="SettingsFreeProvider"
                           Content="{DynamicResource Loc.settings.ai.free.provider.zhipu}"
                           Style="{StaticResource SegmentButton}" Checked="OnFreeProviderChanged" />
              <RadioButton x:Name="FreeProviderPollinations" GroupName="SettingsFreeProvider"
                           Content="{DynamicResource Loc.settings.ai.free.provider.pollinations}"
                           Style="{StaticResource SegmentButton}" Checked="OnFreeProviderChanged" />
            </StackPanel>
            <TextBlock Style="{StaticResource CaptionText}" Margin="2,6,0,0"
                       Text="{DynamicResource Loc.settings.ai.free.providerDesc}" />

            <Grid Margin="0,12,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <TextBlock Text="{DynamicResource Loc.settings.ai.free.model}" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
                <ComboBox x:Name="FreeModelBox" Style="{StaticResource AppComboBox}"
                          ItemContainerStyle="{StaticResource AppComboBoxItem}"
                          IsEditable="False" SelectedValuePath="Tag" DisplayMemberPath="Content" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="2,4,0,0"
                           Text="{DynamicResource Loc.settings.ai.free.modelHint}" />
              </StackPanel>
              <Button Grid.Column="1" Content="{DynamicResource Loc.settings.save}" Style="{StaticResource SecondaryButton}"
                      VerticalAlignment="Bottom" Click="OnSaveFreeModel" />
            </Grid>

            <TextBlock x:Name="FreeQuotaText" Style="{StaticResource MutedText}" Margin="2,10,0,0" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="2,6,0,0"
                       Text="{DynamicResource Loc.settings.ai.free.noTools}" />
            <TextBlock x:Name="FreeStatusText" Style="{StaticResource MutedText}"
                       Margin="0,10,0,0" Visibility="Collapsed" />
          </StackPanel>

          <!-- 只有选「云端」才展开：本地模式下这些字段没有任何意义 -->
          <StackPanel x:Name="CloudPanel" Visibility="Collapsed" Margin="0,4,0,0">

            <TextBlock Text="{DynamicResource Loc.settings.ai.cloud.url}" Style="{StaticResource MutedText}" Margin="0,8,0,5" />
            <TextBox x:Name="CloudUrlBox" Style="{StaticResource AppTextBox}"
                     Tag="https://api.example.com/v1/chat/completions" />

            <TextBlock Text="{DynamicResource Loc.settings.ai.cloud.keyName}" Style="{StaticResource MutedText}" Margin="0,12,0,5" />
            <TextBox x:Name="CloudKeyNameBox" Style="{StaticResource AppTextBox}" Tag="obs_ai_apikey" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="2,5,0,0"
                       Text="{DynamicResource Loc.settings.ai.cloud.keyNameHint}" />

            <TextBlock Text="{DynamicResource Loc.settings.ai.cloud.model}" Style="{StaticResource MutedText}" Margin="0,12,0,5" />
            <TextBox x:Name="CloudModelBox" Style="{StaticResource AppTextBox}" Tag="gpt-4o-mini" />

            <Button Content="{DynamicResource Loc.settings.ai.cloud.save}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Margin="0,14,0,0" Click="OnSaveCloud" />

            <Border Style="{StaticResource HLine}" />

            <TextBlock Text="API Key" Style="{StaticResource MutedText}" Margin="0,0,0,5" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <PasswordBox x:Name="ApiKeyBox" Grid.Column="0" Style="{StaticResource AppPasswordBox}" />
              <Button x:Name="SaveKeyButton" Grid.Column="1" Content="{DynamicResource Loc.settings.ai.cloud.saveKey}"
                      Style="{StaticResource PrimaryButton}" Margin="10,0,0,0" Click="OnSaveKey" />
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <TextBlock Text="{DynamicResource Loc.settings.ai.cloud.status}" Style="{StaticResource CaptionText}"
                         VerticalAlignment="Center" Margin="0,0,8,0" />
              <Border x:Name="KeyStatusPill" Style="{StaticResource Pill}">
                <TextBlock x:Name="KeyStatusText" Text="{DynamicResource Loc.settings.ai.cloud.notSaved}"
                           FontSize="{DynamicResource FontSizeXs}"
                           Foreground="{DynamicResource MutedBrush}" />
              </Border>
              <Button x:Name="ClearKeyButton" Content="{DynamicResource Loc.settings.ai.cloud.clearKey}" Style="{StaticResource GhostButton}"
                      Foreground="{DynamicResource DangerBrush}" Margin="6,0,0,0" Click="OnClearKey" />
            </StackPanel>
            <TextBlock Style="{StaticResource CaptionText}" Margin="2,6,0,0"
                       Text="{DynamicResource Loc.settings.ai.cloud.keyHint}" />

            <TextBlock x:Name="CloudWarnText" Style="{StaticResource MutedText}"
                       Foreground="{DynamicResource WarnBrush}" Margin="0,10,0,0" Visibility="Collapsed"
                       Text="{DynamicResource Loc.settings.ai.cloud.notConfigured}" />

            <TextBlock x:Name="AiStatusText" Style="{StaticResource MutedText}"
                       Margin="0,10,0,0" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== 外观与无障碍 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.settings.appearance.title}" Style="{StaticResource SectionTitle}" />

          <TextBlock Text="{DynamicResource Loc.settings.appearance.theme}" Style="{StaticResource MutedText}" Margin="0,2,0,7" />
          <WrapPanel>
            <RadioButton x:Name="ThemeSystem" GroupName="SettingsTheme" Content="{DynamicResource Loc.settings.appearance.theme.system}"
                         Style="{StaticResource SegmentButton}" Checked="OnThemeChecked" />
            <RadioButton x:Name="ThemeLight" GroupName="SettingsTheme" Content="{DynamicResource Loc.settings.appearance.theme.light}"
                         Style="{StaticResource SegmentButton}" Checked="OnThemeChecked" />
            <RadioButton x:Name="ThemeDark" GroupName="SettingsTheme" Content="{DynamicResource Loc.settings.appearance.theme.dark}"
                         Style="{StaticResource SegmentButton}" Checked="OnThemeChecked" />
          </WrapPanel>

          <!-- 【v2.7.1 强调色体系】品牌主色色板：按钮 / 选中态 / 小标等全局品牌色 -->
          <TextBlock Text="{DynamicResource Loc.settings.appearance.accent}" Style="{StaticResource MutedText}" Margin="0,10,0,7" />
          <WrapPanel x:Name="AccentPanel" Margin="0,0,0,2" />

          <TextBlock Text="{DynamicResource Loc.settings.appearance.font}" Style="{StaticResource MutedText}" Margin="0,10,0,7" />
          <WrapPanel>
            <RadioButton x:Name="FontSm" GroupName="SettingsFontScale" Content="{DynamicResource Loc.settings.appearance.font.sm}"
                         Style="{StaticResource SegmentButton}" Checked="OnFontScaleChecked" />
            <RadioButton x:Name="FontMd" GroupName="SettingsFontScale" Content="{DynamicResource Loc.settings.appearance.font.md}"
                         Style="{StaticResource SegmentButton}" Checked="OnFontScaleChecked" />
            <RadioButton x:Name="FontLg" GroupName="SettingsFontScale" Content="{DynamicResource Loc.settings.appearance.font.lg}"
                         Style="{StaticResource SegmentButton}" Checked="OnFontScaleChecked" />
            <RadioButton x:Name="FontXl" GroupName="SettingsFontScale" Content="{DynamicResource Loc.settings.appearance.font.xl}"
                         Style="{StaticResource SegmentButton}" Checked="OnFontScaleChecked" />
          </WrapPanel>

          <Border Style="{StaticResource HLine}" />

          <CheckBox x:Name="HighContrastSwitch" Style="{StaticResource AppSwitch}" Content="{DynamicResource Loc.settings.appearance.highContrast}"
                    Checked="OnHighContrastToggled" Unchecked="OnHighContrastToggled" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="52,5,0,0"
                     Text="{DynamicResource Loc.settings.appearance.highContrastDesc}" />

          <CheckBox x:Name="ReduceMotionSwitch" Style="{StaticResource AppSwitch}" Content="{DynamicResource Loc.settings.appearance.reduceMotion}"
                    Margin="0,14,0,0" Checked="OnReduceMotionToggled" Unchecked="OnReduceMotionToggled" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="52,5,0,0"
                     Text="{DynamicResource Loc.settings.appearance.reduceMotionDesc}" />

          <!-- ============================================ 自定义背景（v1.10） -->
          <Border Style="{StaticResource HLine}" Margin="0,14,0,0" />

          <TextBlock Text="{DynamicResource Loc.settings.appearance.background}" Style="{StaticResource MutedText}" Margin="0,2,0,7" />
          <WrapPanel>
            <RadioButton x:Name="BgDefault" GroupName="SettingsBackground" Content="{DynamicResource Loc.settings.bg.default}"
                         Style="{StaticResource SegmentButton}" Checked="OnBgModeChecked" />
            <RadioButton x:Name="BgColor" GroupName="SettingsBackground" Content="{DynamicResource Loc.settings.bg.color}"
                         Style="{StaticResource SegmentButton}" Checked="OnBgModeChecked" />
            <RadioButton x:Name="BgImage" GroupName="SettingsBackground" Content="{DynamicResource Loc.settings.bg.image}"
                         Style="{StaticResource SegmentButton}" Checked="OnBgModeChecked" />
          </WrapPanel>

          <!-- 纯色预设色板 -->
          <WrapPanel x:Name="BgColorPanel" Margin="0,10,0,0" Visibility="Collapsed">
            <Border x:Name="BgSwatchLight" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,8"
                    Background="#f4f4fb" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{DynamicResource Loc.settings.bg.swatch.gray}" MouseLeftButtonUp="OnBgSwatchClick" Tag="#f4f4fb" />
            <Border x:Name="BgSwatchBlue" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,8"
                    Background="#e8f0fe" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{DynamicResource Loc.settings.bg.swatch.blue}" MouseLeftButtonUp="OnBgSwatchClick" Tag="#e8f0fe" />
            <Border x:Name="BgSwatchGreen" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,8"
                    Background="#e7f6ee" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{DynamicResource Loc.settings.bg.swatch.green}" MouseLeftButtonUp="OnBgSwatchClick" Tag="#e7f6ee" />
            <Border x:Name="BgSwatchWarm" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,8"
                    Background="#fef4e6" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{DynamicResource Loc.settings.bg.swatch.beige}" MouseLeftButtonUp="OnBgSwatchClick" Tag="#fef4e6" />
            <Border x:Name="BgSwatchPink" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,8"
                    Background="#fdeceb" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{DynamicResource Loc.settings.bg.swatch.pink}" MouseLeftButtonUp="OnBgSwatchClick" Tag="#fdeceb" />
            <Border x:Name="BgSwatchDark" Width="30" Height="30" CornerRadius="8" Margin="0,0,8,8"
                    Background="#14151d" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{DynamicResource Loc.settings.bg.swatch.ink}" MouseLeftButtonUp="OnBgSwatchClick" Tag="#14151d" />
            <TextBlock x:Name="BgColorHint" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="2,0,0,8" />
          </WrapPanel>

          <!-- 图片背景 -->
          <StackPanel x:Name="BgImagePanel" Margin="0,10,0,0" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" Content="{DynamicResource Loc.settings.bg.pickImage}" Style="{StaticResource SecondaryButton}"
                      Click="OnPickBgImage" />
              <Button x:Name="BgClearImageButton" Grid.Column="1" Content="{DynamicResource Loc.settings.bg.clearImage}"
                      Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                      VerticalAlignment="Center" Click="OnClearBgImage" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="BgImagePathText" Style="{StaticResource CaptionText}"
                       Margin="2,6,0,0" TextWrapping="Wrap" />
            <TextBlock Style="{StaticResource CaptionText}" Margin="2,4,0,0"
                       Text="{DynamicResource Loc.settings.bg.imageHint}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== 后台与遥控 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.settings.shell.title}" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.settings.shell.desc}" />

          <CheckBox x:Name="CloseToTraySwitch" Style="{StaticResource AppSwitch}"
                    Content="{DynamicResource Loc.settings.shell.closeToTray}"
                    Checked="OnShellSettingToggled" Unchecked="OnShellSettingToggled" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="52,5,0,0"
                     Text="{DynamicResource Loc.settings.shell.closeToTrayDesc}" />

          <CheckBox x:Name="NotifyStateSwitch" Style="{StaticResource AppSwitch}"
                     Content="{DynamicResource Loc.settings.shell.notify}" Margin="0,14,0,0"
                     Checked="OnShellSettingToggled" Unchecked="OnShellSettingToggled" />

          <CheckBox x:Name="RecordWatchdogSwitch" Style="{StaticResource AppSwitch}"
                     Content="{DynamicResource Loc.settings.shell.watchdog}"
                     Checked="OnShellSettingToggled" Unchecked="OnShellSettingToggled" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="52,5,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.settings.shell.watchdogDesc}" />

          <CheckBox x:Name="RealtimeLogAlertSwitch" Style="{StaticResource AppSwitch}"
                     Content="{DynamicResource Loc.settings.shell.logAlert}"
                     Checked="OnShellSettingToggled" Unchecked="OnShellSettingToggled" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="52,5,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.settings.shell.logAlertDesc}" />

          <Border Style="{StaticResource HLine}" Margin="0,16,0,0" />

          <TextBlock Text="{DynamicResource Loc.settings.hotkey.title}" FontWeight="SemiBold" Margin="0,0,0,10"
                     Foreground="{DynamicResource TextBrush}" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="2,0,0,12"
                     Text="{DynamicResource Loc.settings.hotkey.desc}" />

          <StackPanel Margin="0,0,0,12">
            <!-- 录制 -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{DynamicResource Loc.hotkey.record}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSizeSm}" />
              <CheckBox x:Name="RecHotkeyEnabled" Grid.Column="1" VerticalAlignment="Center"
                        ToolTip="{DynamicResource Loc.settings.hotkey.enableTip}" Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="RecHotkeyCtrl" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="RecHotkeyAlt" Grid.Column="3" Content="Alt" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="RecHotkeyShift" Grid.Column="4" Content="Shift" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="RecHotkeyWin" Grid.Column="5" Content="Win" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <TextBox x:Name="RecHotkeyKey" Grid.Column="6" Style="{StaticResource AppTextBox}"
                       MaxLength="4" TextChanged="OnHotkeyChanged" />
              <TextBlock x:Name="RecHotkeyDisplay" Grid.Column="7" VerticalAlignment="Center"
                         Style="{StaticResource CaptionText}" Margin="10,0,0,0" />
            </Grid>
            <!-- 推流 -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{DynamicResource Loc.hotkey.stream}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSizeSm}" />
              <CheckBox x:Name="StreamHotkeyEnabled" Grid.Column="1" VerticalAlignment="Center"
                        ToolTip="{DynamicResource Loc.settings.hotkey.enableTip}" Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="StreamHotkeyCtrl" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="StreamHotkeyAlt" Grid.Column="3" Content="Alt" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="StreamHotkeyShift" Grid.Column="4" Content="Shift" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="StreamHotkeyWin" Grid.Column="5" Content="Win" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <TextBox x:Name="StreamHotkeyKey" Grid.Column="6" Style="{StaticResource AppTextBox}"
                       MaxLength="4" TextChanged="OnHotkeyChanged" />
              <TextBlock x:Name="StreamHotkeyDisplay" Grid.Column="7" VerticalAlignment="Center"
                         Style="{StaticResource CaptionText}" Margin="10,0,0,0" />
            </Grid>
            <!-- 虚拟摄像头 -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{DynamicResource Loc.hotkey.virtualCam}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSizeSm}" />
              <CheckBox x:Name="VcamHotkeyEnabled" Grid.Column="1" VerticalAlignment="Center"
                        ToolTip="{DynamicResource Loc.settings.hotkey.enableTip}" Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="VcamHotkeyCtrl" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="VcamHotkeyAlt" Grid.Column="3" Content="Alt" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="VcamHotkeyShift" Grid.Column="4" Content="Shift" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="VcamHotkeyWin" Grid.Column="5" Content="Win" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <TextBox x:Name="VcamHotkeyKey" Grid.Column="6" Style="{StaticResource AppTextBox}"
                       MaxLength="4" TextChanged="OnHotkeyChanged" />
              <TextBlock x:Name="VcamHotkeyDisplay" Grid.Column="7" VerticalAlignment="Center"
                         Style="{StaticResource CaptionText}" Margin="10,0,0,0" />
            </Grid>
            <!-- 小窗控制 -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{DynamicResource Loc.hotkey.miniWindow}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSizeSm}" />
              <CheckBox x:Name="MiniHotkeyEnabled" Grid.Column="1" VerticalAlignment="Center"
                        ToolTip="{DynamicResource Loc.settings.hotkey.enableTip}" Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="MiniHotkeyCtrl" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="MiniHotkeyAlt" Grid.Column="3" Content="Alt" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="MiniHotkeyShift" Grid.Column="4" Content="Shift" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="MiniHotkeyWin" Grid.Column="5" Content="Win" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <TextBox x:Name="MiniHotkeyKey" Grid.Column="6" Style="{StaticResource AppTextBox}"
                       MaxLength="4" TextChanged="OnHotkeyChanged" />
              <TextBlock x:Name="MiniHotkeyDisplay" Grid.Column="7" VerticalAlignment="Center"
                         Style="{StaticResource CaptionText}" Margin="10,0,0,0" />
            </Grid>
            <!-- 显示/隐藏窗口 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="86" />
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="44" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{DynamicResource Loc.hotkey.toggleWindow}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSizeSm}" />
              <CheckBox x:Name="WinHotkeyEnabled" Grid.Column="1" VerticalAlignment="Center"
                        ToolTip="{DynamicResource Loc.settings.hotkey.enableTip}" Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="WinHotkeyCtrl" Grid.Column="2" Content="Ctrl" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="WinHotkeyAlt" Grid.Column="3" Content="Alt" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="WinHotkeyShift" Grid.Column="4" Content="Shift" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <CheckBox x:Name="WinHotkeyWin" Grid.Column="5" Content="Win" VerticalAlignment="Center"
                        Checked="OnHotkeyToggled" Unchecked="OnHotkeyToggled" />
              <TextBox x:Name="WinHotkeyKey" Grid.Column="6" Style="{StaticResource AppTextBox}"
                       MaxLength="4" TextChanged="OnHotkeyChanged" />
              <TextBlock x:Name="WinHotkeyDisplay" Grid.Column="7" VerticalAlignment="Center"
                         Style="{StaticResource CaptionText}" Margin="10,0,0,0" />
            </Grid>
          </StackPanel>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource Loc.settings.hotkey.save}" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Left" Click="OnSaveHotkeys" />
            <TextBlock x:Name="HotkeyStatusText" Grid.Column="1" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- ==================================================== 简单录像（V2.9.4） -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.settings.record.title}" Style="{StaticResource SectionTitle}" />

          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="{DynamicResource Loc.settings.record.preset}" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextBrush}" FontSize="{DynamicResource FontSizeSm}" />
            <ComboBox x:Name="SimplePresetBox" Style="{StaticResource AppComboBox}" Width="180"
                      Margin="10,0,0,0" VerticalAlignment="Center" SelectionChanged="OnSimplePresetChanged" />
          </StackPanel>
          <TextBlock Style="{StaticResource CaptionText}" Margin="2,6,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.settings.record.presetDesc}" />

          <CheckBox x:Name="SimpleAutoLaunchSwitch" Style="{StaticResource AppSwitch}"
                    Content="{DynamicResource Loc.settings.record.autoLaunch}" Margin="0,14,0,0"
                    Checked="OnSimpleAutoLaunchToggled" Unchecked="OnSimpleAutoLaunchToggled" />
          <TextBlock Style="{StaticResource CaptionText}" Margin="52,5,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.settings.record.autoLaunchDesc}" />
        </StackPanel>
      </Border>

      <!-- ==================================================== 场景自动切换 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.settings.autoSwitch.title}" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.settings.autoSwitch.desc}" />

          <CheckBox x:Name="AutoSwitchEnabled" Style="{StaticResource AppSwitch}"
                    Content="{DynamicResource Loc.settings.autoSwitch.enable}" Margin="0,0,0,12"
                    Checked="OnAutoSwitchToggled" Unchecked="OnAutoSwitchToggled" />

          <StackPanel x:Name="AutoSwitchRulesPanel" Margin="0,0,0,12" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="{DynamicResource Loc.settings.autoSwitch.addRule}" Style="{StaticResource SecondaryButton}"
                    HorizontalAlignment="Left" Click="OnAddAutoSwitchRule" />
            <TextBlock x:Name="AutoSwitchStatusText" Grid.Column="1" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
          </Grid>
          <TextBlock Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                     Text="{DynamicResource Loc.settings.autoSwitch.note}" />
        </StackPanel>
      </Border>

      <!-- ==================================================== 排障指引 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.settings.guide.title}" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.settings.guide.desc}" />

          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.settings.guide.openGuide}" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="OnOpenGuide" />
            <Button Content="{DynamicResource Loc.settings.guide.openLogs}" Style="{StaticResource SecondaryButton}" Click="OnOpenLogs" />
          </StackPanel>

          <Border Style="{StaticResource HLine}" />

          <TextBlock Text="{DynamicResource Loc.settings.data.title}" Style="{StaticResource MutedText}" Margin="0,0,0,4" />
          <TextBlock x:Name="DataSummaryText" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="ClearBookmarksButton" Content="{DynamicResource Loc.settings.data.clearBookmarks}"
                    Style="{StaticResource SecondaryButton}"
                    Foreground="{DynamicResource DangerBrush}"
                    Margin="0,0,10,0" Click="OnClearBookmarks" />
            <Button Content="{DynamicResource Loc.settings.data.resetSteps}" Style="{StaticResource SecondaryButton}"
                    Foreground="{DynamicResource DangerBrush}" Click="OnClearSteps" />
          </StackPanel>

          <TextBlock x:Name="DataStatusText" Style="{StaticResource MutedText}"
                     Margin="0,10,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- ==================================================== 新手引导（V2.9.0） -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.settings.onboarding.title}" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.settings.onboarding.desc}" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="ReplayOnboardingButton" Content="{DynamicResource Loc.settings.onboarding.replay}"
                    Style="{StaticResource PrimaryButton}" Click="OnReplayOnboarding" />
            <TextBlock x:Name="OnboardingStatusText" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="12,0,0,0" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== OBS 配置管理 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.settings.obsconfig.title}" Style="{StaticResource SectionTitle}" />
          <TextBlock x:Name="ObsConfigHintText" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.settings.obsconfig.detecting}" />

          <StackPanel Orientation="Horizontal">
            <Button Content="{DynamicResource Loc.settings.obsconfig.open}" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="OnOpenObsConfig" />
            <Button Content="{DynamicResource Loc.settings.obsconfig.templates}" Style="{StaticResource SecondaryButton}" Click="OnOpenTemplates" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== 关于 -->
      <Border Style="{StaticResource Card}">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.settings.about.title}" Style="{StaticResource SectionTitle}" />

          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource Loc.settings.about.appVersion}" Style="{StaticResource MutedText}"
                       Margin="0,0,16,6" />
            <TextBlock x:Name="AppVersionText" Grid.Row="0" Grid.Column="1" Text="—"
                       Style="{StaticResource BodyText}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource Loc.settings.about.kbVersion}" Style="{StaticResource MutedText}"
                       Margin="0,0,16,6" />
            <TextBlock x:Name="DataVersionText" Grid.Row="1" Grid.Column="1" Text="—"
                       Style="{StaticResource BodyText}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource Loc.settings.about.kbUpdated}" Style="{StaticResource MutedText}"
                       Margin="0,0,16,0" />
            <TextBlock x:Name="DataUpdatedText" Grid.Row="2" Grid.Column="1" Text="—"
                       Style="{StaticResource BodyText}" />
          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="CheckUpdateButton" Content="{DynamicResource Loc.settings.about.checkUpdate}" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" Click="OnCheckUpdate" />
            <Button x:Name="CheckKbButton" Content="{DynamicResource Loc.settings.about.checkKb}" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" Click="OnCheckKbUpdate" />
            <TextBlock x:Name="UpdateStatusText" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Text="{DynamicResource Loc.settings.about.notChecked}" />
          </StackPanel>
          <TextBlock x:Name="KbStatusText" Style="{StaticResource CaptionText}"
                     Margin="2,0,0,12" Text="—" />

          <TextBlock Style="{StaticResource MutedText}"
                     Text="{DynamicResource Loc.settings.about.privacy}" />

          <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                     Text="{DynamicResource Loc.settings.about.sanitized}" />

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="{DynamicResource Loc.settings.about.officialKb}" Style="{StaticResource LinkButton}"
                    Tag="https://obsproject.com/zh-cn/kb" Margin="0,0,16,0" Click="OnOpenLink" />
            <Button Content="{DynamicResource Loc.settings.about.officialAnalyzer}" Style="{StaticResource LinkButton}"
                    Tag="https://obsproject.com/analyzer" Click="OnOpenLink" />
          </StackPanel>

          <Border Style="{StaticResource HLine}" />

          <TextBlock Style="{StaticResource CaptionText}"
                     Text="{DynamicResource Loc.settings.about.copyright}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
