          { "name": "嘉宾名条", "inputKind": "text_gdiplus_v3", "zOrder": 4, "enabled": true,
            "fallbackKinds": ["text_ft2_source_v3"],
            "settings": { "text": "嘉宾", "font": { "face": "微软雅黑", "size": 40 }, "color": 4294967295 },
            "transform": { "posX": 970, "posY": 250, "boundsType": "OBS_BOUNDS_NONE", "alignment": 5 } },
