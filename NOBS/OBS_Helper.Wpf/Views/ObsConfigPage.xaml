<UserControl x:Class="OBS_Helper.Wpf.Views.ObsConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26" MaxWidth="760" HorizontalAlignment="Left">

      <!-- ======================================== OBS 配置位置 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="OBS 配置位置" Style="{StaticResource SectionTitle}" />
          <TextBlock x:Name="ConfigPathText" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="正在检测…" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="DetectButton" Content="🔍 自动检测" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" Click="OnDetectClick" />
            <Button Content="📂 手动指定" Style="{StaticResource GhostButton}" Click="OnManualPathClick" />
          </StackPanel>

          <TextBlock x:Name="ConfigDetailText" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- ======================================== 备份 / 导出 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="备份与导出" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="将当前 OBS 场景集合、配置文件打包为 ZIP。默认不包含推流密钥（密码也会脱敏），勾选后才会包含完整密钥信息。" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BackupButton" Content="📦 创建备份" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="OnCreateBackup" />
            <Button x:Name="ExportButton" Content="💾 导出到文件…" Style="{StaticResource SecondaryButton}"
                    Click="OnExportClick" />
          </StackPanel>

          <CheckBox x:Name="IncludeKeyCheck" Style="{StaticResource AppCheckBox}"
                    Content="包含推流密钥（导出包将可被用于完整恢复，注意保管）"
                    IsChecked="False" />

          <TextBlock x:Name="BackupListHint" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                     TextWrapping="Wrap" Visibility="Collapsed" />

          <StackPanel x:Name="BackupList" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- ======================================== 导入 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="导入配置" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="从之前导出的备份 ZIP 中恢复 OBS 配置。导入前会自动创建一份当前配置的备份，误操作可回滚。脱敏包（不含密钥）导入时会自动回填本机现有密钥。" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="ImportOverwriteButton" Content="📥 导入并覆盖" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="OnImportOverwrite" />
            <Button x:Name="ImportMergeButton" Content="📥 导入并合并" Style="{StaticResource SecondaryButton}"
                    Click="OnImportMerge" />
          </StackPanel>

          <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="覆盖：将配置完整替换为备份版本。合并：同名场景集合改为「(导入)」后缀，同名 profile 跳过不变。" />
        </StackPanel>
      </Border>

      <!-- ======================================== 重置 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="重置 OBS" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="两档重置都强制先自动备份。彻底重置会把 OBS 恢复到第一次安装时的空白状态，将删除所有场景、profile、插件设置。" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="LightResetButton" Content="🔄 轻度重置" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="OnLightReset" />
            <Button x:Name="FullResetButton" Content="⚠️ 彻底重置" Style="{StaticResource DangerButton}"
                    Click="OnFullReset" />
          </StackPanel>

          <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="轻度重置：在 OBS 运行时新建一个干净配置集合并切换过去（不删除任何东西）。彻底重置：需先完全退出 OBS，删除所有配置并重建空目录。" />
        </StackPanel>
      </Border>

      <!-- ======================================== 操作状态 -->
      <Border x:Name="ResultBar" Margin="0,0,0,16" Visibility="Collapsed"
              Background="{DynamicResource Surface2Brush}"
              CornerRadius="{DynamicResource CornerRadiusMd}" Padding="14,10">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ResultIcon" Text="ℹ️" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeLg}" Margin="0,0,8,0" />
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeSm}"
                       Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
          <TextBlock x:Name="ResultDetailText" Style="{StaticResource CaptionText}"
                     Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
