<UserControl x:Class="OBS_Helper.Wpf.Views.TimerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <!-- ==================================================== 计时控制 -->
      <Border Style="{StaticResource Card}" Padding="18">
        <StackPanel>
          <WrapPanel>
            <RadioButton x:Name="CountDownRadio" GroupName="TimerMode" Style="{StaticResource SegmentButton}"
                         Content="{DynamicResource Loc.timer.mode.countdown}" Checked="OnModeChecked"
                         AutomationProperties.Name="{DynamicResource Loc.timer.mode.countdown}" />
            <RadioButton x:Name="CountUpRadio" GroupName="TimerMode" Style="{StaticResource SegmentButton}"
                         Content="{DynamicResource Loc.timer.mode.countup}" Checked="OnModeChecked"
                         Margin="6,0,0,0" AutomationProperties.Name="{DynamicResource Loc.timer.mode.countup}" />
            <TextBlock Text="{DynamicResource Loc.timer.planned}" Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center" Margin="18,0,6,0" />
            <TextBox x:Name="DurationBox" Width="110" Style="{StaticResource AppTextBox}"
                     AutomationProperties.Name="{DynamicResource Loc.timer.planned}" />
            <Button x:Name="ApplyDurationButton" Style="{StaticResource SecondaryButton}"
                    Content="{DynamicResource Loc.timer.applyDuration}" Click="OnApplyDuration"
                    Margin="8,0,0,0" />
            <TextBlock x:Name="DurationHintText" Style="{StaticResource CaptionText}"
                       Margin="10,0,0,0" VerticalAlignment="Center" />
          </WrapPanel>

          <TextBlock x:Name="TimeText" Text="00:00" FontSize="76" FontFamily="Consolas"
                     FontWeight="SemiBold" Margin="0,14,0,0"
                     AutomationProperties.LiveSetting="Polite"
                     AutomationProperties.Name="{DynamicResource Loc.timer.timeName}" />
          <TextBlock x:Name="SecondaryText" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
          <TextBlock x:Name="StateText" Style="{StaticResource BodyText}" Margin="0,4,0,12" />

          <WrapPanel>
            <Button x:Name="StartPauseButton" Style="{StaticResource PrimaryButton}" MinWidth="110"
                    Content="{DynamicResource Loc.timer.action.start}" Click="OnStartPause"
                    AutomationProperties.Name="{DynamicResource Loc.timer.action.start}" />
            <Button x:Name="StopButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.timer.action.stop}" Click="OnStop" />
            <Button x:Name="ResetButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.timer.action.reset}" Click="OnReset" />
            <Button x:Name="ToggleWindowButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.timer.action.showWindow}" Click="OnToggleWindow" />
            <Button x:Name="NextScreenButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.timer.action.nextScreen}" Click="OnNextScreen" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== 计时窗设置 -->
      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8"
                 Text="{DynamicResource Loc.timer.settings.title}" />
      <Border Style="{StaticResource Card}" Padding="16">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,22,10">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.timer.setting.opacity}" />
              <Slider x:Name="OpacitySlider" Width="170" Minimum="0.2" Maximum="1" ValueChanged="OnOpacityChanged"
                      AutomationProperties.Name="{DynamicResource Loc.timer.setting.opacity}" />
            </StackPanel>
            <StackPanel Margin="0,0,22,10">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.timer.setting.fontScale}" />
              <Slider x:Name="FontScaleSlider" Width="170" Minimum="0.6" Maximum="3" ValueChanged="OnFontScaleChanged"
                      AutomationProperties.Name="{DynamicResource Loc.timer.setting.fontScale}" />
            </StackPanel>
          </WrapPanel>
          <WrapPanel>
            <CheckBox x:Name="ShowHoursCheck" Style="{StaticResource AppCheckBox}" Margin="0,0,18,8"
                      Content="{DynamicResource Loc.timer.setting.showHours}" Click="OnSettingChanged" />
            <CheckBox x:Name="ExcludeCaptureCheck" Style="{StaticResource AppCheckBox}" Margin="0,0,18,8"
                      Content="{DynamicResource Loc.timer.setting.excludeCapture}" Click="OnSettingChanged" />
            <CheckBox x:Name="ClickThroughCheck" Style="{StaticResource AppCheckBox}" Margin="0,0,18,8"
                      Content="{DynamicResource Loc.timer.setting.clickThrough}" Click="OnSettingChanged" />
          </WrapPanel>
          <WrapPanel>
            <CheckBox x:Name="AutoStartCheck" Style="{StaticResource AppCheckBox}" Margin="0,0,18,8"
                      Content="{DynamicResource Loc.timer.setting.autoStart}" Click="OnSettingChanged" />
            <CheckBox x:Name="AutoStopCheck" Style="{StaticResource AppCheckBox}" Margin="0,0,18,8"
                      Content="{DynamicResource Loc.timer.setting.autoStop}" Click="OnSettingChanged" />
            <CheckBox x:Name="SoundCheck" Style="{StaticResource AppCheckBox}" Margin="0,0,18,8"
                      Content="{DynamicResource Loc.timer.setting.sound}" Click="OnSettingChanged" />
            <CheckBox x:Name="TrayStatusCheck" Style="{StaticResource AppCheckBox}" Margin="0,0,18,8"
                      Content="{DynamicResource Loc.timer.setting.trayStatus}" Click="OnSettingChanged" />
          </WrapPanel>
          <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.timer.setting.hint}" />
        </StackPanel>
      </Border>

      <!-- ==================================================== 记录 -->
      <Grid Margin="0,18,0,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}"
                   Text="{DynamicResource Loc.timer.records.title}" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc.timer.action.copyTsv}"
                  Click="OnCopyTsv" Margin="0,0,8,0" />
          <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc.timer.action.copyCsv}"
                  Click="OnCopyCsv" Margin="0,0,8,0" />
          <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Loc.timer.action.clearRecords}"
                  Click="OnClearRecords" />
        </StackPanel>
      </Grid>
      <Border Style="{StaticResource Card}" Padding="12">
        <StackPanel>
          <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="42" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="86" />
              <ColumnDefinition Width="92" />
              <ColumnDefinition Width="92" />
              <ColumnDefinition Width="92" />
              <ColumnDefinition Width="44" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource CaptionText}" Text="#" />
            <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.timer.record.started}" />
            <TextBlock Grid.Column="2" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.timer.record.mode}" />
            <TextBlock Grid.Column="3" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.timer.record.planned}" />
            <TextBlock Grid.Column="4" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.timer.record.actual}" />
            <TextBlock Grid.Column="5" Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.timer.record.overtime}" />
          </Grid>
          <StackPanel x:Name="RecordsList" />
          <TextBlock x:Name="EmptyRecordsText" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                     Text="{DynamicResource Loc.timer.records.empty}" />
        </StackPanel>
      </Border>

      <!-- ==================================================== 浏览器叠加层 -->
      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8"
                 Text="{DynamicResource Loc.timer.overlay.title}" />
      <Border Style="{StaticResource Card}" Padding="16">
        <StackPanel>
          <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.timer.overlay.desc}" />
          <WrapPanel Margin="0,8,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc.timer.overlay.copy}"
                    Click="OnCopyOverlay" />
            <TextBlock x:Name="OverlayUrlText" Style="{StaticResource MonoText}" VerticalAlignment="Center"
                       Margin="10,0,0,0" TextWrapping="Wrap" />
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- ==================================================== 署名 -->
      <Border Style="{StaticResource SoftPanel}" Margin="0,16,0,0" Padding="12">
        <StackPanel>
          <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.timer.attribution.short}" />
          <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0"
                  Content="{DynamicResource Loc.timer.attribution.more}" Click="OnShowAttribution" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
