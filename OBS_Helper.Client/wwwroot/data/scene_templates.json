[
  {
    "id": "gaming",
    "title": "游戏直播",
    "summary": "游戏画面 + 摄像头 + 麦克风，横屏 1080p60 开播即用。",
    "icon": "🎮",
    "portrait": false,
    "notes": "游戏源默认按窗口 / 显示器捕获回退；摄像头与麦克风需你在 OBS 里选设备。",
    "canvas": { "baseWidth": 1920, "baseHeight": 1080, "outputWidth": 1920, "outputHeight": 1080, "fpsNumerator": 60, "fpsDenominator": 1 },
    "transition": "淡入淡出",
    "transitionDurationMs": 300,
    "scenes": [
      {
        "name": "游戏直播中",
        "transitionDurationMs": 300,
        "hotkey": "Ctrl+1",
        "sources": [
          { "name": "背景色", "inputKind": "color_source_v3", "zOrder": 0, "enabled": true,
            "settings": { "color": 4278190080 },
            "transform": { "posX": 0, "posY": 0, "boundsType": "OBS_BOUNDS_SCALE_OUTER", "boundsWidth": 1920, "boundsHeight": 1080, "alignment": 0 } },
          { "name": "游戏画面", "inputKind": "game_capture", "zOrder": 1, "enabled": true,
            "fallbackKinds": ["window_capture", "monitor_capture"],
            "placeholder": { "kind": "window", "hint": "选择要捕获的游戏窗口或显示器" },
            "transform": { "posX": 0, "posY": 0, "boundsType": "OBS_BOUNDS_SCALE_OUTER", "boundsWidth": 1920, "boundsHeight": 1080, "alignment": 0 } },
          { "name": "摄像头", "inputKind": "dshow_input", "zOrder": 2, "enabled": true,
            "fallbackKinds": ["dshow_video_source"],
            "placeholder": { "kind": "device", "hint": "选择你的摄像头设备" },
            "transform": { "posX": 1490, "posY": 835, "boundsType": "OBS_BOUNDS_TO_WIDTH", "boundsWidth": 400, "alignment": 5 } },
          { "name": "我的麦克风", "inputKind": "wasapi_input_capture", "zOrder": 3, "enabled": true, "shared": true,
            "placeholder": { "kind": "device", "hint": "选择你的麦克风" } },
          { "name": "桌面音频", "inputKind": "wasapi_output_capture", "zOrder": 4, "enabled": true,
            "placeholder": { "kind": "device", "hint": "选择桌面 / 系统声音" } },
          { "name": "直播标题", "inputKind": "text_gdiplus_v3", "zOrder": 5, "enabled": true,
            "fallbackKinds": ["text_ft2_source_v3"],
            "settings": { "text": "游戏直播中 · 欢迎来到直播间", "font": { "face": "微软雅黑", "size": 48 }, "color": 4294967295 },
            "transform": { "posX": 60, "posY": 40, "boundsType": "OBS_BOUNDS_NONE", "alignment": 5 } }
        ]
      },
      {
        "name": "暂停一下",
        "transitionDurationMs": 500,
        "hotkey": "Ctrl+2",
        "sources": [
          { "name": "背景色", "inputKind": "color_source_v3", "zOrder": 0, "enabled": true,
            "settings": { "color": 4278650880 },
            "transform": { "posX": 0, "posY": 0, "boundsType": "OBS_BOUNDS_SCALE_OUTER", "boundsWidth": 1920, "boundsHeight": 1080, "alignment": 0 } },
          { "name": "摄像头", "inputKind": "dshow_input", "zOrder": 1, "enabled": true, "shared": true,
            "fallbackKinds": ["dshow_video_source"],
            "placeholder": { "kind": "device", "hint": "选择你的摄像头设备" },
            "transform": { "posX": 760, "posY": 340, "boundsType": "OBS_BOUNDS_TO_WIDTH", "boundsWidth": 400, "alignment": 0 } },
          { "name": "我的麦克风", "inputKind": "wasapi_input_capture", "zOrder": 2, "enabled": true, "shared": true },
          { "name": "稍候片刻", "inputKind": "text_gdiplus_v3", "zOrder": 3, "enabled": true,
            "fallbackKinds": ["text_ft2_source_v3"],
            "settings": { "text": "稍候片刻，马上回来～", "font": { "face": "微软雅黑", "size": 72 }, "color": 4294967295 },
            "transform": { "posX": 960, "posY": 220, "boundsType": "OBS_BOUNDS_NONE", "alignment": 0 } }
        ]
      }
    ]
  },

  {
    "id": "vertical-selling",
    "title": "竖屏口播带货",
    "summary": "竖屏 1080×1920 口播场景，主摄像头填满，商品图 / 标题 / 口播词就位。",
    "icon": "📱",
    "portrait": true,
    "notes": "注意：本模板会把 OBS 全局画布改成 1080×1920（竖屏）。切回横屏直播时，请在 OBS「设置 → 视频」里把画布改回 1920×1080。",
    "canvas": { "baseWidth": 1080, "baseHeight": 1920, "outputWidth": 1080, "outputHeight": 1920, "fpsNumerator": 30, "fpsDenominator": 1 },
    "transition": "淡入淡出",
    "transitionDurationMs": 300,
    "scenes": [
      {
        "name": "口播主画面",
        "transitionDurationMs": 300,
        "hotkey": "Ctrl+1",
        "sources": [
          { "name": "背景色", "inputKind": "color_source_v3", "zOrder": 0, "enabled": true,
            "settings": { "color": 4292935679 },
            "transform": { "posX": 0, "posY": 0, "boundsType": "OBS_BOUNDS_SCALE_OUTER", "boundsWidth": 1080, "boundsHeight": 1920, "alignment": 0 } },
          { "name": "主摄像头", "inputKind": "dshow_input", "zOrder": 1, "enabled": true,
            "fallbackKinds": ["dshow_video_source"],
            "placeholder": { "kind": "device", "hint": "选择你的竖屏前置 / 外接摄像头" },
            "transform": { "posX": 540, "posY": 960, "boundsType": "OBS_BOUNDS_SCALE_OUTER", "boundsWidth": 1080, "boundsHeight": 1920, "alignment": 0 } },
          { "name": "商品图", "inputKind": "image_source", "zOrder": 2, "enabled": false,
            "settings": { "file": "" },
            "placeholder": { "kind": "file", "hint": "选择要展示的商品图片（默认隐藏，需要时点开）" },
            "transform": { "posX": 540, "posY": 960, "boundsType": "OBS_BOUNDS_SCALE_OUTER", "boundsWidth": 1080, "boundsHeight": 1920, "alignment": 0 } },
          { "name": "顶部条", "inputKind": "text_gdiplus_v3", "zOrder": 3, "enabled": true,
            "fallbackKinds": ["text_ft2_source_v3"],
            "settings": { "text": "🔥 限时福利进行中", "font": { "face": "微软雅黑", "size": 52 }, "color": 4294967295 },
            "transform": { "posX": 40, "posY": 60, "boundsType": "OBS_BOUNDS_NONE", "alignment": 5 } },
          { "name": "活动标题", "inputKind": "text_gdiplus_v3", "zOrder": 4, "enabled": true,
            "fallbackKinds": ["text_ft2_source_v3"],
            "settings": { "text": "今日爆款 · 点击左下小黄车", "font": { "face": "微软雅黑", "size": 64 }, "color": 4294967295 },
            "transform": { "posX": 540, "posY": 1680, "boundsType": "OBS_BOUNDS_NONE", "alignment": 0 } },
          { "name": "滚动口播词", "inputKind": "text_gdiplus_v3", "zOrder": 5, "enabled": true,
            "fallbackKinds": ["text_ft2_source_v3"],
            "settings": { "text": "关注主播不迷路 · 下单立享优惠", "font": { "face": "微软雅黑", "size": 44 }, "color": 4294967295 },
            "transform": { "posX": 540, "posY": 1780, "boundsType": "OBS_BOUNDS_NONE", "alignment": 0 } },
          { "name": "我的麦克风", "inputKind": "wasapi_input_capture", "zOrder": 6, "enabled": true, "shared": true,
            "placeholder": { "kind": "device", "hint": "选择你的麦克风" } }
        ]
      },
      {
        "name": "等待开播",
        "transitionDurationMs": 500,
        "hotkey": "Ctrl+2",
        "sources": [
          { "name": "背景色", "inputKind": "color_source_v3", "zOrder": 0, "enabled": true,
            "settings": { "color": 4278650880 },
            "transform": { "posX": 0, "posY": 0, "boundsType": "OBS_BOUNDS_SCALE_OUTER", "boundsWidth": 1080, "boundsHeight": 1920, "alignment": 0 } },
          { "name": "主摄像头", "inputKind": "dshow_input", "zOrder": 1, "enabled": true, "shared": true,
            "fallbackKinds": ["dshow_video_source"],
            "placeholder": { "kind": "device", "hint": "选择你的摄像头设备" },
            "transform": { "posX": 540, "posY": 760, "boundsType": "OBS_BOUNDS_TO_WIDTH", "boundsWidth": 700, "alignment": 0 } },
          { "name": "我的麦克风", "inputKind": "wasapi_input_capture", "zOrder": 2, "enabled": true, "shared": true },
          { "name": "马上开播", "inputKind": "text_gdiplus_v3", "zOrder": 3, "enabled": true,
            "fallbackKinds": ["text_ft2_source_v3"],
            "settings": { "text": "马上开播，先关注一波～", "font": { "face": "微软雅黑", "size": 60 }, "color": 4294967295 },
            "transform": { "posX": 540, "posY": 1500, "boundsType": "OBS_BOUNDS_NONE", "alignment": 0 } }
        ]
      }
    ]
  },

  {
