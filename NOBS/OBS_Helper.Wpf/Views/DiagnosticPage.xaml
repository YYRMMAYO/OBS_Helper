<UserControl x:Class="OBS_Helper.Wpf.Views.DiagnosticPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <TextBlock Style="{StaticResource MutedText}"
                 Text="{DynamicResource Loc.diagnostic.intro}" />

      <!--
        开播前体检（V3.0 / D4 后半段）：把黑屏体检 / 编码顾问 / 带宽 / 磁盘测速 / 节点延迟
        合成**一个结论**。推流参数只给建议；录制档位可一键落地（走既有的备份 + 回滚路径）。
      -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.machine.title}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.machine.desc}" />

          <WrapPanel>
            <Button x:Name="MachineRunButton" Content="{DynamicResource Loc.machine.run}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnRunMachineProfile" />
            <Button x:Name="MachineApplyButton" Content="{DynamicResource Loc.machine.applyPreset}"
                    Style="{StaticResource PrimaryButton}" Visibility="Collapsed" Click="OnApplySuggestedPreset" />
          </WrapPanel>

          <TextBlock x:Name="MachineConclusionText" Style="{StaticResource BodyText}" Margin="0,10,0,0"
                     TextWrapping="Wrap" Text="{DynamicResource Loc.machine.empty}" />

          <StackPanel x:Name="MachineItemsPanel" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <!-- ============================================ 智能诊断 -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.page.diagnostic.title}" />

          <!-- 引擎与已载入日志报告的提示，进入页面时重新计算 -->
          <TextBlock x:Name="EngineText" Style="{StaticResource MutedText}" />

          <!-- 云端没配好 / 没连 OBS 都属于可预期状态：页面内提示 + 跳转，不弹全局错误框 -->
          <WrapPanel x:Name="CloudHintPanel" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBlock x:Name="CloudHintText" Style="{StaticResource MutedText}"
                       VerticalAlignment="Center" />
            <Button Content="{DynamicResource Loc.diagnostic.goAiSettings}" Style="{StaticResource LinkButton}"
                    Margin="8,0,0,0" VerticalAlignment="Center" Click="OnOpenSettings" />
          </WrapPanel>

          <WrapPanel x:Name="ObsHintPanel" Margin="0,6,0,0" Visibility="Collapsed">
            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                       Text="{DynamicResource Loc.diagnostic.offline}" />
            <Button Content="{DynamicResource Loc.diagnostic.openConsole}" Style="{StaticResource LinkButton}"
                    Margin="8,0,0,0" VerticalAlignment="Center" Click="OnOpenConsole" />
          </WrapPanel>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="QueryBox" Grid.Column="0"
                     Style="{StaticResource AppTextBox}"
                     Tag="{DynamicResource Loc.diagnostic.placeholder}" />

            <Button x:Name="DiagnoseButton" Grid.Column="1" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}"
                    Content="{DynamicResource Loc.diagnostic.run}" Click="OnDiagnose" />
          </Grid>

          <!-- 云端一次问答可能几十秒，必须给明确的忙碌态 -->
          <TextBlock x:Name="BusyText" Margin="0,10,0,0"
                     Style="{StaticResource MutedText}" Visibility="Collapsed"
                     Text="{DynamicResource Loc.diagnostic.analyzing}" />

          <StackPanel x:Name="ResultPanel" Margin="0,12,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ErrorText" Visibility="Collapsed" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeSm}"
                       Foreground="{DynamicResource DangerBrush}" />

            <TextBlock x:Name="FallbackText" Margin="0,4,0,0" Visibility="Collapsed"
                       Style="{StaticResource MutedText}" />

            <Border x:Name="SummaryPanel" Style="{StaticResource SoftPanel}"
                    Margin="0,8,0,0" Visibility="Collapsed">
              <TextBlock x:Name="SummaryText" Style="{StaticResource MonoText}"
                         TextWrapping="Wrap" />
            </Border>

            <StackPanel x:Name="ItemList" Margin="0,10,0,0" />

            <Button x:Name="ExportButton" Content="{DynamicResource Loc.diagnostic.export}"
                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                    Margin="0,12,0,0" IsEnabled="False" Click="OnExportReport" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <Button Content="{DynamicResource Loc.diagnostic.openLogs}" Style="{StaticResource LinkButton}"
                    Margin="0,0,18,0" Click="OnOpenLogs" />
            <Button Content="{DynamicResource Loc.diagnostic.aiSettings}" Style="{StaticResource LinkButton}"
                    Click="OnOpenSettings" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- ============================================ 录前自检（C1，只读） -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.diagnostic.preflight}" />
            <Button x:Name="PreflightButton" Grid.Column="1" Style="{StaticResource SecondaryButton}"
                    VerticalAlignment="Center" Content="{DynamicResource Loc.diagnostic.preflight.run}" Click="OnPreflightRun" />
          </Grid>

          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.diagnostic.preflight.desc}" />

          <StackPanel x:Name="PreflightList" Margin="0,10,0,0" />
        </StackPanel>
      </Border>

      <!-- ============================================ 快速自检清单 -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.diagnostic.checklist}" />

          <ProgressBar x:Name="CheckProgress" Style="{StaticResource AppProgressBar}"
                       Minimum="0" Maximum="100" Value="0" />

          <TextBlock x:Name="CheckCountText" Style="{StaticResource MutedText}"
                     Margin="0,8,0,0" />

          <StackPanel x:Name="CheckList" Margin="0,12,0,0" />

          <!--
            V3.0（D4）：按本机实测回填。
            这 8 条里有 6~7 条本机就能判定，此前却全靠用户自己勾（等于把可自动化的排查手工化）。
          -->
          <WrapPanel Margin="0,8,0,0">
            <Button x:Name="AutoFillChecksButton" Content="{DynamicResource Loc.check.auto.button}"
                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnAutoFillChecks" />
            <Button Content="{DynamicResource Loc.diagnostic.checklist.reset}" Style="{StaticResource GhostButton}"
                    Click="OnResetChecks" />
          </WrapPanel>

          <TextBlock x:Name="AutoFillNoteText" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                     TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- ============================================ Windows 配置与日志 -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.diagnostic.windows}" />

          <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6">
            <Run FontWeight="Bold" Text="{DynamicResource Loc.diagnostic.configDir}" /><Run
                 FontFamily="Cascadia Mono, Consolas, Courier New" Text="%AppData%\obs-studio" />
          </TextBlock>

          <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,6">
            <Run FontWeight="Bold" Text="{DynamicResource Loc.diagnostic.sceneBackup}" /><Run
                 FontFamily="Cascadia Mono, Consolas, Courier New"
                 Text="%AppData%\obs-studio\sceneCollections" />
          </TextBlock>

          <WrapPanel Margin="0,0,0,6">
            <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center">
              <Run FontWeight="Bold" Text="{DynamicResource Loc.diagnostic.logAnalysis}" /><Run
                   Text="{DynamicResource Loc.diagnostic.logHint}" />
            </TextBlock>
            <Button Content="{DynamicResource Loc.diagnostic.officialAnalyzer}" Style="{StaticResource LinkButton}"
                    Margin="6,0,0,0" VerticalAlignment="Center" Click="OnOpenAnalyzer" />
          </WrapPanel>

          <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                     Text="{DynamicResource Loc.diagnostic.logHint2}" />
        </StackPanel>
      </Border>

      <!-- ============================================ 关于 macOS 端 -->
      <Border Style="{StaticResource Card}" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource Loc.diagnostic.macos}" />

          <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,8">
            <Run Text="{DynamicResource Loc.diagnostic.macos.desc1}" /><Run
                 FontWeight="Bold" Text="{DynamicResource Loc.diagnostic.macos.desc2}" /><Run Text="{DynamicResource Loc.diagnostic.macos.desc3}" />
          </TextBlock>

          <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4">
            <Run FontWeight="Bold" Text="{DynamicResource Loc.diagnostic.macos.screen}" /><Run Text="{DynamicResource Loc.diagnostic.macos.screenDesc}" />
          </TextBlock>
          <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4">
            <Run FontWeight="Bold" Text="{DynamicResource Loc.diagnostic.macos.mic}" /><Run Text="{DynamicResource Loc.diagnostic.macos.micDesc}" />
          </TextBlock>
          <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4">
            <Run FontWeight="Bold" Text="{DynamicResource Loc.diagnostic.macos.camera}" /><Run Text="{DynamicResource Loc.diagnostic.macos.cameraDesc}" />
          </TextBlock>
          <TextBlock Style="{StaticResource BodyText}" Margin="0,0,0,4">
            <Run FontWeight="Bold" Text="{DynamicResource Loc.diagnostic.macos.a11y}" /><Run Text="{DynamicResource Loc.diagnostic.macos.a11yDesc}" />
          </TextBlock>

          <TextBlock Style="{StaticResource MutedText}" Margin="0,8,0,0"
                     Text="{DynamicResource Loc.diagnostic.macos.encoder}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
