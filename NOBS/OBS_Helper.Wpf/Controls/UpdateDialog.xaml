<Window x:Class="OBS_Helper.Wpf.Controls.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:OBS_Helper.Wpf.Services"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="440"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusLg}"
          Padding="22,20"
          Margin="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#000000" />
    </Border.Effect>

    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="🎉" FontSize="18" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock x:Name="TitleText" Text="发现新版本"
                   FontSize="{DynamicResource FontSizeMd}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock TextWrapping="Wrap"
                 FontSize="{DynamicResource FontSizeBase}"
                 Foreground="{DynamicResource TextBrush}"
                 LineHeight="21">
        <Run x:Name="CurrentRun" Text="当前版本 1.2.0" />&#x0a;<Run x:Name="LatestRun" Text="最新版本 V1.3.0" FontWeight="SemiBold" />
      </TextBlock>

      <Border Background="{DynamicResource OkSoftBrush}"
              CornerRadius="{DynamicResource CornerRadiusMd}"
              Padding="12,10" Margin="0,14,0,0">
        <StackPanel>
          <TextBlock Text="下载方式"
                     FontSize="{DynamicResource FontSizeXs}"
                     Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4" />

          <!-- 方式一：蓝奏云网盘（浏览器打开） -->
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeBase}"
                     Foreground="{DynamicResource TextBrush}" LineHeight="21">
            <Run Text="方式一 · 蓝奏云网盘：" />&#x0a;<Hyperlink x:Name="DownloadLink"
             NavigateUri="{x:Static services:UpdateService.DownloadUrl}"
             Foreground="{DynamicResource OkBrush}">https://wwbpq.lanzouu.com/b01d7578be</Hyperlink>
          </TextBlock>
          <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <TextBlock Text="网盘更新密码：" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeBase}"
                       Foreground="{DynamicResource TextBrush}" />
            <Border Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource OkBrush}" BorderThickness="1"
                    CornerRadius="{DynamicResource CornerRadiusSm}" Padding="8,2" Margin="6,0,0,0">
              <TextBlock x:Name="PasswordText" Text="YYKWY"
                         FontSize="{DynamicResource FontSizeMd}" FontWeight="Bold"
                         Foreground="{DynamicResource OkBrush}"
                         TextAlignment="Center" MinWidth="64" />
            </Border>
          </StackPanel>

          <Border Style="{StaticResource HLine}" Margin="0,12,0,10" />

          <!-- 方式二：应用内加载 GitHub（应用内直接下载最新版并启动安装） -->
          <TextBlock Text="方式二 · 应用内加载 GitHub"
                     FontSize="{DynamicResource FontSizeBase}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextBrush}" />
          <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource FontSizeSm}"
                     Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,8" LineHeight="20">
            在应用内直接从 GitHub 仓库下载最新版安装包（不用开浏览器），下载完成后自动启动安装程序。
          </TextBlock>

          <Button x:Name="GithubDownloadButton" Style="{StaticResource SecondaryButton}"
                  Content="应用内加载 GitHub 下载" HorizontalAlignment="Left"
                  MinWidth="180" Click="OnDownloadGithub" />

          <StackPanel x:Name="GithubProgressPanel" Visibility="Collapsed" Margin="0,10,0,0">
            <ProgressBar x:Name="GithubProgressBar" Style="{StaticResource AppProgressBar}"
                         Minimum="0" Maximum="100" Value="0" />
            <TextBlock x:Name="GithubStatusText" TextWrapping="Wrap"
                       FontSize="{DynamicResource FontSizeSm}"
                       Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource CaptionText}" Margin="2,8,0,0"
                 Text="进入链接后输入上方密码即可下载安装包。也可以直接去 GitHub 仓库查看发布说明。" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="RepoButton" Style="{StaticResource GhostButton}"
                Content="GitHub 仓库" MinWidth="96" Margin="0,0,10,0"
                Click="OnOpenRepo" />
        <Button x:Name="LaterButton" Style="{StaticResource SecondaryButton}"
                Content="稍后再说" MinWidth="96" Margin="0,0,10,0"
                IsCancel="True" Click="OnLater" />
        <Button x:Name="DownloadButton" Style="{StaticResource PrimaryButton}"
                Content="去下载" MinWidth="96"
                IsDefault="True" Click="OnDownload" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
