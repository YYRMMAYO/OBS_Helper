<UserControl x:Class="OBS_Helper.Wpf.Views.ObsConfigPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26" MaxWidth="760" HorizontalAlignment="Left">

      <!-- ======================================== OBS 配置位置 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.obsconfig.locationTitle}" Style="{StaticResource SectionTitle}" />
          <TextBlock x:Name="ConfigPathText" Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.obsconfig.detecting}" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="DetectButton" Content="{DynamicResource Loc.obsconfig.detectButton}" Style="{StaticResource SecondaryButton}"
                    Margin="0,0,10,0" Click="OnDetectClick" />
            <Button Content="{DynamicResource Loc.obsconfig.manualButton}" Style="{StaticResource GhostButton}" Click="OnManualPathClick" />
          </StackPanel>

          <TextBlock x:Name="ConfigDetailText" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- ======================================== 备份 / 导出 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.obsconfig.backupTitle}" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.obsconfig.backupDesc}" />

          <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BackupButton" Content="{DynamicResource Loc.obsconfig.backupButton}" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="OnCreateBackup" />
            <Button x:Name="ExportButton" Content="{DynamicResource Loc.obsconfig.exportButton}" Style="{StaticResource SecondaryButton}"
                    Click="OnExportClick" />
          </StackPanel>

          <CheckBox x:Name="IncludeKeyCheck" Style="{StaticResource AppCheckBox}"
                    Content="{DynamicResource Loc.obsconfig.includeKey}"
                    IsChecked="False" />

          <TextBlock x:Name="BackupListHint" Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                     TextWrapping="Wrap" Visibility="Collapsed" />

          <StackPanel x:Name="BackupList" Margin="0,8,0,0" Visibility="Collapsed" />
        </StackPanel>
      </Border>

      <!-- ======================================== 导入 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.obsconfig.importTitle}" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.obsconfig.importDesc}" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="ImportOverwriteButton" Content="{DynamicResource Loc.obsconfig.importOverwriteButton}" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="OnImportOverwrite" />
            <Button x:Name="ImportMergeButton" Content="{DynamicResource Loc.obsconfig.importMergeButton}" Style="{StaticResource SecondaryButton}"
                    Click="OnImportMerge" />
          </StackPanel>

          <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.obsconfig.importNote}" />
        </StackPanel>
      </Border>

      <!-- ======================================== 重置 -->
      <Border Style="{StaticResource Card}" Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="{DynamicResource Loc.obsconfig.resetTitle}" Style="{StaticResource SectionTitle}" />
          <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,12"
                     Text="{DynamicResource Loc.obsconfig.resetDesc}" />

          <StackPanel Orientation="Horizontal">
            <Button x:Name="LightResetButton" Content="{DynamicResource Loc.obsconfig.lightResetButton}" Style="{StaticResource PrimaryButton}"
                    Margin="0,0,10,0" Click="OnLightReset" />
            <Button x:Name="FullResetButton" Content="{DynamicResource Loc.obsconfig.fullResetButton}" Style="{StaticResource DangerButton}"
                    Click="OnFullReset" />
          </StackPanel>

          <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.obsconfig.resetNote}" />
        </StackPanel>
      </Border>

      <!-- ======================================== 操作状态 -->
      <Border x:Name="ResultBar" Margin="0,0,0,16" Visibility="Collapsed"
              Background="{DynamicResource Surface2Brush}"
              CornerRadius="{DynamicResource CornerRadiusMd}" Padding="14,10">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="ResultIcon" Text="" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeLg}" Margin="0,0,8,0" />
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" VerticalAlignment="Center"
                       FontSize="{DynamicResource FontSizeSm}"
                       Foreground="{DynamicResource TextBrush}" />
          </StackPanel>
          <TextBlock x:Name="ResultDetailText" Style="{StaticResource CaptionText}"
                     Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
