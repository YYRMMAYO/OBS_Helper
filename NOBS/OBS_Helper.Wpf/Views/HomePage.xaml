<UserControl x:Class="OBS_Helper.Wpf.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">

  <!--
    首页 = 快捷入口 + 简单录像 + 分类九宫格 + 我的收藏。
    页面大标题由 MainWindow 顶栏负责，这里不再重复，只保留原版 hero 里的两个入口按钮。
  -->
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <!-- 快捷入口：对应原版 hero 里的「搜索问题 / 问我一下」 -->
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc.home.action.search}"
                Margin="0,0,10,0" Click="OnSearchClick" />
        <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc.home.action.ask}"
                Margin="0,0,10,0" Click="OnAssistantClick" />
        <!--
          「反馈」放在首页快捷入口（V2.9.4）：V2.9.3 只在工具箱 / 搭建页底部有反馈卡，
          要反馈的用户得先猜到它在哪一页 —— 那等于没有入口。
        -->
        <Button Style="{StaticResource GhostButton}" Content="{DynamicResource Loc.nav.feedback}"
                Click="OnFeedbackClick" />
      </StackPanel>

      <!--
        简单录像（V2.9.4）：放在首页而不是只留在「搭建」页 ——
        「我就想录个像」是最常见的进入意图，不该先让人翻三个页面找入口。
      -->
      <ctl:SimpleRecordCard x:Name="SimpleRecord" Margin="0,14,0,0" />

      <!-- 新手引导：未连 OBS 时显示，连接后由代码隐藏（P1） -->
      <Border x:Name="WelcomeCard" Style="{StaticResource Card}" Margin="0,14,0,0"
              Background="{DynamicResource BrandSoftBrush}"
              BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1,1,1,1"
              Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="{DynamicResource Loc.home.welcome.title}" Style="{StaticResource H3Text}"
                       Foreground="{DynamicResource BrandBrush}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="{DynamicResource Loc.home.welcome.desc}" />
            <!--
              获取官方 OBS（V2.9.1）：这张卡只在「未连上 OBS」时出现，正好覆盖
              「机器上还没有 OBS / 装到了下载站的仿冒包」这类用户，给两条官方入口。
            -->
            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
              <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                         Text="{DynamicResource Loc.home.obsMissing.title}" />
              <Button Content="{DynamicResource Loc.obs.officialPage}" Style="{StaticResource LinkButton}"
                      Margin="6,0,0,0" Click="OnOpenObsDownload" />
              <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                         Text="·" Margin="5,0,0,0" />
              <Button Content="{DynamicResource Loc.obs.githubPage}" Style="{StaticResource LinkButton}"
                      Margin="5,0,0,0" Click="OnOpenObsGitHub" />
              <TextBlock Style="{StaticResource CaptionText}" VerticalAlignment="Center"
                         Text="{DynamicResource Loc.home.obsMissing.hint}" Margin="5,0,0,0" />
            </StackPanel>
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                  VerticalAlignment="Center" Margin="12,0,0,0" Click="OnConnectGuideClick">
            <StackPanel Orientation="Horizontal">
              <Image Width="14" Height="14" Source="{StaticResource IconConnect}"
                     VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="{DynamicResource Loc.home.goConsole}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- 数据加载失败时的提示（带报错码，便于用户反馈） -->
      <Border x:Name="LoadErrorPanel" Style="{StaticResource SoftPanel}"
              Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock x:Name="LoadErrorText" Style="{StaticResource BodyText}"
                   Foreground="{DynamicResource DangerBrush}" />
      </Border>

      <TextBlock Text="{DynamicResource Loc.home.categories}" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

      <!--
        分类卡用 ItemsControl + DataTemplate：卡片结构固定、只有数据不同，
        写模板比在 code-behind 里手搭控件树更清爽，也能让颜色继续走 DynamicResource。
      -->
      <ItemsControl x:Name="CategoryList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource CardButton}" Margin="0,0,12,12"
                    Tag="{Binding Id}" Click="OnCategoryClick"
                    ToolTip="{Binding Description}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                  分类图标芯片（P2-1 语义色）：去掉原 4px 彩色竖条（craft-floor 禁用卡片左侧彩色描边），
                  改为圆角色块 + 图标，语义色以「色块底 + 数量文字」双重编码，深浅主题均清晰。
                -->
                <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0"
                      VerticalAlignment="Top">
                  <Border Background="{Binding Semantic, Converter={StaticResource SemanticBrush}}"
                          CornerRadius="12" Opacity="0.16" />
                  <TextBlock Text="{Binding Icon}" FontSize="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" Margin="0,1,0,0"
                             FontWeight="SemiBold"
                             FontSize="{DynamicResource FontSizeMd}"
                             Foreground="{DynamicResource TextBrush}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Description}" Margin="0,3,0,0"
                             Style="{StaticResource CaptionText}" />
                  <TextBlock Text="{Binding CountText}" Margin="0,6,0,0"
                             FontWeight="SemiBold"
                             FontSize="{DynamicResource FontSizeXs}"
                             Foreground="{Binding Semantic, Converter={StaticResource SemanticBrush}}" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 我的收藏：没有收藏时整块隐藏（与原版一致） -->
      <StackPanel x:Name="BookmarkSection" Visibility="Collapsed">
        <TextBlock Text="{DynamicResource Loc.home.bookmarks}" Style="{StaticResource SectionTitle}" Margin="0,14,0,10" />
        <StackPanel x:Name="BookmarkList" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
