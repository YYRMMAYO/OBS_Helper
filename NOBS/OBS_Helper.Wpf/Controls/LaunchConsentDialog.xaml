<Window x:Class="OBS_Helper.Wpf.Controls.LaunchConsentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="Height"
        Width="460"
        WindowStartupLocation="CenterOwner">
  <Border Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1"
          CornerRadius="{DynamicResource CornerRadiusLg}"
          Padding="22,20"
          Margin="12">
    <Border.Effect>
      <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.22" Color="#000000" />
    </Border.Effect>

    <StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
        <TextBlock Text="🎬" FontSize="18" VerticalAlignment="Center" Margin="0,0,9,0" />
        <TextBlock x:Name="TitleText" FontSize="{DynamicResource FontSizeMd}" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
      </StackPanel>

      <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                 FontSize="{DynamicResource FontSizeBase}"
                 Foreground="{DynamicResource MutedBrush}" />

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
        <Button x:Name="DenyButton" Style="{StaticResource GhostButton}" MinWidth="92" Margin="0,0,10,0"
                Click="OnDeny" />
        <Button x:Name="AskButton" Style="{StaticResource SecondaryButton}" MinWidth="92" Margin="0,0,10,0"
                Click="OnAsk" />
        <Button x:Name="AllowButton" Style="{StaticResource PrimaryButton}" MinWidth="120"
                IsDefault="True" Click="OnAllow" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
