<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options">

  <!--
    品牌矢量图标（P3「品牌标识仅 OB」）。
    由 品牌图标/*.svg 转换而来：统一 viewBox 0 0 24 24、描边 2、圆头圆角，
    状态色沿用调色板语义（危险红 / 品牌紫 / 正常绿），与界面状态色一致。
  -->

  <!-- 录制状态：危险红实心圆（icon-record.svg） -->
  <DrawingImage x:Key="IconRecord" PresentationOptions:Freeze="True">
    <DrawingImage.Drawing>
      <GeometryDrawing Brush="#d92d20">
        <GeometryDrawing.Geometry>
          <EllipseGeometry Center="12,12" RadiusX="7" RadiusY="7" />
        </GeometryDrawing.Geometry>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- 推流状态：信号弧（icon-stream.svg）。
       【v2.7.1】原硬编码品牌紫 #7b2ff7 在用户切换强调色后成为残留；
       Freezable 不支持 DynamicResource，改用与任何强调色都不冲突的中性信息蓝。 -->
  <DrawingImage x:Key="IconStream" PresentationOptions:Freeze="True">
    <DrawingImage.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="#3d82d6">
          <GeometryDrawing.Geometry>
            <EllipseGeometry Center="12,12" RadiusX="2.5" RadiusY="2.5" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="M 7.5,7.5 A 7,7 0 0 0 7.5,16.5 M 16.5,7.5 A 7,7 0 0 1 16.5,16.5 M 5,5 A 11,11 0 0 0 5,19 M 19,5 A 11,11 0 0 1 19,19">
          <GeometryDrawing.Pen>
            <Pen Brush="#3d82d6" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- 已连接 OBS：正常绿插头（icon-connect.svg） -->
  <DrawingImage x:Key="IconConnect" PresentationOptions:Freeze="True">
    <DrawingImage.Drawing>
      <GeometryDrawing Geometry="M 9,12 a 3,3 0 0 1 3,-3 h 2 a 3,3 0 0 1 0,6 h -2 a 3,3 0 0 1 -3,-3 z">
        <GeometryDrawing.Pen>
          <Pen Brush="#067647" Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" />
        </GeometryDrawing.Pen>
      </GeometryDrawing>
    </DrawingImage.Drawing>
  </DrawingImage>

  <!-- ============================================================
    【UI 优化 v1.10】侧边导航矢量图标（24×24 统一描边 1.8、圆头圆角）。
    与 emoji 不同：同一套 stroke 风格、颜色跟随主题与选中态
    （Path.Stroke 绑 DynamicResource，选中触发器换品牌色）。
    几何数据来自 Material Symbols / Lucide 同款手写路径，许可兼容（Apache/MIT）。
    ============================================================ -->

  <!-- 首页：房子 -->
  <StreamGeometry x:Key="IconGeomHome" PresentationOptions:Freeze="True">
    M4,11 L12,4 L20,11 M6,9.5 V20 H18 V9.5 M9.5,20 V14 H14.5 V20
  </StreamGeometry>

  <!-- 搜索：放大镜 -->
  <StreamGeometry x:Key="IconGeomSearch" PresentationOptions:Freeze="True">
    M10.5,10.5 m-4.5,0 a4.5,4.5 0 1 0 9,0 a4.5,4.5 0 1 0 -9,0 M14,14 L19,19
  </StreamGeometry>

  <!-- 助手：聊天气泡 -->
  <StreamGeometry x:Key="IconGeomAssistant" PresentationOptions:Freeze="True">
    M6,5 h12 a2,2 0 0 1 2,2 v7 a2,2 0 0 1 -2,2 h-7 l-5,4 v-4 a2,2 0 0 1 -2,-2 v-7 a2,2 0 0 1 2,-2 z M9,9.5 h6 M9,12.5 h4
  </StreamGeometry>

  <!-- 诊断：心跳脉冲线 -->
  <StreamGeometry x:Key="IconGeomDiagnostic" PresentationOptions:Freeze="True">
    M3,12 h4 l2,-5 l3,10 l2,-5 h7
  </StreamGeometry>

  <!-- 搭建：加号圆（构建 / 新增） -->
  <StreamGeometry x:Key="IconGeomSetup" PresentationOptions:Freeze="True">
    M12,12 m-8,0 a8,8 0 1 0 16,0 a8,8 0 1 0 -16,0 M12,8.5 V15.5 M8.5,12 H15.5
  </StreamGeometry>

  <!-- 模板：三层堆叠 -->
  <StreamGeometry x:Key="IconGeomTemplates" PresentationOptions:Freeze="True">
    M12,4 L20,8.5 L12,13 L4,8.5 Z M4,12 L12,16.5 L20,12 M4,15.5 L12,20 L20,15.5
  </StreamGeometry>

  <!-- 插件：拼图块 -->
  <StreamGeometry x:Key="IconGeomPlugins" PresentationOptions:Freeze="True">
    M5,10 H8 A2.5,2.5 0 0 1 13,10 H19 V12 A2.5,2.5 0 0 1 19,17 V20 H5 Z
  </StreamGeometry>

  <!-- 虚拟直播（V3.3.0）：星芒 + 小星，表示「形象 / 开播」 -->
  <StreamGeometry x:Key="IconGeomVirtualLive" PresentationOptions:Freeze="True">
    M10,4 L11.6,8.4 L16,10 L11.6,11.6 L10,16 L8.4,11.6 L4,10 L8.4,8.4 Z M17.5,14 L18.3,16.2 L20.5,17 L18.3,17.8 L17.5,20 L16.7,17.8 L14.5,17 L16.7,16.2 Z
  </StreamGeometry>

  <!-- 控制台：显示器 -->
  <StreamGeometry x:Key="IconGeomConsole" PresentationOptions:Freeze="True">
    M4,5 H20 V16 H4 Z M9,20 H15 M12,16 V20
  </StreamGeometry>

  <!-- 监控：仪表盘 -->
  <StreamGeometry x:Key="IconGeomPerformance" PresentationOptions:Freeze="True">
    M4,15 a8,8 0 0 1 16,0 M12,13 L15.5,15.5 M12,13 m-1.2,0 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0
  </StreamGeometry>

  <!-- 指引：打开的书 -->
  <StreamGeometry x:Key="IconGeomGuide" PresentationOptions:Freeze="True">
    M5,5 a2,2 0 0 1 2,-2 h2 v14 h-2 a2,2 0 0 1 -2,-2 z M19,5 a2,2 0 0 0 -2,-2 h-2 v14 h2 a2,2 0 0 0 2,-2 z
  </StreamGeometry>

  <!-- 反馈：对话气泡 + 感叹号（V2.9.4）。与「助手」的纯气泡刻意区分开：
       多一个感叹号，语义从「提问」变成「报告问题」。 -->
  <StreamGeometry x:Key="IconGeomFeedback" PresentationOptions:Freeze="True">
    M5,4 h14 a2,2 0 0 1 2,2 v9 a2,2 0 0 1 -2,2 h-8 l-4.5,3.5 v-3.5 h-1.5 a2,2 0 0 1 -2,-2 v-9 a2,2 0 0 1 2,-2 z M12,7.3 V12.6 M12,14.9 v0.2
  </StreamGeometry>

  <!-- 设置：滑杆 -->
  <StreamGeometry x:Key="IconGeomSettings" PresentationOptions:Freeze="True">
    M4,7 H20 M9,7 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M4,12 H20 M14,12 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M4,17 H20 M7,17 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0
  </StreamGeometry>

  <!-- ============================================================
    V3.5.0 图标补全（Tabler Icons，MIT；24×24，2px 描边，圆头圆角）。
    目的：一个入口只用一个语义图标，修掉「功能中心 = 模板」「工具箱 = 加号」
    这类图文不符的复用。几何路径按 Tabler 同名图标重绘，不引入字体或网络依赖。
    ============================================================ -->

  <!-- 功能中心 / 模块总览：四宫格 -->
  <StreamGeometry x:Key="IconGeomLayoutGrid" PresentationOptions:Freeze="True">
    M4,4 H10 V10 H4 Z M14,4 H20 V10 H14 Z M4,14 H10 V20 H4 Z M14,14 H20 V20 H14 Z
  </StreamGeometry>

  <!-- 手机联动：手机 -->
  <StreamGeometry x:Key="IconGeomDeviceMobile" PresentationOptions:Freeze="True">
    M6,5 a2,2 0 0 1 2,-2 h8 a2,2 0 0 1 2,2 v14 a2,2 0 0 1 -2,2 h-8 a2,2 0 0 1 -2,-2 z M11,18 h2
  </StreamGeometry>

  <!-- 工具箱：扳手 + 螺丝刀 -->
  <StreamGeometry x:Key="IconGeomTool" PresentationOptions:Freeze="True">
    M7,10 H10 V7 L6.5,3.5 A6,6 0 0 0 14.5,11.5 L20.5,17.5 A2.1,2.1 0 0 0 23.5,14.5 L17.5,8.5 A6,6 0 0 0 10,2 L13.5,5.5
  </StreamGeometry>

  <!-- 直播互动 / 推流：广播 -->
  <StreamGeometry x:Key="IconGeomBroadcast" PresentationOptions:Freeze="True">
    M12,12 m-2,0 a2,2 0 1 0 4,0 a2,2 0 1 0 -4,0 M7.5,7.5 a6.4,6.4 0 0 0 0,9 M16.5,7.5 a6.4,6.4 0 0 1 0,9 M5,5 a10,10 0 0 0 0,14 M19,5 a10,10 0 0 1 0,14
  </StreamGeometry>

  <!-- 录制 / 视频：摄像机 -->
  <StreamGeometry x:Key="IconGeomVideo" PresentationOptions:Freeze="True">
    M15,10 L19.6,7.7 A1,1 0 0 1 21,8.6 V15.4 A1,1 0 0 1 19.6,16.3 L15,14 M4,8 a2,2 0 0 1 2,-2 h7 a2,2 0 0 1 2,2 v8 a2,2 0 0 1 -2,2 h-7 a2,2 0 0 1 -2,-2 z
  </StreamGeometry>

  <!-- 插件 / 依赖：包裹 -->
  <StreamGeometry x:Key="IconGeomPackage" PresentationOptions:Freeze="True">
    M12,3 L20,7.5 V16.5 L12,21 L4,16.5 V7.5 Z M12,12 L20,7.5 M12,12 V21 M12,12 L4,7.5 M12,3 V12
  </StreamGeometry>

  <!-- 智能 / 复盘：星芒 -->
  <StreamGeometry x:Key="IconGeomSparkles" PresentationOptions:Freeze="True">
    M12,3 L13.9,8.1 L19,10 L13.9,11.9 L12,17 L10.1,11.9 L5,10 L10.1,8.1 Z M19,15 L19.9,17.1 L22,18 L19.9,18.9 L19,21 L18.1,18.9 L16,18 L18.1,17.1 Z
  </StreamGeometry>

  <!-- 自动化：机器人 -->
  <StreamGeometry x:Key="IconGeomRobot" PresentationOptions:Freeze="True">
    M6,7 H18 A2,2 0 0 1 20,9 V17 A2,2 0 0 1 18,19 H6 A2,2 0 0 1 4,17 V9 A2,2 0 0 1 6,7 Z M9,7 V4 M15,7 V4 M9,13 H9.01 M15,13 H15.01 M9,17 H15
  </StreamGeometry>

  <!-- 歌回 / 音乐 -->
  <StreamGeometry x:Key="IconGeomMusic" PresentationOptions:Freeze="True">
    M9,18 a3,3 0 1 0 3,-3 V6 L18,4 V7 L12,9
  </StreamGeometry>

  <!-- 学习 / 书本 -->
  <StreamGeometry x:Key="IconGeomBook" PresentationOptions:Freeze="True">
    M5,5 a2,2 0 0 1 2,-2 h3 V19 H7 a2,2 0 0 1 -2,-2 Z M19,5 a2,2 0 0 0 -2,-2 h-3 V19 h3 a2,2 0 0 0 2,-2 Z
  </StreamGeometry>

  <!-- 双人联动 -->
  <StreamGeometry x:Key="IconGeomUsers" PresentationOptions:Freeze="True">
    M9,7 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0 M3,21 v-2 a4,4 0 0 1 4,-4 h6 a4,4 0 0 1 4,4 v2 M16,3.1 a4,4 0 0 1 0,7.8 M21,21 v-2 a4,4 0 0 0 -3,-3.9
  </StreamGeometry>

  <!-- 摄像头 -->
  <StreamGeometry x:Key="IconGeomCamera" PresentationOptions:Freeze="True">
    M5,8 a2,2 0 0 1 2,-2 h1 L9,4 h6 l1,2 h1 a2,2 0 0 1 2,2 v9 a2,2 0 0 1 -2,2 h-12 a2,2 0 0 1 -2,-2 z M12,11 a3,3 0 1 0 0,6 a3,3 0 0 0 0,-6
  </StreamGeometry>

</ResourceDictionary>
