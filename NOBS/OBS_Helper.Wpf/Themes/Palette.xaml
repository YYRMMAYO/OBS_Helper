<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:PresentationOptions="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

  <!--
    浅色默认调色板。运行时 AppearanceService.Apply() 会用同名键覆盖 Application.Resources，
    直接写在 Application.Resources 顶层的条目优先级高于合并字典，因此换肤立即生效。
    色值与 Blazor 版 wwwroot/css/app.css 的 CSS 变量一一对应。

    【优化改动】MutedBrush 由 #6b6c80 加深为 #5c5d70：
    在浅灰底 Surface2(#f4f4fb) 上对比度由约 4.57:1 提升到约 5.7:1，
    明确满足 WCAG 2.1 正文文字 4.5:1 的要求（对应 P3「次要文字对比度」）。
    其余色值不变。深色模式由 AppearanceService 单独覆盖，不在此文件改。

    【v1.4.5 新增】OverlayBrush：BusyOverlay 全局加载遮罩底色（半透明黑），
    深浅色通用，中性色不随主题切换。
  -->

  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="BrandBrush" Color="#7b2ff7" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="BrandDarkBrush" Color="#5a1fc4" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="BrandSoftBrush" Color="#efe6ff" />
  <!-- 【UI 优化 v1.10】主按钮悬停 / 按下：用真实色阶代替透明度过场，悬停更明确、按下更沉 -->
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="BrandHoverBrush" Color="#6a1fd0" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="BrandPressedBrush" Color="#4d15ad" />

  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SurfaceBrush" Color="#ffffff" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="Surface2Brush" Color="#f4f4fb" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="Surface3Brush" Color="#ececf6" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="TextBrush" Color="#1c1d2b" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="MutedBrush" Color="#5c5d70" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="LineBrush" Color="#e6e6f0" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="OverlayBrush" Color="#80000000" />

  <!-- 【自定义背景 v1.10】内容区背景默认值（运行时由 AppearanceService 覆盖）：默认即 Surface2 -->
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="ContentBackgroundBrush" Color="#f4f4fb" />
  <!-- 图片层默认空值：未设置自定义图片时 Image.Source 解析为 null（与缺失键时 XAML 默认行为一致），
       同时让 check_resources.py 的全量资源体检能对上这个运行时注入键 -->
  <x:Null x:Key="ContentBackgroundImage" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="ContentBackgroundDim" Color="#00000000" />

  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="DangerBrush" Color="#c62828" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="DangerSoftBrush" Color="#fdeceb" />
  <!-- 【UI 优化 v1.10】危险按钮悬停 / 按下色阶 -->
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="DangerHoverBrush" Color="#ab2121" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="DangerPressedBrush" Color="#8f1a1a" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="WarnBrush" Color="#b54708" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="WarnSoftBrush" Color="#fef4e6" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="OkBrush" Color="#067647" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="OkSoftBrush" Color="#e7f6ee" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="InfoBrush" Color="#175cd3" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="InfoSoftBrush" Color="#e8f0fe" />

  <!--
    分类语义色（P2-1）：problems.json 的 category.semantic 键 → 这里的 Semantic{key}Brush。
    浅色值 = 原 problems.json 里的硬编码 hex，外观不变；深色模式由 AppearanceService 覆盖为柔和值。
  -->
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticRedBrush" Color="#e74c3c" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticOrangeBrush" Color="#e67e22" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticYellowBrush" Color="#f1c40f" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticPurpleBrush" Color="#9b59b6" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticBlueBrush" Color="#3498db" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticTealBrush" Color="#1abc9c" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticGreenBrush" Color="#16a085" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticAzureBrush" Color="#2980b9" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticVioletBrush" Color="#8e44ad" />
  <SolidColorBrush PresentationOptions:Freeze="True" x:Key="SemanticCrimsonBrush" Color="#c0392b" />

  <sys:Double x:Key="ShadowOpacity">0.10</sys:Double>

  <!-- 【UI 优化 v1.10】卡片投影：带偏移 + 柔和的真实阴影（craft-floor：深度必须有 offset + blur），
       浅色 0.10 / 深色 0.35，由 AppearanceService.Apply() 按主题覆盖为同名键。 -->
  <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="2" Direction="270"
                    Opacity="0.10" Color="#000000" />
  <DropShadowEffect x:Key="CardShadowStrong" BlurRadius="24" ShadowDepth="4" Direction="270"
                    Opacity="0.16" Color="#000000" />

  <CornerRadius x:Key="CornerRadiusLg">14</CornerRadius>
  <CornerRadius x:Key="CornerRadiusMd">10</CornerRadius>
  <CornerRadius x:Key="CornerRadiusSm">6</CornerRadius>

  <sys:Double x:Key="FontScaleFactor">1.0</sys:Double>
  <sys:Double x:Key="FontSizeXs">11</sys:Double>
  <sys:Double x:Key="FontSizeSm">12.5</sys:Double>
  <sys:Double x:Key="FontSizeBase">14</sys:Double>
  <sys:Double x:Key="FontSizeMd">15.5</sys:Double>
  <sys:Double x:Key="FontSizeLg">18</sys:Double>
  <sys:Double x:Key="FontSizeXl">22</sys:Double>
  <sys:Double x:Key="FontSizeH1">28</sys:Double>

  <Duration x:Key="MotionDuration">0:0:0.16</Duration>
  <sys:Boolean x:Key="ReduceMotion">False</sys:Boolean>

</ResourceDictionary>
