<Window x:Class="OBS_Helper.Wpf.Views.MiniControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.mini.title}"
        Width="392"
        SizeToContent="Height"
        MinHeight="180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        UseLayoutRounding="True"
        WindowStartupLocation="Manual"
        Closing="OnClosing"
        FontFamily="{DynamicResource AppFontFamily}">
  <Window.Resources>
    <!-- 小窗专用紧凑按钮：比 GhostButton 更小，适合窄面板 -->
    <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
      <Setter Property="MinWidth" Value="82" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="MiniPrimaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
      <Setter Property="MinWidth" Value="82" />
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder"
          CornerRadius="14"
          Background="{DynamicResource SurfaceBrush}"
          BorderBrush="{DynamicResource LineBrush}"
          BorderThickness="1"
          Padding="14,10"
          MouseLeftButtonDown="OnDrag">
    <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.42" Direction="270" />
    </Border.Effect>

    <StackPanel>
      <!-- 标题行：图标 + 标题 | 连接状态 | 关闭（隐藏） -->
      <Grid Margin="0,0,0,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Path Grid.Column="0" Data="{StaticResource IconGeomBroadcast}" Width="17" Height="17"
              Stretch="Uniform" Stroke="{DynamicResource BrandBrush}" StrokeThickness="1.8"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
              Margin="0,0,7,0" />
        <TextBlock Grid.Column="1" Text="{DynamicResource Loc.mini.title}" FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource TextBrush}"
                   FontSize="{DynamicResource FontSizeBase}" />
        <TextBlock x:Name="StatusText" Grid.Column="2" Text="{DynamicResource Loc.mini.statusDisconnected}"
                   VerticalAlignment="Center" Margin="0,0,10,0"
                   Style="{StaticResource CaptionText}" />
        <Button x:Name="CloseButton" Grid.Column="3" Content="✕"
                Style="{StaticResource MiniButton}"
                MinWidth="26" MinHeight="26" Margin="0"
                ToolTip="{DynamicResource Loc.mini.hideTip}"
                Click="OnCloseClick" />
      </Grid>

      <!-- 常用开关：录制 / 推流 / 虚拟摄像头 / 保存回放 -->
      <WrapPanel>
        <Button x:Name="RecordButton" Style="{StaticResource MiniPrimaryButton}" Click="OnRecordClick">
          <TextBlock x:Name="RecordButtonText" Text="{DynamicResource Loc.mini.startRecord}" VerticalAlignment="Center" />
        </Button>
        <Button x:Name="StreamButton" Style="{StaticResource MiniButton}" Click="OnStreamClick">
          <TextBlock x:Name="StreamButtonText" Text="{DynamicResource Loc.mini.startStream}" VerticalAlignment="Center" />
        </Button>
        <Button x:Name="VcamButton" Style="{StaticResource MiniButton}" Click="OnVcamClick">
          <TextBlock x:Name="VcamButtonText" Text="{DynamicResource Loc.mini.vcamOn}" VerticalAlignment="Center" />
        </Button>
        <Button x:Name="ReplayButton" Style="{StaticResource MiniButton}" Click="OnReplayClick"
                Content="{DynamicResource Loc.mini.replay}" />
      </WrapPanel>

      <Border Style="{StaticResource HLine}" Margin="0,2,0,7" />

      <!-- 场景切换：不离开当前窗口就能换场景 -->
      <Grid Margin="0,0,0,7">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="{DynamicResource Loc.mini.scene}" Style="{StaticResource CaptionText}"
                   VerticalAlignment="Center" Margin="0,0,8,0" />
        <Button x:Name="PrevSceneButton" Grid.Column="1" Style="{StaticResource MiniButton}"
                Content="‹" MinWidth="30" Width="30" Height="30" Margin="0,0,6,0"
                ToolTip="{DynamicResource Loc.mini.prevScene}" Click="OnPrevSceneClick" />
        <ComboBox x:Name="SceneCombo" Grid.Column="2" Style="{StaticResource AppComboBox}"
                  MinHeight="30" SelectionChanged="OnSceneChanged"
                  ToolTip="{DynamicResource Loc.mini.sceneTip}" />
        <Button x:Name="NextSceneButton" Grid.Column="3" Style="{StaticResource MiniButton}"
                Content="›" MinWidth="30" Width="30" Height="30" Margin="6,0,0,0"
                ToolTip="{DynamicResource Loc.mini.nextScene}" Click="OnNextSceneClick" />
      </Grid>

      <!-- 音频：麦克风 / 桌面音频静音 -->
      <StackPanel x:Name="AudioHost" Margin="0,0,0,2" />
      <TextBlock x:Name="AudioEmptyText" Text="{DynamicResource Loc.mini.noAudio}"
                 Style="{StaticResource CaptionText}" Margin="0,0,0,4" Visibility="Collapsed" />

      <!-- 实时指标行 -->
      <TextBlock x:Name="MetricsText" Style="{StaticResource CaptionText}" Margin="2,3,0,0"
                 TextWrapping="Wrap" Text="" />

      <Border Style="{StaticResource HLine}" Margin="0,7,0,7" />

      <!-- 扩展入口：提词器 / 工作室 / 主窗口 -->
      <WrapPanel>
        <Button x:Name="TeleprompterButton" Style="{StaticResource MiniButton}"
                Content="{DynamicResource Loc.mini.teleprompter}" Click="OnTeleprompterClick" />
        <Button x:Name="StudioButton" Style="{StaticResource MiniButton}"
                Content="{DynamicResource Loc.mini.studio}" Click="OnStudioClick" />
        <Button x:Name="MainWindowButton" Style="{StaticResource MiniButton}"
                Content="{DynamicResource Loc.mini.mainWindow}" Click="OnMainWindowClick" />
      </WrapPanel>

      <TextBlock Text="{DynamicResource Loc.mini.footer}"
                 Style="{StaticResource CaptionText}" Margin="2,1,0,0" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</Window>
