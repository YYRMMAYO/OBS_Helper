<UserControl x:Class="OBS_Helper.Wpf.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    首页 = 快捷入口 + 分类九宫格 + 我的收藏。
    页面大标题由 MainWindow 顶栏负责，这里不再重复，只保留原版 hero 里的两个入口按钮。
  -->
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <!-- 快捷入口：对应原版 hero 里的「搜索问题 / 问我一下」 -->
      <StackPanel Orientation="Horizontal">
        <Button Style="{StaticResource PrimaryButton}" Content="搜索问题"
                Margin="0,0,10,0" Click="OnSearchClick" />
        <Button Style="{StaticResource SecondaryButton}" Content="问我一下"
                Click="OnAssistantClick" />
      </StackPanel>

      <!-- 新手引导：未连 OBS 时显示，连接后由代码隐藏（P1） -->
      <Border x:Name="WelcomeCard" Style="{StaticResource Card}" Margin="0,14,0,0"
              Background="{DynamicResource BrandSoftBrush}"
              BorderBrush="{DynamicResource BrandBrush}" BorderThickness="1,1,1,1"
              Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="欢迎使用 OBS 排障助手" Style="{StaticResource H3Text}"
                       Foreground="{DynamicResource BrandBrush}" />
            <TextBlock Style="{StaticResource BodyText}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="连上本机 OBS 后，可解锁控制台远程控制、一键智能诊断与场景模板落地。现在先用知识库排查问题也同样顺畅。" />
          </StackPanel>
          <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                  VerticalAlignment="Center" Margin="12,0,0,0" Click="OnConnectGuideClick">
            <StackPanel Orientation="Horizontal">
              <Image Width="14" Height="14" Source="{StaticResource IconConnect}"
                     VerticalAlignment="Center" Margin="0,0,6,0" />
              <TextBlock Text="去连接 OBS" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Grid>
      </Border>

      <!-- 数据加载失败时的提示（带报错码，便于用户反馈） -->
      <Border x:Name="LoadErrorPanel" Style="{StaticResource SoftPanel}"
              Margin="0,14,0,0" Visibility="Collapsed">
        <TextBlock x:Name="LoadErrorText" Style="{StaticResource BodyText}"
                   Foreground="{DynamicResource DangerBrush}" />
      </Border>

      <TextBlock Text="问题分类" Style="{StaticResource SectionTitle}" Margin="0,20,0,10" />

      <!--
        分类卡用 ItemsControl + DataTemplate：卡片结构固定、只有数据不同，
        写模板比在 code-behind 里手搭控件树更清爽，也能让颜色继续走 DynamicResource。
      -->
      <ItemsControl x:Name="CategoryList">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Columns="3" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Style="{StaticResource CardButton}" Margin="0,0,12,12"
                    Tag="{Binding Id}" Click="OnCategoryClick"
                    ToolTip="{Binding Description}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--
                  分类图标芯片（P2-1 语义色）：去掉原 4px 彩色竖条（craft-floor 禁用卡片左侧彩色描边），
                  改为圆角色块 + 图标，语义色以「色块底 + 数量文字」双重编码，深浅主题均清晰。
                -->
                <Grid Grid.Column="0" Width="44" Height="44" Margin="0,0,12,0"
                      VerticalAlignment="Top">
                  <Border Background="{Binding Semantic, Converter={StaticResource SemanticBrush}}"
                          CornerRadius="12" Opacity="0.16" />
                  <TextBlock Text="{Binding Icon}" FontSize="20"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <StackPanel Grid.Column="1">
                  <TextBlock Text="{Binding Title}" Margin="0,1,0,0"
                             FontWeight="SemiBold"
                             FontSize="{DynamicResource FontSizeMd}"
                             Foreground="{DynamicResource TextBrush}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Description}" Margin="0,3,0,0"
                             Style="{StaticResource CaptionText}" />
                  <TextBlock Text="{Binding CountText}" Margin="0,6,0,0"
                             FontWeight="SemiBold"
                             FontSize="{DynamicResource FontSizeXs}"
                             Foreground="{Binding Semantic, Converter={StaticResource SemanticBrush}}" />
                </StackPanel>
              </Grid>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- 我的收藏：没有收藏时整块隐藏（与原版一致） -->
      <StackPanel x:Name="BookmarkSection" Visibility="Collapsed">
        <TextBlock Text="我的收藏" Style="{StaticResource SectionTitle}" Margin="0,14,0,10" />
        <StackPanel x:Name="BookmarkList" />
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
