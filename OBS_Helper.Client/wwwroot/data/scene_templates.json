            "settings": { "text": "本期话题：……", "font": { "face": "微软雅黑", "size": 48 }, "color": 4294967295 },
            "transform": { "posX": 960, "posY": 40, "boundsType": "OBS_BOUNDS_NONE", "alignment": 0 } },
          { "name": "我的麦克风", "inputKind": "wasapi_input_capture", "zOrder": 6, "enabled": true, "shared": true,
            "placeholder": { "kind": "device", "hint": "选择主播麦克风" } },
          { "name": "嘉宾麦克风", "inputKind": "wasapi_input_capture", "zOrder": 7, "enabled": true,
