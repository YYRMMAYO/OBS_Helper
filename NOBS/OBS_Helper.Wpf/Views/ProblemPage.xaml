<UserControl x:Class="OBS_Helper.Wpf.Views.ProblemPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    问题详情页。区块顺序与原版一致：徽章 / 症状 / 原因 / 分步方案 / 小贴士 / 参考链接 / 相关问题。
    问题标题写进顶栏，页内不再重复。各区块的列表项在 code-behind 里生成。
  -->
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <TextBlock x:Name="NotFoundText" Text="{DynamicResource Loc.problem.notFound}"
                 Style="{StaticResource MutedText}"
                 HorizontalAlignment="Center" Margin="0,40,0,0"
                 Visibility="Collapsed" />

      <StackPanel x:Name="ContentRoot" Visibility="Collapsed">

        <!-- 徽章 + 操作按钮 -->
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>

          <WrapPanel x:Name="BadgePanel" Grid.Column="0" VerticalAlignment="Center" />

          <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
            <Button x:Name="CopyButton" Style="{StaticResource SecondaryButton}"
                    Content="{DynamicResource Loc.problem.copyAll}" Margin="0,0,8,0"
                    ToolTip="{DynamicResource Loc.problem.copyAllTip}"
                    Click="OnCopyAll" />
            <Button x:Name="BookmarkButton" Style="{StaticResource SecondaryButton}"
                    Content="{DynamicResource Loc.problem.bookmark.off}" Click="OnToggleBookmark" />
          </StackPanel>
        </Grid>

        <TextBlock x:Name="HintText" Style="{StaticResource CaptionText}"
                   Margin="0,8,0,0" Visibility="Collapsed" />

        <!-- 症状表现 -->
        <Border Style="{StaticResource Card}" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Loc.problem.symptoms}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <StackPanel x:Name="SymptomList" />
          </StackPanel>
        </Border>

        <!-- 可能原因 -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Loc.problem.causes}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <StackPanel x:Name="CauseList" />
          </StackPanel>
        </Border>

        <!-- 分步解决方案：勾选状态写进本地存储，下次进来还在 -->
        <Border Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{DynamicResource Loc.problem.steps}"
                         Style="{StaticResource SectionTitle}" Margin="0" />
              <TextBlock x:Name="ProgressText" Grid.Column="1"
                         Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </Grid>
            <ProgressBar x:Name="StepProgress" Style="{StaticResource AppProgressBar}"
                         Minimum="0" Maximum="100" Margin="0,0,0,12" />
            <StackPanel x:Name="StepList" />
          </StackPanel>
        </Border>

        <!-- 小贴士：没有内容时整块隐藏 -->
        <Border x:Name="TipsBlock" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="{DynamicResource Loc.problem.tips}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <StackPanel x:Name="TipList" />
          </StackPanel>
        </Border>

        <!-- 官方文档 / 参考链接 -->
        <Border x:Name="LinksBlock" Style="{StaticResource Card}" Margin="0,12,0,0"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="{DynamicResource Loc.problem.links}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
            <StackPanel x:Name="LinkList" />
          </StackPanel>
        </Border>

        <!-- 相关问题 -->
        <StackPanel x:Name="RelatedBlock" Margin="0,12,0,0" Visibility="Collapsed">
          <TextBlock Text="{DynamicResource Loc.problem.related}" Style="{StaticResource SectionTitle}" Margin="0,4,0,8" />
          <StackPanel x:Name="RelatedList" />
        </StackPanel>

        <!--
          知识库回执（V3.0 / D8）：知识库此前只能被动接收热更新，用户端没有回写路径 ——
          「这条不解决问题」这个最有价值的信息根本传不回来。
          回执**不自动上传**：本地生成 Markdown，由用户自己贴到 Issue / 邮件。
        -->
        <Border x:Name="FeedbackBlock" Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Text="{DynamicResource Loc.kb.feedback.heading}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{DynamicResource Loc.kb.feedback.desc}" Style="{StaticResource MutedText}"
                       TextWrapping="Wrap" Margin="0,0,0,10" />

            <!--
              补充说明框（V3.0 第三轮验证修正）：原先误用了 AppCodeBox —— 那个样式是**只读**的
              （给日志/代码展示用），用户根本打不了字；而且占位文案被写进 Text，
              于是「没写任何东西」时回执里塞的是软件自己的占位句。
              正确做法：可编辑样式 + 占位符走 Tag（模板的 Placeholder 绑的就是 Tag，全仓约定）。
            -->
            <TextBox x:Name="FeedbackNoteBox" Style="{StaticResource AppTextArea}"
                     MinHeight="60" MaxHeight="140" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Tag="{DynamicResource Loc.kb.feedback.notePlaceholder}" />

            <WrapPanel Margin="0,10,0,0">
              <Button x:Name="SolvedButton" Content="{DynamicResource Loc.kb.feedback.solved}"
                      Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="OnSolvedClick" />
              <Button x:Name="UnsolvedButton" Content="{DynamicResource Loc.kb.feedback.unsolved}"
                      Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="OnUnsolvedClick" />
              <Button x:Name="MineFileButton" Content="{DynamicResource Loc.kb.mine.createFile}"
                      Style="{StaticResource GhostButton}" Margin="0,0,0,8"
                      ToolTip="{DynamicResource Loc.kb.mine.createFileTip}"
                      Click="OnCreateMineFileClick" />
            </WrapPanel>

            <TextBlock x:Name="FeedbackStatusText" Style="{StaticResource CaptionText}"
                       TextWrapping="Wrap" Visibility="Collapsed" />
          </StackPanel>
        </Border>

      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
