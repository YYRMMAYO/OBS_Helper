<UserControl x:Class="OBS_Helper.Wpf.Views.InsightsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">
      <ctl:SelfCheckCard x:Name="SelfCheck" RunRequested="OnSelfCheck" />

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8" Text="{DynamicResource Loc.insights.metrics}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.metrics.peak}" /><TextBox x:Name="PeakBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.metrics.chat}" /><TextBox x:Name="ChatBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.metrics.follows}" /><TextBox x:Name="FollowBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.metrics.gifts}" /><TextBox x:Name="GiftBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.metrics.bitrate}" /><TextBox x:Name="BitrateBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.metrics.dropped}" /><TextBox x:Name="DropBox" Width="90" Text="0" /></StackPanel>
            <StackPanel Margin="0,0,14,8"><TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.reportTitle}" /><TextBox x:Name="TitleBox" Width="220" Margin="0,4,0,0" Text="{DynamicResource Loc.insights.defaultTitle}" /></StackPanel>
          </WrapPanel>
          <WrapPanel>
            <Button Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc.insights.generate}" Click="OnGenerateReport" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.insights.autofill}" Click="OnAutoFill" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.insights.retentionButton}" Click="OnRetention" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.insights.export}" Click="OnExportStats" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.insights.copyReport}" Click="OnCopyReport" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.insights.openFolder}" Click="OnOpenReportFolder" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.insights.clear}" Click="OnClearStats" />
          </WrapPanel>
          <TextBlock Style="{StaticResource CaptionText}" Margin="0,8,0,0" TextWrapping="Wrap"
                     Text="{DynamicResource Loc.insights.metrics.hint}" />
          <TextBlock x:Name="ReportText" Style="{StaticResource MonoText}" Margin="0,10,0,0" TextWrapping="Wrap" />

          <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8" Text="{DynamicResource Loc.insights.dashboard}" />
          <TextBlock x:Name="DashboardText" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
          <ListBox x:Name="DashboardList" ctl:WheelForwarder.Enabled="True" Height="140" Margin="0,8,0,0" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.insights.cover}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.cover.game}" />
              <TextBox x:Name="GameBox" Width="160" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.cover.keyword}" />
              <TextBox x:Name="KeywordBox" Width="200" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.insights.cover.mood}" />
              <TextBox x:Name="MoodBox" Width="120" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.insights.suggest}" Click="OnSuggest" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.insights.cover.copy}" Click="OnCopyCover" />
          </WrapPanel>
          <ListBox x:Name="CoverList" ctl:WheelForwarder.Enabled="True" Height="120" Margin="0,10,0,0"
                   SelectionChanged="OnCoverSelected" />
          <TextBox x:Name="CoverEditBox" Margin="0,8,0,0" TextWrapping="Wrap" AcceptsReturn="True"
                   MinHeight="54" VerticalScrollBarVisibility="Auto" />
          <TextBlock x:Name="CoverStateText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
