<UserControl x:Class="OBS_Helper.Wpf.Views.AutomationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">
      <ctl:SelfCheckCard x:Name="SelfCheck" RunRequested="OnSelfCheck" />

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,16,0,8" Text="{DynamicResource Loc.automation.midi}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc.automation.loadDefaults}" Click="OnLoadDefaults" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.validate}" Click="OnValidateMidi" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.export}" Click="OnExportMidi" />
          </WrapPanel>
          <WrapPanel Margin="0,8,0,0">
            <Button x:Name="MidiStartButton" Style="{StaticResource PrimaryButton}" Content="{DynamicResource Loc.automation.midiStart}" Click="OnMidiStart" />
            <Button x:Name="MidiStopButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.midiStop}" Click="OnMidiStop" IsEnabled="False" />
            <TextBlock x:Name="MidiDeviceText" Style="{StaticResource CaptionText}" Margin="12,0,0,0" VerticalAlignment="Center" />
          </WrapPanel>
          <ListBox x:Name="MidiList" ctl:WheelForwarder.Enabled="True" Height="120" Margin="0,8,0,0" />
          <TextBlock x:Name="MidiText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.automation.wled}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.wledUrl}" />
              <TextBox x:Name="WledUrlBox" Width="260" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.wledPreset}" />
              <ComboBox x:Name="WledPresetCombo" Width="140" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.testLight}" Click="OnTestLight" />
            <CheckBox x:Name="LightEnableCheck" Content="{DynamicResource Loc.automation.lightEnable}" Margin="12,0,0,0" VerticalAlignment="Center" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.lightSave}" Click="OnLightSave" />
          </WrapPanel>
          <TextBlock x:Name="WledText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.automation.theme}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.themeManifest}" Margin="0,0,0,4" />
          <TextBox x:Name="ThemeBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap"
                   VerticalScrollBarVisibility="Auto" />
          <WrapPanel Margin="0,8,0,0">
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.themeSource}" />
              <TextBox x:Name="ThemeSourceBox" Width="280" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.validateTheme}" Click="OnValidateTheme" />
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.themeApply}" Click="OnThemeApply" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.themeRollback}" Click="OnThemeRollback" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.openThemeFolder}" Click="OnOpenThemeFolder" />
          </WrapPanel>
          <TextBlock x:Name="ThemeText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.automation.pluginTrust}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap" Text="{DynamicResource Loc.automation.pluginHint}" />
          <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.pluginManifest}" Margin="0,8,0,2" />
          <TextBox x:Name="PluginManifestBox" Height="70" AcceptsReturn="True" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.pluginPayload}" Margin="0,8,0,2" />
          <TextBox x:Name="PluginPayloadBox" Height="50" AcceptsReturn="True" TextWrapping="Wrap" />
          <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.pluginKey}" Margin="0,8,0,2" />
          <TextBox x:Name="PluginKeyBox" Height="50" AcceptsReturn="True" TextWrapping="Wrap" />
          <Button Style="{StaticResource SecondaryButton}" Margin="0,6,0,0" Content="{DynamicResource Loc.automation.pluginVerify}" Click="OnPluginVerify" />
          <TextBlock x:Name="PluginText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.automation.team}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <Button Style="{StaticResource SecondaryButton}" Content="{DynamicResource Loc.automation.invite}" Click="OnInvite" />
            <StackPanel Margin="8,0,0,0">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.memberName}" />
              <TextBox x:Name="MemberNameBox" Width="160" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.acceptInvite}" Click="OnAcceptInvite" />
            <Button Style="{StaticResource GhostButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.kick}" Click="OnKickLast" />
          </WrapPanel>
          <TextBox x:Name="InviteBox" Margin="0,8,0,0" IsReadOnly="True" />
          <ListBox x:Name="TeamList" ctl:WheelForwarder.Enabled="True" Height="100" Margin="0,8,0,0" />
          <TextBlock x:Name="TeamText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.automation.aihost}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <TextBlock x:Name="AiLabelText" Style="{StaticResource BodyText}" TextWrapping="Wrap" />
          <WrapPanel Margin="0,8,0,0">
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.aiText}" />
              <TextBox x:Name="AiTextBox" Width="300" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.aiSpeak}" Click="OnAiSpeak" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.vtsConnect}" Click="OnVtsConnect" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.lipsync}" Click="OnLipsync" />
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.interrupt}" Click="OnInterrupt" />
          </WrapPanel>
          <TextBlock x:Name="AiText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <TextBlock Style="{StaticResource SectionTitle}" Margin="0,18,0,8" Text="{DynamicResource Loc.automation.director}" />
      <Border Style="{StaticResource Card}" Padding="14">
        <StackPanel>
          <WrapPanel>
            <StackPanel Margin="0,0,10,8">
              <TextBlock Style="{StaticResource CaptionText}" Text="{DynamicResource Loc.automation.directorContext}" />
              <TextBox x:Name="DirectorBox" Width="240" Margin="0,4,0,0" />
            </StackPanel>
            <Button Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Content="{DynamicResource Loc.automation.suggest}" Click="OnDirector" />
            <Button x:Name="DirectorApplyButton" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                    Content="{DynamicResource Loc.automation.director.apply}" Click="OnDirectorApply" IsEnabled="False" />
          </WrapPanel>
          <TextBlock x:Name="DirectorText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
