<Window x:Class="OBS_Helper.Wpf.Views.TeleprompterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.teleprompter.title}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="CanResizeWithGrip"
        Width="900" Height="320"
        MinWidth="360" MinHeight="180"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

  <Grid x:Name="RootGrid" Background="Transparent">
    <!-- 背景层：颜色 / 不透明度可调，保证录制画面里不会出现一块突兀的白底 -->
    <Border x:Name="Backdrop" CornerRadius="10" BorderThickness="1"
            BorderBrush="#33ffffff" Background="#000000" Opacity="0.72" />

    <!-- 正文层：镜像变换作用在这里（工具栏不镜像） -->
    <Grid x:Name="ContentRoot" ClipToBounds="True">
      <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Hidden"
                    HorizontalScrollBarVisibility="Disabled"
                    Focusable="True" PanningMode="VerticalOnly"
                    Cursor="SizeNS"
                    PreviewMouseWheel="OnContentWheel"
                    PreviewMouseLeftButtonDown="OnContentMouseLeftButtonDown"
                    PreviewMouseMove="OnContentMouseMove"
                    PreviewMouseLeftButtonUp="OnContentMouseLeftButtonUp">
        <TextBlock x:Name="ScriptText" TextWrapping="Wrap" Foreground="#ffffff"
                   FontSize="42" LineHeight="61" Margin="80,40,80,220" />
      </ScrollViewer>

      <!-- 阅读参考线：默认在窗口 40% 高度处，提示「念到这里」 -->
      <Border x:Name="GuideLine" Height="2" Background="#ff5a5a" Opacity="0.65"
              VerticalAlignment="Top" IsHitTestVisible="False" />
    </Grid>

    <!-- 顶部工具条：拖动区域 + 播放 / 速度 / 字号 / 镜像 / 穿透 / 倒计时 / 编辑 / 关闭 -->
    <Border x:Name="TopBar" VerticalAlignment="Top" Background="#66000000"
            CornerRadius="10,10,0,0" Padding="8,6"
            MouseLeftButtonDown="OnDragAreaMouseDown">
      <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="Left" x:Name="DragArea" Background="Transparent"
                Padding="4,2,14,2" Cursor="SizeAll">
          <TextBlock Text="{DynamicResource Loc.teleprompter.title}" Foreground="#ffffff"
                     FontSize="12" VerticalAlignment="Center" />
        </Border>

        <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnCloseClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.close}"
                ToolTip="{DynamicResource Loc.teleprompter.close}" Content="✕" Foreground="#ffffff" />

        <Button x:Name="EditButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnEditClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.script}"
                ToolTip="{DynamicResource Loc.teleprompter.script}" Content="✎" Foreground="#ffffff" />

        <Button x:Name="SettingsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnEditClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.settings}"
                ToolTip="{DynamicResource Loc.teleprompter.settings}" Content="⚙" Foreground="#ffffff" />

        <Button x:Name="CountdownButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="34" Height="26" Margin="4,0,0,0" Click="OnCountdownClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.countdown}"
                ToolTip="{DynamicResource Loc.teleprompter.countdown}" Content="3" Foreground="#ffffff" />

        <Button x:Name="MonitorButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnMonitorClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.monitor}"
                ToolTip="{DynamicResource Loc.teleprompter.monitor}" Content="▣" Foreground="#ffffff" />

        <Button x:Name="ClickThroughButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnClickThroughClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.clickThrough}"
                ToolTip="{DynamicResource Loc.teleprompter.clickThrough}" Content="◌" Foreground="#ffffff" />

        <Button x:Name="MirrorVButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnMirrorVerticalClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.mirrorV}"
                ToolTip="{DynamicResource Loc.teleprompter.mirrorV}" Content="↕" Foreground="#ffffff" />

        <Button x:Name="MirrorHButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnMirrorHorizontalClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.mirrorH}"
                ToolTip="{DynamicResource Loc.teleprompter.mirrorH}" Content="↔" Foreground="#ffffff" />

        <Button x:Name="FontUpButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnFontUpClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.fontSize}"
                ToolTip="{DynamicResource Loc.teleprompter.fontSize}" Content="A+" Foreground="#ffffff" />

        <Button x:Name="FontDownButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnFontDownClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.fontSize}"
                ToolTip="{DynamicResource Loc.teleprompter.fontSize}" Content="A-" Foreground="#ffffff" />

        <Button x:Name="SpeedUpButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnSpeedUpClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.speed}"
                ToolTip="{DynamicResource Loc.teleprompter.speed}" Content="＋" Foreground="#ffffff" />

        <TextBlock x:Name="SpeedText" DockPanel.Dock="Right" Foreground="#ffffff" FontSize="12"
                   VerticalAlignment="Center" Margin="4,0,0,0" MinWidth="52" TextAlignment="Center" />

        <Button x:Name="SpeedDownButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnSpeedDownClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.speed}"
                ToolTip="{DynamicResource Loc.teleprompter.speed}" Content="－" Foreground="#ffffff" />

        <Button x:Name="PlayPauseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="34" Height="26" Click="OnPlayPauseClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.play}"
                ToolTip="{DynamicResource Loc.teleprompter.play}" Content="▶" Foreground="#ffffff" />

        <!-- V3.1.1：手动上下移动（不依赖键盘焦点） -->
        <Button x:Name="ScrollDownButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnScrollDownClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.scrollDown}"
                ToolTip="{DynamicResource Loc.teleprompter.scrollDown}" Content="▼" Foreground="#ffffff" />

        <Button x:Name="ScrollUpButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnScrollUpClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.scrollUp}"
                ToolTip="{DynamicResource Loc.teleprompter.scrollUp}" Content="▲" Foreground="#ffffff" />

        <Button x:Name="ScrollTopButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                Width="30" Height="26" Margin="4,0,0,0" Click="OnScrollTopClick"
                AutomationProperties.Name="{DynamicResource Loc.teleprompter.scrollTop}"
                ToolTip="{DynamicResource Loc.teleprompter.scrollTop}" Content="⤒" Foreground="#ffffff" />

        <TextBlock x:Name="HintText" Foreground="#cccccc" FontSize="11" VerticalAlignment="Center"
                   Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- 编辑 / 设置面板 -->
    <Grid x:Name="EditorPanel" Visibility="Collapsed" Background="#ee111111" Margin="0,44,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <TextBox x:Name="EditorBox" Grid.Row="0" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
               FontSize="15" Padding="10" Background="#22111111" Foreground="#ffffff"
               BorderBrush="#44ffffff" BorderThickness="1" Margin="10,10,10,0"
               TextChanged="OnEditorTextChanged" />

      <StackPanel Grid.Row="1" Margin="10,8,10,10">
        <WrapPanel>
          <Button x:Name="ImportButton" Content="{DynamicResource Loc.teleprompter.import}"
                  Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OnImportClick" />
          <Button x:Name="ClearButton" Content="{DynamicResource Loc.teleprompter.clear}"
                  Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnClearClick" />
          <Button x:Name="ReloadButton" Content="{DynamicResource Loc.teleprompter.reload}"
                  Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="OnReloadClick" />
          <Button x:Name="DoneButton" Content="{DynamicResource Loc.teleprompter.done}"
                  Style="{StaticResource PrimaryButton}" Click="OnDoneEditingClick" />
        </WrapPanel>

        <WrapPanel Margin="0,10,0,0">
          <TextBlock Text="{DynamicResource Loc.teleprompter.opacity}" Foreground="#dddddd"
                     VerticalAlignment="Center" FontSize="12" Margin="0,0,8,0" />
          <Slider x:Name="OpacitySlider" Width="150" Minimum="0" Maximum="100"
                  IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"
                  ValueChanged="OnOpacityChanged" />

          <TextBlock Text="{DynamicResource Loc.teleprompter.lineHeight}" Foreground="#dddddd"
                     VerticalAlignment="Center" FontSize="12" Margin="18,0,8,0" />
          <Slider x:Name="LineHeightSlider" Width="110" Minimum="100" Maximum="250"
                  IsSnapToTickEnabled="True" TickFrequency="5" VerticalAlignment="Center"
                  ValueChanged="OnLineHeightChanged" />

          <TextBlock Text="{DynamicResource Loc.teleprompter.margin}" Foreground="#dddddd"
                     VerticalAlignment="Center" FontSize="12" Margin="18,0,8,0" />
          <Slider x:Name="MarginSlider" Width="110" Minimum="0" Maximum="300"
                  IsSnapToTickEnabled="True" TickFrequency="10" VerticalAlignment="Center"
                  ValueChanged="OnMarginChanged" />
        </WrapPanel>

        <TextBlock x:Name="CaptureHintText" Foreground="#aaaaaa" FontSize="11"
                   TextWrapping="Wrap" Margin="0,8,0,0" />
      </StackPanel>
    </Grid>

    <!-- 3-2-1 倒计时 -->
    <TextBlock x:Name="CountdownText" Text="3" FontSize="150" FontWeight="Bold"
               Foreground="#ffffff" HorizontalAlignment="Center" VerticalAlignment="Center"
               Visibility="Collapsed" IsHitTestVisible="False" />

    <!-- 轻提示（穿透提示、场景联动找不到等） -->
    <Border x:Name="ToastBorder" VerticalAlignment="Bottom" HorizontalAlignment="Center"
            Background="#cc111111" BorderBrush="#44ffffff" BorderThickness="1"
            CornerRadius="6" Padding="10,6" Margin="10" Visibility="Collapsed"
            IsHitTestVisible="False">
      <TextBlock x:Name="ToastText" Foreground="#ffffff" FontSize="12" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
