<UserControl x:Class="OBS_Helper.Wpf.Views.CategoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    分类页：列出某个分类下的全部问题。
    分类名与描述写进顶栏（SetHeader），页内只保留分类色条 + 数量，避免和顶栏重复。
  -->
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <Border x:Name="HeaderPanel" Style="{StaticResource SoftPanel}" Visibility="Collapsed">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <!-- 分类色条，对应原版 .cat-header 的 border-left -->
          <Border x:Name="AccentBar" Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,12,0" />

          <StackPanel Grid.Column="1">
            <TextBlock x:Name="DescriptionText" Style="{StaticResource BodyText}" />
            <TextBlock x:Name="CountText" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <StackPanel x:Name="ProblemList" Margin="0,14,0,0" />

      <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}"
                 HorizontalAlignment="Center" Margin="0,40,0,0"
                 Visibility="Collapsed" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
