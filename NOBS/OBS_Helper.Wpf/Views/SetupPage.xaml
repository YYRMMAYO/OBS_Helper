<UserControl x:Class="OBS_Helper.Wpf.Views.SetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer Style="{StaticResource PageScroll}">
    <StackPanel Margin="22,18,22,26">

      <!-- 页面大标题在 MainWindow 顶栏，这里只保留原版的引导文案 -->
      <TextBlock Style="{StaticResource MutedText}"
                 Text="按阶段一步步搭建，选择平台可直达对应接入指南。" />

      <TextBlock Style="{StaticResource SectionTitle}" Text="搭建流程" Margin="0,18,0,10" />
      <StackPanel x:Name="FlowPanel" />

      <TextBlock Style="{StaticResource SectionTitle}" Text="选择平台 / 场景" Margin="0,18,0,10" />
      <WrapPanel x:Name="PlatformPanel" />

      <StackPanel x:Name="ProblemPanel" Margin="0,10,0,0" />

      <TextBlock x:Name="EmptyText" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                 Text="该平台暂无专门指南，可参考上方「搭建流程」通用步骤。"
                 Visibility="Collapsed" />

      <Border Style="{StaticResource SoftPanel}" Margin="0,16,0,0">
        <TextBlock Style="{StaticResource MutedText}"
                   Text="需要同时多平台开播？查看「多平台同时推流」与「竖屏 9:16 直播」。" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
