<UserControl x:Class="OBS_Helper.Wpf.Views.GuidePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:OBS_Helper.Wpf.Controls">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <ScrollViewer Grid.Column="0" Style="{StaticResource PageScroll}">
      <StackPanel Margin="22,18,22,26">

        <TextBlock x:Name="LoadingText" Style="{StaticResource MutedText}"
                   Text="正在加载指引…" Margin="2,6,0,0" />

        <!-- 内置资源读不出来时的兜底：给出报错码之外的自助提示 -->
        <Border x:Name="ErrorPanel" Style="{StaticResource Card}"
                Background="{DynamicResource DangerSoftBrush}"
                BorderBrush="{DynamicResource DangerBrush}"
                Visibility="Collapsed">
          <StackPanel>
            <TextBlock Text="⚠️ 无法加载排障指引"
                       FontSize="{DynamicResource FontSizeMd}" FontWeight="SemiBold"
                       Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
            <TextBlock x:Name="ErrorText" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,5,0,0"
                       Text="请确认应用已完整安装；若重装后仍然失败，可改用「智能诊断」或「问我一下」。" />
          </StackPanel>
        </Border>

        <Border x:Name="ContentCard" Style="{StaticResource Card}" Visibility="Collapsed" Padding="22,18,22,20">
          <ctl:MarkdownView x:Name="Markdown" />
        </Border>

      </StackPanel>
    </ScrollViewer>

    <!-- 侧边目录：桌面窗口够宽，长文里固定一列目录比反复滚动找章节高效 -->
    <Border x:Name="TocPanel" Grid.Column="1" Style="{StaticResource CardTight}"
            Width="212" Margin="0,18,22,26" VerticalAlignment="Top" MaxHeight="560"
            Visibility="Collapsed">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="本页目录"
                   Style="{StaticResource CaptionText}" Margin="2,0,0,9" />
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="TocList" />
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
