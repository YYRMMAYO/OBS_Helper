<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OBS_Helper</AssemblyName>
    <RootNamespace>OBS_Helper.Win</RootNamespace>
    <AssemblyTitle>OBS 排障助手</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Copyright>Copyright (c) 2026 OBS Helper</Copyright>
    <Authors>OBS Helper</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/YYRMMAYO/OBS_Helper</RepositoryUrl>
    <PackageProjectUrl>https://github.com/YYRMMAYO/OBS_Helper</PackageProjectUrl>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- 站点内容以松散文件形式随包发布，运行时从程序目录读取 -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- 自包含发布，目标机无需安装 .NET -->
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- 将已构建好的 Blazor 静态站点（clientdist）随包发布到输出目录的 wwwroot 下 -->
    <Content Include="clientdist\**\*">
      <TargetPath>wwwroot\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
  </ItemGroup>

</Project>
